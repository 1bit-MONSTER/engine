# /etc/init.d/zz-onboard-ports - the appliance's two inbound ports, opened after Puppy's firewall.
#
# Measured in a booted image: `iptables -S` shows `-P INPUT DROP` with `tcp_inbound` RETURNing to that
# policy, so every new inbound TCP connection from outside is dropped. lemond binds 0.0.0.0:13305 and the
# guest reaches it at its own address (and lemond itself answers 200), while the same request from another
# machine got nothing at all - and after inserting these two rules by hand the outside request was answered
# (401 without the key, which is lemond saying it is there). U3 is "the web app reachable on the LAN", so
# this is the difference between an appliance and a machine that only talks to itself.
#
# The name is the mechanism: rc.services runs /etc/init.d/* in name order, `rc.firewall` sorts under "r",
# and a numeric or earlier name would be overwritten by it. "zz-" is after every script woof-CE ships
# (the last is `z-disable-spurious-gpe`), and -C makes a re-run a no-op.
open_port() {
    iptables -C INPUT -p tcp --dport "$1" -j ACCEPT 2> /dev/null && return 0
    iptables -I INPUT 1 -p tcp --dport "$1" -j ACCEPT 2> /dev/null && return 0
    echo "zz-onboard-ports: could not open tcp/$1" >&2
    return 1
}
open_port 13305   # Lemonade (U3)
open_port 22      # ssh, the owner's key (U7)

# And the other half of reachability, measured the same way: Puppy ships /etc/hosts.deny = "ALL: ALL" with
# /etc/hosts.allow = "ALL: LOCAL", and LOCAL means this machine, so a client on the LAN is refused by
# tcpwrappers before ssh's key exchange even starts - ssh says `kex_exchange_identification: Connection
# closed by remote host` while sshd is listening on 0.0.0.0:22 and the port rule above is in place.
# The RFC1918 ranges are added, not the world: sshd still wants the owner's key, and Lemonade wants its API key
# only when one was turned on (cycle 20: blank is the shipped mode, so the LAN reaches Lemonade without one).
if [ -f /etc/hosts.allow ] && ! grep -q '1bit-lan' /etc/hosts.allow 2> /dev/null; then
    printf 'ALL: LOCAL, 10.0.0.0/255.0.0.0, 172.16.0.0/255.240.0.0, 192.168.0.0/255.255.0.0  # 1bit-lan\n' \
        >> /etc/hosts.allow
fi
grep -q '1bit-lan' /etc/hosts.allow 2> /dev/null && \
    echo "zz-onboard-ports: the LAN is allowed through tcpwrappers (hosts.allow)" || \
    echo "zz-onboard-ports: could not add the LAN to /etc/hosts.allow" >&2
echo "zz-onboard-ports: $(iptables -S INPUT 2> /dev/null | grep -c 'dport') inbound port rule(s) live"
