#
# /etc/1bit/libhsa.env - what HRX needs on the 8060S's GPU, measured on this box (engine#715).
#
# Read by /etc/init.d/10lemonade (v2's lemonade unit took the same file as its EnvironmentFile, so an image
# built for v2 stays valid) and by /etc/profile.d/90onboard-limits.
#
# The board reports XNACK enabled: NO and Coherent Host Access: FALSE. Without the no-SVM trio HRX
# page-faults on its first graph replay: 58 fault lines and an HTTP 500 in under 10 ms. None of these three
# is a preference, and ONEBIT_HRX_LIBHSA is the release-gated runtime (not the distro ROCm one, which is on
# the box only because XRT pulls it in) - build.sh installs it there when it is given LIBHSA=<file>.
HSA_USE_SVM=0
HSA_USERPTR_FOR_PAGED_MEM=0
HRX_ALLOW_NO_SVM=1
ONEBIT_HRX_LIBHSA=/opt/1bit/libhsa/libhsa-runtime64.so.1
