# Removing the package takes the console line with it (a box without OpenWebUI must not say anything
# about it) and leaves /data/openwebui alone: the owner's chats and users are not the package's.
set -e
case "${1:-}" in
    remove|purge)
        rm -f /etc/systemd/system/multi-user.target.wants/1bit-openwebui.service \
              /etc/systemd/system/timers.target.wants/1bit-openwebui-console.timer \
              /etc/issue.d/50-1bit-openwebui.issue
        if command -v deb-systemd-helper >/dev/null 2>&1; then
            deb-systemd-helper disable 1bit-openwebui.service 1bit-openwebui-console.timer >/dev/null 2>&1 || true
            [ "${1:-}" = purge ] &&
                deb-systemd-helper purge 1bit-openwebui.service 1bit-openwebui-console.timer >/dev/null 2>&1 || true
        fi
        if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        ;;
esac
# the generated key/session file is configuration, not data: only a purge removes it, and the operator's
# own override file with it (a remove keeps openwebui.conf, so a reinstall is the same image)
if [ "${1:-}" = purge ]; then rm -f /etc/1bit/openwebui.env /etc/1bit/openwebui.conf; fi
exit 0
