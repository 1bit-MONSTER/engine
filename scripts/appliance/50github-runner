# github-runner: the self-hosted runner strixhalo-bench for 1bit-MONSTER/engine (account bcloud), started at boot.
# This image has no systemd, so the runner cannot be a service; it starts detached as bcloud.
# 2026-11-28 (found by cl-220 after the 7.4-rc4 reboot): started from init, sudo kept the boot environment's HOME=/,
# so every job failed in "Prepare the appliance runner" (mkdir: Permission denied; gh: open /.config/gh/config.yml).
# HOME is now set to the account's home; the rest of the environment is unchanged.
# The already-running check is by ACCOUNT: "Runner.Listener" alone also matched the strixhalo-pr-agent runner
# (52github-runner-pr-agent, user ghrunner), and with that one up first this runner never started. Not by path: after a
# runner self-update the listener may run as ./bin/Runner.Listener (review cl-flm, #3609), and the pr-agent one could
# too, so only the user tells them apart.
# And by process NAME (pgrep -x, /proc/<pid>/comm), not the command line: on this box every lane's ssh commands run as
# bcloud, and `pgrep -f` matched any shell whose argv merely mentions Runner.Listener (review cl-flm, #3612).
D=${GITHUB_RUNNER_DIR:-/home/bcloud/actions-runner}
case "${1:-start}" in
  start)
    if ! pgrep -u bcloud -x Runner.Listener > /dev/null 2>&1; then   # the process NAME (comm): a shell whose argv mentions it is not a listener
      sudo -H -u bcloud env HOME=/home/bcloud bash -c "cd $D && setsid nohup ./run.sh > runner.log 2>&1 < /dev/null &" 2> /dev/null
    fi
    ;;
esac
exit 0
