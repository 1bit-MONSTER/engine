#
# 1bit-pin-holdings.service — do the model files on this box match models/pins.json? (docs/model-pins.md)
#
# One-shot. Exit 1 (a box copy or a re-host is not the pinned file) marks the unit failed, which is the
# alert; the report is ~/.1bit/logs/pin-holdings-latest.md either way. Hashes are cached by
# path/size/mtime/inode, so a day where nothing changed reads no model file.
#
#     install -m644 scripts/1bit-pin-holdings.{service,timer} ~/.config/systemd/user/
#     systemctl --user daemon-reload
#     systemctl --user enable --now 1bit-pin-holdings.timer
#
# %h/1bit-MONSTER must match your checkout (repo root), as in 1bit-census-watch.service.

[Unit]
Description=1bit pin holdings: the box's model files match their pins

[Service]
Type=oneshot
WorkingDirectory=%h/1bit-MONSTER
Nice=19
IOSchedulingClass=idle
ExecStartPre=/usr/bin/mkdir -p %h/.1bit/logs
ExecStart=/usr/bin/python3 -I %h/1bit-MONSTER/tools/pin_holdings.py --out %h/.1bit/logs/pin-holdings-latest.md
StandardOutput=journal
StandardError=journal
