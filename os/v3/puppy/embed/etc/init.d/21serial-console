# /etc/init.d/21serial-console - a root shell on the serial port, only when the boot line asks for it.
#
# The appliance is headless, and the console Puppy leaves you with is tty1: the transcript of a boot goes
# out on ttyS0, but nothing reads it there, so a machine in a rack with no monitor is unadministrable and
# an automated VM run cannot type into it. Measured in QEMU: an ISO built from this recipe boots to the
# quicksetup dialog on tty1 and every byte of the transcript arrives on ttyS0.
#
# It is opt-in because a root shell needs no password: append 1bit.serial=1 to the kernel command line
# (GRUB edit, or the QEMU -append). Without it this script does nothing.
grep -q '1bit.serial=1' /proc/cmdline 2>/dev/null || exit 0
setsid sh -c 'exec /bin/sh -l < /dev/ttyS0 > /dev/ttyS0 2>&1' &
# said on ttyS0 directly: rc.services' stdout at this point is not necessarily the console
echo "21serial-console: root shell on ttyS0 (1bit.serial=1 on the command line)" > /dev/ttyS0
