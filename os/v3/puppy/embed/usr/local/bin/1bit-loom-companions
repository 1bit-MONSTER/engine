"""1bit-loom-companions [--status | --once | --watch SECONDS] [<payload cards dir> [<HF_HOME>]]

A Loom card can read weights from more than one Hugging Face repository: its lock names each one as an origin, the
`checkpoint` the model Lemonade pulls (the GGUF) and COMPANIONS beside it - the native Inkling card reads its layers
20-23 MXFP8 experts from 1bit-MONSTER/Inkling-2-Mini-MXFP8-experts (origin `mxfp8`, 4.2 GB). Lemonade's catalogue pull
fetches only the checkpoint's repository, and without a companion the card fails at load (Inkling has no fallback arm).
1bit-loom-cards already links `parameter/<file>` to <HF_HOME>/hub/models--<org>--<repo>/snapshots/<rev>/<file> for every
origin; this puts the companion files there:
  * only for a card whose CHECKPOINT repository is already in the cache - a box that never pulled the model never
    downloads its companions;
  * at the revision the card's lock pins, from https://huggingface.co/<repo>/resolve/<rev>/<file> (anonymous: the
    companions we ship are public), resumable (<file>.part), and renamed into place only when its size and sha256 are
    the lock's - a server can delay a companion, never substitute one;
  * one fetch at a time (a lock file), with the free space for the file plus 2 GiB checked first.
--status   one line per companion (present / missing / not needed yet), exit 1 when a needed one is missing
--once     fetch what is needed now, then exit (the release check runs this after its pull)
--watch N  look every N seconds (10lemonade starts it in the background: a pull from Lemonade's page is completed
           within one interval)
"""
import fcntl
import hashlib
import json
import os
import shutil
import sys
import time
import urllib.request

PROG = "1bit-loom-companions"
HF_BASE = os.environ.get("ONEBIT_LOOM_HF_BASE", "https://huggingface.co")   # the test's own server; the sha256 decides
MARGIN = 2 << 30
# modes are explicit and private (CodeQL py/overly-permissive-file): the only reader is root (loom-serve, a child of the
# root lemond), so a companion is 0600, a directory this makes 0700, the lock 0600 - nothing for group or others
FILE_MODE, DIR_MODE, LOCK_MODE = 0o600, 0o700, 0o600


def say(msg):
    print("%s: %s" % (PROG, msg), flush=True)


def companions(cards_dir):
    """[(card, key, repo, rev, name, size, sha256, checkpoint repo)] from each payload card's model.json.lock"""
    out = []
    for card in sorted(os.listdir(cards_dir)) if os.path.isdir(cards_dir) else []:
        p = os.path.join(cards_dir, card, "model.json.lock")
        try:
            lock = json.load(open(p))
        except (OSError, ValueError):
            continue
        origins = {}
        for k, v in (lock.get("origins") or {}).items():
            req = v.get("requested") or {}
            if req.get("kind") == "hf":
                origins[k] = (req.get("repository"), (v.get("resolved") or {}).get("revision") or req.get("revision"))
        ck = (origins.get("checkpoint") or (None, None))[0]
        for f in lock.get("files") or []:
            o = f.get("origin") if isinstance(f, dict) else None
            if not isinstance(o, str) or not o.startswith("@"):
                continue
            key, _, name = o[1:].partition("/")
            if key == "checkpoint" or key not in origins or not name or "/" in name or name.startswith("."):
                continue
            repo, rev = origins[key]
            # the lock is downloaded content and this runs as root: a plain org/name and a plain revision only, as
            # 1bit-loom-cards insists for the link it makes (anything else is skipped, never followed)
            if not (isinstance(repo, str) and isinstance(rev, str) and repo.count("/") == 1 and ".." not in repo
                    and not repo.startswith("/") and "/" not in rev and rev not in (".", "..")):
                continue
            if isinstance(f.get("size"), int) and isinstance(f.get("sha256"), str) and len(f["sha256"]) == 64:
                out.append((card, key, repo, rev, name, f["size"], f["sha256"].lower(), ck))
    return out


def repo_dir(hf, repo):
    return os.path.join(hf, "hub", "models--" + repo.replace("/", "--"))


def needed(hf, c):
    """the card's checkpoint has been pulled (its repository is in the cache)"""
    return bool(c[7]) and os.path.isdir(os.path.join(repo_dir(hf, c[7]), "snapshots"))


def target(hf, c):
    return os.path.join(repo_dir(hf, c[2]), "snapshots", c[3], c[4])


def present(hf, c):
    t = target(hf, c)
    return os.path.isfile(t) and os.path.getsize(t) == c[5]


def sha256_of(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def fetch(hf, c):
    t = target(hf, c)
    os.makedirs(os.path.dirname(t), mode=DIR_MODE, exist_ok=True)
    part = t + ".part"
    have = os.path.getsize(part) if os.path.exists(part) else 0
    if have > c[5]:
        os.unlink(part)
        have = 0
    free = shutil.disk_usage(os.path.dirname(t)).free
    if free < c[5] - have + MARGIN:
        say("%s: %s needs %d MiB, %d MiB free on %s - not fetched" % (c[0], c[4], (c[5] - have + MARGIN) >> 20, free >> 20, hf))
        return False
    url = "%s/%s/resolve/%s/%s" % (HF_BASE, c[2], c[3], c[4])
    say("%s: fetching %s from %s@%.8s (%d MiB%s)" % (c[0], c[4], c[2], c[3], c[5] >> 20, ", resuming at %d MiB" % (have >> 20) if have else ""))
    req = urllib.request.Request(url, headers={"User-Agent": "1bit-os", **({"Range": "bytes=%d-" % have} if have else {})})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            flags = os.O_WRONLY | os.O_CREAT | (os.O_APPEND if have and r.status == 206 else os.O_TRUNC)
            with os.fdopen(os.open(part, flags, FILE_MODE & 0o600), "ab" if flags & os.O_APPEND else "wb") as out:
                while True:
                    b = r.read(1 << 20)
                    if not b:
                        break
                    out.write(b)
    except OSError as e:
        say("%s: %s: the download stopped (%s); the next run resumes it" % (c[0], c[4], e))
        return False
    size = os.path.getsize(part)
    if size != c[5] or sha256_of(part) != c[6]:
        os.unlink(part)
        say("%s: %s: REFUSED, %d B / sha256 not the card lock's (%d B, %.16s...): removed" % (c[0], c[4], size, c[5], c[6]))
        return False
    os.chmod(part, FILE_MODE)
    os.rename(part, t)
    say("%s: %s in place (sha256 %.16s..., the card lock's)" % (c[0], c[4], c[6]))
    return True


def run_once(cards, hf):
    with os.fdopen(os.open(os.path.join(hf, ".1bit-loom-companions.lock"), os.O_WRONLY | os.O_CREAT, LOCK_MODE), "w") as lk:
        try:
            fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return True                                   # another run is fetching
        ok = True
        for c in companions(cards):
            if needed(hf, c) and not present(hf, c):
                ok = fetch(hf, c) and ok
        return ok


def main(argv):
    mode, every, args, i = "once", 0, [], 0
    while i < len(argv):
        a = argv[i]
        if a in ("--status", "--once"):
            mode = a[2:]
        elif a == "--watch" and i + 1 < len(argv) and argv[i + 1].isdigit():
            mode, every = "watch", max(30, int(argv[i + 1]))
            i += 1
        elif a.startswith("--"):
            print(__doc__.strip().splitlines()[0], file=sys.stderr)
            return 2
        else:
            args.append(a)
        i += 1
    cards = args[0] if args else "/opt/1bit-package/loom-cards"
    hf = args[1] if len(args) > 1 else os.environ.get("HF_HOME", "/data/lemonade/huggingface")
    if mode == "status":
        bad = 0
        for c in companions(cards):
            state = "present" if present(hf, c) else ("MISSING" if needed(hf, c) else "not needed yet (its model is not pulled)")
            bad += state == "MISSING"
            print("%s %s %s@%.8s/%s: %s" % (c[0], c[1], c[2], c[3], c[4], state))
        return 1 if bad else 0
    os.makedirs(hf, mode=DIR_MODE, exist_ok=True)
    if mode == "once":
        return 0 if run_once(cards, hf) else 1
    while True:
        run_once(cards, hf)
        time.sleep(every)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
