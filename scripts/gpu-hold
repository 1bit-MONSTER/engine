# gpu-hold [-t MINUTES] [-l LABEL] [-w WAIT_SECONDS] [-q QUEUE_DIR] [--] CMD [ARGS...]
#
# Runs one GPU job under a fair FIFO claim on the box's ~/GPU-TOKEN, so agents stop racing for it. The token
# file stays compatible with everything that predates this script: it is still one file whose content names
# its holder, and a holder that knows nothing about the queue simply makes everyone wait.
#
# What one invocation does:
#   1. writes a ticket ~/GPU-QUEUE/<epoch-ns>.<label> (pid and command go inside the ticket), so queue order is
#      file-name order: the oldest ticket runs first, whoever arrived first;
#   2. creates ~/GPU-TOKEN only when its ticket is the oldest live ticket AND the token is absent AND the die is
#      at or below the start gate, writing its label into the token;
#   3. runs CMD under that hold, with a max-hold timeout (default 14 minutes) and a watchdog that aborts it at
#      the critical temperature;
#   4. always releases the token and removes its ticket, however it exits (trap on EXIT/INT/TERM/HUP);
#   5. drops tickets, and tokens, whose owner process is gone, so a killed agent cannot block the queue;
#   6. makes a label that has just released wait RELEASE_WAIT seconds (default 180) before it holds again;
#   7. releases the token even when the payload's ROOT survives the KILL pass (a process in uninterruptible sleep
#      cannot be killed), recording the pid, its start time and its command beside the ticket so the next holder
#      is told rather than left to measure on a device that may still hold that process's memory.
#
# Options and environment (all optional):
#   -t MINUTES     max hold, default $GPU_HOLD_MINUTES or 14        (0.05 = 3 seconds)
#   -l LABEL       label written into the token, default "<command name>-$$"
#   -w SECONDS     how long to queue before giving up, default $GPU_HOLD_WAIT or 5400; exit 75 on timeout
#   -q DIR         queue directory, default $GPU_QUEUE_DIR, else the fleet's queue when it exists
#                  ($ONEBIT_HOLD_DIR/gpu-queue, /var/lib/1bit-fleet by default), else ~/GPU-QUEUE
#   GPU_TOKEN_FILE         the token file, same order of preference, else ~/GPU-TOKEN
#   ONEBIT_HOLD_DIR        where the fleet's hold state lives (engine #1504); when that directory exists it IS
#                  the queue for every caller, whoever runs: a runner under another account, a tmux lane, a
#                  systemd --user service. Without it a second account silently takes its own token and runs
#                  GPU work beside the fleet, and with it a lane that never sourced a profile file still
#                  agrees, because the default - not an environment variable - is what moved.
#   GPU_HOLD_RELEASE_WAIT  seconds a label must wait after releasing, default 180
#   GPU_HOLD_TCTL_START    start gate in C, default 75 - a hot box is not taken
#   GPU_HOLD_REPO          engine checkout to compare the running copy against (default: the checkout
#                          this file lives in). Unset and outside a checkout -> the take line says
#                          "repo unknown"; a mismatch is logged as DRIFTED and never refuses a ticket.
#   GPU_HOLD_TCTL_ABORT    abort in C, default 93
#   GPU_HOLD_MEM_ABORT_GB  end the hold when MemAvailable falls below this (GB); 0 = off, the default
#   GPU_HOLD_TCTL_FILE     temperature file in millidegrees, default the k10temp hwmon
#   GPU_HOLD_POLL          queue poll interval in seconds, default 2
#   GPU_HOLD_LOG           also append the protocol log to this file
#   GPU_HOLD_IGNORE_THERMAL_HOLD=1  start even while strixhalo-thermal-guard's ~/THERMAL-HOLD is up
#   GPU_HOLD_ALLOW_NESTED=1  allow a nested gpu-hold on the SAME queue; by default it refuses (rc 2), because a payload
#                  that wraps itself in another ticket can only wait for the ticket it is already inside (engine#2727).
#                  The payload gets GPU_HOLD_TICKET, GPU_HOLD_LABEL, GPU_HOLD_HELD_QUEUE, GPU_HOLD_HELD_LABEL and
#                  GPU_HOLD_HELD_TOKEN, so it can ask "am I already inside a ticket, and on which queue/token" instead of
#                  guessing. The token is compared as well as the queue because -q moves the queue but not the token.
#   GPU_HOLD_COOLDOWN      seconds the WHOLE queue waits after a hold that ended at or above
#                          GPU_HOLD_COOLDOWN_TCTL, whatever its label; default 180, 0 disables the cool-down
#   GPU_HOLD_COOLDOWN_TCTL die temperature at release that counts as "ended hot", default 85
#
# Exit status is the command's, or 124 when the max hold cut it short, 75 when the queue never came round.
set -u

MINUTES=${GPU_HOLD_MINUTES:-14}
LABEL=""
WAIT=${GPU_HOLD_WAIT:-5400}
HOLD=${ONEBIT_HOLD_DIR:-/var/lib/1bit-fleet}
# The fleet's state wins when it is installed, and ~ is the fallback for a box that has not been set up that way.
# BOTH lines must test the SAME thing. They used to differ -- the queue tested $HOLD/gpu-queue and the token tested
# $HOLD -- so on a box where /var/lib/1bit-fleet existed before gpu-queue did (a partially-run install, a mkdir for the
# NPU lock, anything that creates the directory first) the queue resolved to ~/GPU-QUEUE while the token resolved to
# $HOLD/gpu-token: two callers in that window hold DIFFERENT token files and both run GPU work, which is the silent
# double-hold the fleet directory exists to prevent. The directory being installed is the condition; the paths under it
# are then fixed, and $QUEUE is created by the mkdir below if the installer has not made it yet.
QUEUE=${GPU_QUEUE_DIR:-$([ -d "$HOLD" ] && printf '%s' "$HOLD/gpu-queue" || printf '%s' "$HOME/GPU-QUEUE")}
TOKEN=${GPU_TOKEN_FILE:-$([ -d "$HOLD" ] && printf '%s' "$HOLD/gpu-token" || printf '%s' "$HOME/GPU-TOKEN")}
RELEASE_WAIT=${GPU_HOLD_RELEASE_WAIT:-180}
TCTL_START=${GPU_HOLD_TCTL_START:-75}
TCTL_ABORT=${GPU_HOLD_TCTL_ABORT:-93}
# End the hold when MemAvailable falls below this many GB (0 keeps the old behaviour). Set by the caller, not
# defaulted: a box with a large model legitimately sits low, and the floor that matters is the fleet's, not this'. 
# GiB, whole number. A value that is not one is refused HERE rather than reaching `[ "$x" -gt 0 ]`, where bash
# prints "integer expression expected", the test is treated as false and the floor is silently disabled.
MEM_ABORT_GB=${GPU_HOLD_MEM_ABORT_GIB:-${GPU_HOLD_MEM_ABORT_GB:-0}}
case $MEM_ABORT_GB in
    '' | *[!0-9]*)
        echo "gpu-hold: GPU_HOLD_MEM_ABORT_GB=$MEM_ABORT_GB is not a whole number of GiB - refusing to run with a floor that cannot be enforced" >&2
        exit 2
        ;;
esac
POLL=${GPU_HOLD_POLL:-2}
LOG=${GPU_HOLD_LOG:-}
THERMAL_FLAG=${GPU_HOLD_THERMAL_FLAG:-$HOME/THERMAL-HOLD}
COOLDOWN=${GPU_HOLD_COOLDOWN:-180}
COOLDOWN_TCTL=${GPU_HOLD_COOLDOWN_TCTL:-85}
# ONE pattern for a GPU/NPU fault line, read by both the take-time refusal (#2480) and the during-hold watch (#2486).
# They had one each and the two drifted (engine#2494, cl-infra 11-15): the take-time copy lacked the gfxhub page fault
# and the MES "failed to respond", so a ticket was granted onto a log whose newest line was the fault that had just ended
# the previous hold with rc 78, and only a MODE2 reset line refused. The during-hold copy lacked the amdxdna "fault" that
# #2498 added at take time. The union is the rule's own list: a page fault, any amdgpu/MES reset or failure, a ring
# timeout, an amdxdna command timeout, power-cycle or fault.
# `power.?cycle` missed the driver's own event line: it writes "power-cycling NPU to recover" and "power-cycling
# NPU" (the -ing form does not match `cycle`), while the RECOVERY notice -- "TDR recovery throttled: last
# power-cycle 45560 ms ago ... no context touched" -- did match. Measured 2026-11-15: the notice aborted another
# lane's hold 493 s in (GPU-HOLD.log:134, rc 78), and a real `Array stopped dispatching, power-cycling NPU to
# recover` did not abort at all. The event is `power.?cycl(e|ing)`; the recovery notice is excluded by name.
GPU_FAULT_RE='\[gfxhub\] page fault|amdgpu.*(reset|hang)|ring .*timeout|MES.*(reset|failure|failed to respond)|amdxdna.*(command timeout|power.?cycl(e|ing)|fault)'
# A line that says the driver did NOTHING ("no context touched") is not a fault: it is the throttle that follows
# one, and it is logged for 60 s after every power-cycle, which is exactly when the next ticket is granted.
GPU_FAULT_SKIP_RE='aie2_tdr_recover_all: TDR recovery throttled'

while getopts ":t:l:w:q:h" opt; do
    case $opt in
        t) MINUTES=$OPTARG ;;
        l) LABEL=$OPTARG ;;
        w) WAIT=$OPTARG ;;
        q) QUEUE=$OPTARG ;;
        h) sed -n '18,58p' "$0"; exit 0 ;;
        *) echo "gpu-hold: unknown option -$OPTARG (try -h)" >&2; exit 2 ;;
    esac
done
shift $((OPTIND - 1))
[ $# -gt 0 ] || { echo "gpu-hold: no command given (try -h)" >&2; exit 2; }

# engine#2727: a payload that re-invokes gpu-hold on the queue it is ALREADY inside queues behind its own ticket and then
# waits for it -- the outer hold burns its whole max-hold with the GPU idle (measured 2026-11-16: 764 s of a 14-minute
# window, while coder-llm waited 25 min behind it and every PR's pr-agent/reviewer check waited behind that). The
# payload can now see the ticket (GPU_HOLD_TICKET) but not WHICH queue it is inside, so the "wrap myself if I am not
# already under a ticket" idiom could not answer the question it exists for. The queue is exported for exactly that, and
# the same-queue case is refused here rather than left to burn a window. A DIFFERENT queue still runs: npu-hold execs
# this script with the NPU's queue and the hw-gate takes its own GPU claim inside an NPU ticket, and that is the shape
# npu-hold documents as required.
if [ -n "${GPU_HOLD_HELD_QUEUE:-}" ] && [ "${GPU_HOLD_ALLOW_NESTED:-0}" != 1 ]; then
    _nest_here=$(cd "$QUEUE" 2> /dev/null && pwd -P || printf '%s' "$QUEUE")
    _nest_there=$(cd "$GPU_HOLD_HELD_QUEUE" 2> /dev/null && pwd -P || printf '%s' "$GPU_HOLD_HELD_QUEUE")
    if [ "$_nest_here" = "$_nest_there" ]; then
        echo "gpu-hold: refusing to queue inside the ticket that is already running this command (label '${GPU_HOLD_HELD_LABEL:-?}', queue $_nest_there, rc 2). The outer ticket already holds the GPU, so this invocation could only wait for its own parent and waste the window (engine#2727). Drop the inner gpu-hold: the outer one is the ticket. A run that really needs a second ticket on the same queue must say so with GPU_HOLD_ALLOW_NESTED=1." >&2
        exit 2
    fi
fi
# ...and the QUEUE is not the whole key: `-q` moves $QUEUE without moving $TOKEN (a separate option, and the token's own
# default does not read $QUEUE), so a nested claim on a DIFFERENT queue still waits for the token its parent holds. The
# token is the thing it waits on -- gpu-hold's own wait line says so ("first in the queue, waiting for <token> (held by:
# <label> pid <pid>)") -- so the comparison is on the token too. engine#2727 review, measured: outer on q1, payload
# running `-q q2` with the inherited token sat 4 s and then reported "queue never came round" (rc 75) with the outer.
if [ -n "${GPU_HOLD_HELD_TOKEN:-}" ] && [ "${GPU_HOLD_ALLOW_NESTED:-0}" != 1 ]; then
    _tok_here=$(cd "$(dirname "$TOKEN")" 2> /dev/null && pwd -P || dirname "$TOKEN")
    _tok_there=$(cd "$(dirname "$GPU_HOLD_HELD_TOKEN")" 2> /dev/null && pwd -P || dirname "$GPU_HOLD_HELD_TOKEN")
    if [ "$_tok_here/$(basename "$TOKEN")" = "$_tok_there/$(basename "$GPU_HOLD_HELD_TOKEN")" ]; then
        echo "gpu-hold: refusing to queue inside the ticket that is already running this command (label '${GPU_HOLD_HELD_LABEL:-?}', token $_tok_here/$(basename "$TOKEN"), rc 2). -q moves the queue but not the token, so this invocation would wait for the token its own parent holds and waste the window (engine#2727). Drop the inner gpu-hold, or say GPU_HOLD_ALLOW_NESTED=1 if a second ticket on the same token is really wanted." >&2
        exit 2
    fi
fi

tctl_file() {
    if [ -n "${GPU_HOLD_TCTL_FILE:-}" ]; then printf '%s' "$GPU_HOLD_TCTL_FILE"; return; fi
    local f
    f=$(grep -l k10temp /sys/class/hwmon/*/name 2> /dev/null | head -n 1)
    if [ -n "$f" ]; then printf '%s' "$(dirname "$f")/temp1_input"; else printf '%s' /dev/null; fi
}
TCTL_FILE=$(tctl_file)
tctl() {
    local v
    v=$(cat "$TCTL_FILE" 2> /dev/null) || v=""
    if [ -n "$v" ]; then echo $((v / 1000)); else echo 0; fi
}

# WHICH COPY RAN, recorded on the take line. What runs on the box is ~/.local/bin/gpu-hold, a copy that nothing
# re-installs on merge, so the guards in this file can be merged and still not be live: measured twice, once as
# "identical to engine main" after #2486 (11-15 05:52Z) and 16 h later as the pre-#2538 copy with no take-time
# guard at all (11-16 03:2xZ, pi-os3). Reconstructing that meant comparing sizes, mtimes and pattern counts by
# hand. The sha256 of the running file answers it in one field: `sha256sum scripts/gpu-hold` is the comparison.
# $0 is resolved here, before anything could change the working directory.
SCRIPT_ID=$(sha256sum -- "$0" 2> /dev/null | cut -c1-12) || SCRIPT_ID=""
[ -n "$SCRIPT_ID" ] || SCRIPT_ID="unknown"
# ...and the copy to compare it WITH, because "which copy ran" only becomes a detector when the other side is known.
# GPU_HOLD_REPO names an engine checkout; otherwise the checkout $0 itself lives in, if it lives in one. The installed
# copy is normally in no checkout at all and then says `repo unknown` -- never `same`, which would be the one wrong
# answer (the 11-16 03:2xZ copy reported itself as fine for 16 h). DRIFTED is a warning, never a refusal: a lane
# testing a branch copy is a legitimate reason for the two to differ.
_repo_root=""
if [ -n "${GPU_HOLD_REPO:-}" ]; then
    _repo_root=$GPU_HOLD_REPO
elif _r=$(git -C "$(dirname -- "$0")" rev-parse --show-toplevel 2> /dev/null); then
    _repo_root=$_r
fi
REPO_ID=""
if [ -n "$_repo_root" ] && [ -f "$_repo_root/scripts/gpu-hold" ]; then
    REPO_ID=$(sha256sum -- "$_repo_root/scripts/gpu-hold" 2> /dev/null | cut -c1-12)
fi
REPO_ID=${REPO_ID:-unknown}
if [ "$REPO_ID" = "unknown" ]; then
    COPY_CHECK="repo unknown"
elif [ "$REPO_ID" = "$SCRIPT_ID" ]; then
    COPY_CHECK="repo $REPO_ID same"
else
    COPY_CHECK="repo $REPO_ID DRIFTED (this box runs a copy that is not the checkout's)"
fi

log() {
    local line
    line="gpu-hold[$$] $* $(date -Is)"
    printf '%s\n' "$line" >&2
    if [ -n "$LOG" ]; then printf '%s\n' "$line" >> "$LOG"; fi
}

mkdir -p "$QUEUE" || { echo "gpu-hold: cannot create $QUEUE" >&2; exit 2; }
COOLDOWN_STAMP="$QUEUE/.cooldown"      # "<epoch> <C>" of the last hold that ended hot; shared by every label
[ -n "$LABEL" ] || LABEL="$(basename -- "$1")-$$"
SAFE=$(printf '%s' "$LABEL" | tr -c 'A-Za-z0-9_.-' '_')
TICKET="$QUEUE/$(printf '%020d' "$(date +%s%N)").$SAFE"
RELEASED_AT="$QUEUE/.released-at.$SAFE"
# a root that survived KILL is recorded here, beside the ticket, so the NEXT holder is told: the log line alone
# scrolls away with the ticket, and the next lane then measures on a device that may still hold the wedged
# process's GTT - which is the 2026-11-08 incident (a 14 h llama-server holding 51 GiB that nobody knew about
# until the PR agent died). engine #1639.
SURVIVORS="$QUEUE/.gpu-hold-survivors"
TICKET_NAME=$(basename "$TICKET")

state=queued
mine=""
child=""
watchdog=""

# A hold that ends hot leaves the box soaked: the next claim, whatever its label, would start on hot air and climb
# straight back. cool_end stamps the queue at release; cool_left is what the next ticket waits.
cool_end() {
    local t
    [ "$COOLDOWN" -gt 0 ] || return 0
    t=$(tctl)
    [ "$t" -ge "$COOLDOWN_TCTL" ] || return 0
    printf '%s %s\n' "$(date +%s)" "$t" > "$COOLDOWN_STAMP"
    log "ended at ${t}C: no new claim starts for ${COOLDOWN}s (any label)"
}
cool_left() {
    local stamp now
    [ "$COOLDOWN" -gt 0 ] && [ -f "$COOLDOWN_STAMP" ] || { echo 0; return; }
    stamp=$(sed -n '1s/ .*//p' "$COOLDOWN_STAMP" 2> /dev/null)
    case $stamp in '' | *[!0-9]*) echo 0; return ;; esac
    now=$(date +%s)
    if [ $((now - stamp)) -lt "$COOLDOWN" ]; then echo $((COOLDOWN - now + stamp)); else echo 0; fi
}

release() {
    if [ "$state" = holding ] && [ -n "$mine" ] && [ "$(cat "$TOKEN" 2> /dev/null)" = "$mine" ]; then
        cool_end
        rm -f "$TOKEN"
        date +%s > "$RELEASED_AT"
        log "released $TOKEN"
    fi
    if [ "$state" != done ]; then rm -f "$TICKET"; fi
    state=done
}
trap release EXIT
# TERM/INT/HUP must END THE PAYLOAD before the token comes back. `exit 143` alone ran only the EXIT trap: the token was
# released and the ticket removed while the payload kept the device, so the next lane was admitted on top of it (the
# 11-08 orphan, reached through a different door: `timeout`, an operator kill, an orchestrator stopping a lane). Its
# tree is ended with the same kill_tree the watchdog uses, so a process two levels down cannot survive the signal
# either. `child` is empty while queued, so a signal in the queue still just leaves the queue; `declare -F` covers the
# one window where the payload has started but the function is not defined yet.
trap '[ -n "${child:-}" ] && declare -F kill_tree > /dev/null && kill_tree "$child"; exit 143' TERM INT HUP

pid_of() { sed -n 's/^pid=\([0-9][0-9]*\).*/\1/p' "$1" 2> /dev/null | head -n 1; }

stale() {
    local pid
    pid=$(pid_of "$1")
    if [ -z "$pid" ]; then return 0; fi          # unreadable or half-written: stale
    kill -0 "$pid" 2> /dev/null && return 1
    return 0
}

oldest_ticket() {
    local f pid
    for f in $(ls -1 "$QUEUE" 2> /dev/null | grep -v '^\.' | sort); do
        [ -f "$QUEUE/$f" ] || continue
        if stale "$QUEUE/$f"; then
            # engine #1635: the owner of this ticket is still polling, so dropping it silently left it waiting for a
            # queue position that no longer existed. Leave a note in the queue directory (dotfiles are never treated
            # as tickets) so the victim can say WHY its ticket vanished, not only that it did.
            pid=$(pid_of "$QUEUE/$f")
            # One file per ticket, not one shared log: the victim reads its own note and removes it, so the queue
            # directory cannot accumulate notes for the life of the box (review note on PR #1636).
            printf '%s dropped %s: owner pid %s is gone (dropped by pid %s)\n' \
                "$(date -Is)" "$f" "${pid:-unknown}" "$$" > "$QUEUE/.reaped.$f" 2> /dev/null
            rm -f "$QUEUE/$f"
            log "dropped stale ticket $f (owner pid gone)"
            continue
        fi
        printf '%s' "$f"
        return
    done
}

# A token left behind by a killed holder blocks everyone, so reap it too - but only when it is clearly ours to
# read (a "gpu-hold ..." line with a pid). Anything else is left alone: it belongs to a wrapper this script
# does not know.
reap_token() {
    [ -e "$TOKEN" ] || return 0
    local content pid
    content=$(cat "$TOKEN" 2> /dev/null) || return 0
    case $content in gpu-hold*) ;; *) return 0 ;; esac
    pid=$(printf '%s' "$content" | sed -n 's/.* pid \([0-9][0-9]*\) .*/\1/p' | head -n 1)
    if [ -n "$pid" ] && ! kill -0 "$pid" 2> /dev/null; then
        rm -f "$TOKEN"
        log "dropped stale token (holder pid $pid gone): $content"
    fi
}

printf 'pid=%s\nlabel=%s\ncmd=%s\nenqueued=%s\n' "$$" "$LABEL" "$*" "$(date -Is)" > "$TICKET" ||
    { echo "gpu-hold: cannot write $TICKET" >&2; exit 2; }
log "queued '$LABEL' as $TICKET_NAME"

waited=0
while [ "$state" = queued ]; do
    if [ ! -e "$TICKET" ]; then
        # engine #1635: something (a reaper, another lane) removed a queued ticket. The head-of-queue test below
        # can then never come true, and the wait would run to -w (5400 s by default) looking exactly like "queued
        # behind a busy box". Fail in this poll instead, and name what went missing. state=done first so the
        # release() trap does not touch a token this process never took.
        why=$(cat "$QUEUE/.reaped.$TICKET_NAME" 2> /dev/null | tail -n 1)
        rm -f "$QUEUE/.reaped.$TICKET_NAME" 2> /dev/null
        log "::error::my ticket $TICKET_NAME is gone from $QUEUE after ${waited}s (token: $(cat "$TOKEN" 2> /dev/null || echo free)) - it was reaped or removed, so this queue position no longer exists; not waiting ${WAIT}s for it${why:+ [$why]}"
        state=done
        exit 75
    fi
    reap_token
    # engine#2494: say it AT QUEUE TIME, not only at take. A ticket granted while the last N minutes carry a fault line is
    # refused (the check below, #2480/#2498), and since the shared pattern covers both devices an NPU burst refuses GPU
    # tickets too: measured 2026-11-16, an NPU line sat inside that window for **27 % of the day** while the GPU itself
    # logged nothing. From a queue position a lane cannot see that, so it waits and then loses the position to a refusal
    # it could have predicted. This is the same PATTERN (GPU_FAULT_RE/GPU_FAULT_SKIP_RE, so the two cannot drift) read
    # over the same window; it decides nothing -- the refusal still happens at take, when the window is re-read, because
    # a queue wait can be minutes long and the condition can clear (or arrive) in the meantime.
    if [ "$waited" = 0 ] && [ "${GPU_HOLD_FAULT_ABORT:-1}" != 0 ] && [ -z "${GPU_HOLD_QUEUE_STATE_OFF:-}" ]; then
        _qs_window=${GPU_HOLD_RESET_WINDOW_MIN:-10}
        _qs_hits=$(if [ -n "${GPU_HOLD_KLOG_FILE:-}" ]; then cat "$GPU_HOLD_KLOG_FILE" 2> /dev/null
                   else journalctl -k --since "-${_qs_window} min" --no-pager -q 2> /dev/null; fi |
                   grep -iE "$GPU_FAULT_RE" | grep -viE "$GPU_FAULT_SKIP_RE")
        if [ -n "$_qs_hits" ]; then
            _qs_dev=GPU; printf '%s\n' "$_qs_hits" | tail -1 | grep -qi amdxdna && _qs_dev=NPU
            log "::warning::queued while the kernel log carries a ${_qs_dev} fault line in the last ${_qs_window} min - if it is still there when this ticket reaches the front, the take is REFUSED (rc 78) and this queue position is lost; newest: $(printf '%s\n' "$_qs_hits" | tail -1 | cut -c1-160)"
        fi
    fi
    cool=$(cool_left)
    head_ticket=$(oldest_ticket)
    if [ "$head_ticket" = "$TICKET_NAME" ]; then
        if [ -e "$TOKEN" ]; then
            if [ "$waited" = 0 ]; then
                log "first in the queue, waiting for $TOKEN (held by: $(cat "$TOKEN" 2> /dev/null || echo '?'))"
            fi
        elif [ "$(tctl)" -ge "$TCTL_START" ]; then
            if [ "$waited" = 0 ]; then
                log "first in the queue, holding off: die at $(tctl)C, start gate ${TCTL_START}C"
            fi
        elif [ -e "$THERMAL_FLAG" ] && [ "${GPU_HOLD_IGNORE_THERMAL_HOLD:-0}" != 1 ] &&
             kill -0 "$(head -n 1 "$THERMAL_FLAG" 2> /dev/null)" 2> /dev/null; then
            # strixhalo-thermal-guard has the box hot and the compilers paused: a new claim would only add heat.
            if [ "$waited" = 0 ]; then
                log "first in the queue, holding off: $(head -n 2 "$THERMAL_FLAG" | paste -sd' ') is up"
            fi
        elif [ -f "$RELEASED_AT" ] &&
             [ $(( $(date +%s) - $(cat "$RELEASED_AT" 2> /dev/null || echo 0) )) -lt "$RELEASE_WAIT" ]; then
            if [ "$waited" = 0 ]; then
                log "first in the queue, releasing label waits ${RELEASE_WAIT}s after its last hold"
            fi
        elif [ "$cool" -gt 0 ]; then
            if [ "$waited" = 0 ] || [ $((waited % 60)) = 0 ]; then
                log "first in the queue, cooling down after a hot hold (${cool}s to go, then any label may start)"
            fi
        else
            mine="gpu-hold $LABEL pid $$ $(date -Is)"
            if ( set -o noclobber; printf '%s\n' "$mine" > "$TOKEN" ) 2> /dev/null; then
                state=holding
                log "took $TOKEN after ${waited}s (die $(tctl)C; script $SCRIPT_ID; $COPY_CHECK)"
                # A RECENT amdgpu/MES RESET, checked at the one choke point every lane goes through. The standing rule is
                # "on any amdgpu reset: stop, release the ticket" and until now nothing implemented it - my own window
                # harness had no such check (grep 'dmesg|reset|MES' = 0 in all three scripts) and on 2026-11-15 a window
                # started 7 minutes after an MES reset, hours before the box took a hard CPU shutdown. Lane-local guards
                # only protect the lanes that wrote them; this one protects the ticket.
                #
                # Refuse only when the kernel log is READABLE and shows a reset in the window. On a CI runner there is no
                # kernel log to read and `gpu_hold_*`'s own tests must keep passing, so "cannot read" is a note, not a
                # refusal - the opposite of a device guard, and worth stating because it is the surprising half.
                _reset_window=${GPU_HOLD_RESET_WINDOW_MIN:-10}
                # GPU_HOLD_KLOG_FILE is the same override the during-hold watcher uses: without it this refusal had no
                # automated arm at all (it shipped with manual arms only), because "a reset two minutes ago" cannot be
                # produced in a test that reads the real journal.
                if [ -n "${GPU_HOLD_KLOG_FILE:-}" ]; then
                    _klog=$(cat "$GPU_HOLD_KLOG_FILE" 2> /dev/null)
                else
                    _klog=$(journalctl -k --since "-${_reset_window} min" --no-pager 2> /dev/null)
                fi
                if [ -z "$_klog" ]; then
                    log "note: no kernel log available, so a reset in the last ${_reset_window} min cannot be ruled out (not refusing: CI has no journal)"
                else
                    # The NPU spellings belong here too: npu-hold execs this script with the NPU's own queue and
                    # token, so this take-time check is an NPU ticket's ONLY look at the log before work starts,
                    # while the during-hold watch below already reads amdxdna faults. Without them a lane could
                    # take an NPU ticket minutes after the command timeout the rules say to stop for (measured
                    # 2026-11-15: the hold ran on a log whose newest line was an amdxdna command timeout).
                    _reset_re=$GPU_FAULT_RE
                    _resets=$(printf '%s\n' "$_klog" | grep -iE "$_reset_re" | grep -viE "$GPU_FAULT_SKIP_RE" | grep -c .)
                    if [ "${_resets:-0}" -gt 0 ]; then
                        rm -f "$TOKEN"; state=done
                        # HOW OLD is the newest one? "in the last 10 min" cannot tell a wedged device from another lane's
                        # teardown nine minutes ago, and on 2026-11-15 that distinction mattered: every amdxdna fault that
                        # refused a ticket arrived 1.5-8.5 min AFTER the previous ticket released the NPU, i.e. nothing was
                        # running when it was logged (engine#2542). The age is the datum a reader needs; the epoch comes
                        # from a second query so the printed lines keep their human-readable form.
                        # The skip term applies to the age as well as to the count: the recovery-throttle notice is logged
                        # for 60 s after every power-cycle and says "no context touched", so without this the refusal could
                        # count only real faults and then report the notice's age as if it were the newest fault's.
                        _newest=$(journalctl -k --since "-${_reset_window} min" --no-pager -o short-unix -q 2> /dev/null |
                                  grep -iE "$_reset_re" | grep -viE "$GPU_FAULT_SKIP_RE" | tail -1 | awk '{print int($1)}')
                        _age=""
                        case "${_newest:-}" in ''|*[!0-9]*) ;; *) _age=", newest $(( $(date +%s) - _newest ))s ago" ;; esac
                        log "::error::refusing: ${_resets} amdgpu/MES/amdxdna fault line(s) in the last ${_reset_window} min${_age} - the ticket is released unheld. Inspect the kernel log, then retry"
                        printf '%s\n' "$_klog" | grep -iE "$_reset_re" | grep -viE "$GPU_FAULT_SKIP_RE" | tail -3
                        exit 78
                    fi
                fi
                # the previous holder left a process the kernel would not kill: say so before this lane measures
                if [ -s "$SURVIVORS" ]; then
                    log "::warning::previous holder left $(tr '\n' ';' < "$SURVIVORS") - that device may still hold its memory (engine #1639)"
                    : > "$SURVIVORS"
                fi
                break
            fi
        fi
    fi
    if [ "$waited" -ge "$WAIT" ]; then
        log "::error::queue never came round after ${WAIT}s (head: ${head_ticket:-none}, token: $(cat "$TOKEN" 2> /dev/null || echo free))"
        rm -f "$TICKET"
        state=done
        exit 75
    fi
    sleep "$POLL"
    waited=$((waited + POLL))
done

deadline=$(( $(date +%s) + $(awk -v m="$MINUTES" 'BEGIN { printf "%d", m * 60 }') ))
started=$(date +%s)
# Defined BEFORE the payload starts, on purpose: the signal trap calls kill_tree, and a TERM landing between
# `child=$!` and the definition runs the trap with the payload started and the helper undefined -- `declare -F`
# then skips the kill, so the token is released and the payload survives, which is the leak this order removes
# (engine#1640; #1642 landed the guard, this is the ordering that makes it always true).
descendants() {   # <pid> -> its descendants and then itself, deepest last
    local k
    for k in $(ps -o pid= --ppid "$1" 2> /dev/null); do
        descendants "$k"
    done
    printf '%s\n' "$1"
}
kill_tree() {
    local root=$1 grace=${2:-10} i=0 p
    # Snapshot ONCE, before any signal. Re-walking after TERM loses exactly the processes this pass exists for: a
    # process that ignores TERM is the one still alive when the second walk runs, and if its own parent exited during
    # the grace period it has been reparented (to init or a subreaper), so `ps --ppid "$root"` no longer links it to the
    # ticket. The KILL pass then cannot see it and the orphan survives the hold -- which is the failure this function was
    # written to end. A snapshot also fixes the grace period: `kill -0` with a pid list is true while ANY of them lives,
    # so a wrapper that exits promptly no longer denies its children the grace they were promised.
    # The group first: it is named by the payload's own pid and stays valid while ANY member lives, so this reaches
    # descendants the walk cannot see (the root already gone, or a child that reparented before the snapshot). The
    # walk stays as the fallback for a payload that moved itself into another group.
    kill -TERM -- "-$root" 2> /dev/null
    local tree; tree=$(descendants "$root")
    for p in $tree; do kill -TERM "$p" 2> /dev/null; done
    while kill -0 $tree 2> /dev/null && [ "$i" -lt "$grace" ]; do
        sleep 1
        i=$((i + 1))
    done
    kill -KILL -- "-$root" 2> /dev/null
    for p in $tree; do kill -KILL "$p" 2> /dev/null; done
}
# A payload can leave the process group entirely -- `setsid`, or a double fork -- and then neither the group kill nor
# the descendant snapshot can see it, because both are anchored on the tree. Measured 2026-11-16: a `1bit serve` took
# **44.4 GiB of GTT**, its ticket ended, and the serve held the memory for 64 minutes while the box went to 351 MiB
# available with two OOM kills in the hour (`ps -o ppid=` -> 1, and its own environment still said
# `GPU_HOLD_TICKET=... pid 3216578`, a pid that no longer existed). engine#1621 fixed grandchildren and engine#1649 the
# process group; this is the one shape neither reaches.
#
# The environment is the detector that does not depend on the tree: every process the payload started INHERITED this
# ticket's GPU_HOLD_TICKET, whatever it did to its parentage, session or group. So after the teardown, any live process
# still carrying this exact ticket line is work this ticket started and did not end.
#
# This is a detector, not an enforcement of the promise, and the boundary is worth naming: a payload that also scrubs
# its environment (`env -i`, `unset GPU_HOLD_TICKET`) starts work that carries no ticket line, and nothing here would
# see it. For that case the `.gpu-hold-survivors` file and the next holder's #1639 warning are the backstop -- so is
# the memory floor's other side, a lane that reads GTT before it takes a ticket. A reader deciding whether to trust the
# teardown line should read it as "no escapee that kept its environment", not as "no escapee".
env_survivors() {   # <exact ticket line> -> pids carrying it, excluding this shell and any nested holder
    local want=$1 d p line cmd first second
    ENV_UNREADABLE=0
    for d in /proc/[0-9]*; do
        p=${d#/proc/}
        [ "$p" = "$$" ] && continue
        if [ ! -r "$d/environ" ]; then
            # engine#2744 review: silently skipping an unreadable process makes an escapee invisible and the teardown
            # line reads clean. Counted and reported by the caller, which is what every other guard in this script does.
            ENV_UNREADABLE=$((ENV_UNREADABLE + 1))
            continue
        fi
        line=$(tr '\0' '\n' < "$d/environ" 2> /dev/null | grep -m1 -F "GPU_HOLD_TICKET=$want") || continue
        [ "$line" = "GPU_HOLD_TICKET=$want" ] || continue
        # engine#2737's override (`GPU_HOLD_ALLOW_NESTED=1`) means an inner gpu-hold runs with the OUTER ticket line in its
        # environment by design -- env is frozen at exec, and the inner script only exports its own line to its child. That
        # holder manages its own teardown; killing it here would leave its ticket file behind and block the queue until a
        # human noticed. So a process whose own command IS gpu-hold is not an escapee.
        cmd=$(tr '\0' ' ' < "$d/cmdline" 2> /dev/null)
        first=${cmd%% *}
        second=${cmd#* }
        second=${second%% *}
        if [ "${first##*/}" = "gpu-hold" ] || [ "${second##*/}" = "gpu-hold" ]; then
            continue
        fi
        printf '%s\n' "$p"
    done
}

# The payload gets its PROCESS GROUP of its own (`set -m` makes every background job a group leader), because a
# process group is the one thing a descendant cannot escape: reparenting to init does not change it, and a group
# outlives its leader, so `kill -- -$child` still reaches the children AFTER the payload's root has gone. Without it
# the whole tree-kill is anchored on the root: a lane that starts a server and returns (`gpu-hold -- bash -c 'server &'`)
# leaves the root dead before the teardown runs, `descendants "$root"` is empty before it is even snapshotted, and the
# server outlives its ticket (engine#1649: measured, payload root exits by itself, `trap '' TERM` grandchild survives
# on main). `-m` also makes `$!` the payload's own pid, so `wait` still reports the payload's status.
set -m
# `< /dev/null` is NOT decoration: job control makes a background job keep the shell's stdin, so without it the payload
# would read whatever the CALLER is reading. Measured (bash 5.3.9), the fleet's own sweep shape
# `while read m; do gpu-hold -- bench "$m"; done < list`: without `set -m` the loop runs every entry, with `set -m` the
# first payload's `cat` swallows the rest and the sweep silently runs once. Background jobs on `main` already got
# /dev/null (a non-interactive shell's rule), so this keeps that semantic and takes only the process group.
# A child cannot otherwise prove it is the HOLDER rather than a bystander: `[ -e "$TOKEN" ]` is true whenever ANY lane
# holds the box, so a guard written with it passes exactly when starting work is most harmful (measured 2026-11-14: my
# own runner did that for 40 s against another lane's 45-minute ticket). The token's content is what this run wrote, so
# give it to the child - exact, not a string guess:
#   GPU_HOLD_TICKET  the exact line in the token file ("gpu-hold <label> pid <pid> <ts>")
#   GPU_HOLD_LABEL   the label, sanitised, as it appears in that line
env GPU_HOLD_TICKET="$mine" GPU_HOLD_LABEL="$SAFE" GPU_HOLD_HELD_QUEUE="$QUEUE" GPU_HOLD_HELD_LABEL="$LABEL" \
        GPU_HOLD_HELD_TOKEN="$TOKEN" "$@" < /dev/null &
child=$!
set +m   # job control is needed only to place THIS job in its own group; leaving it on would make every later
         # background job in this shell a background *group*, which is a semantic this script does not want to
         # inherit. Measured: the payload keeps its own group after `set +m`, so the group kill still reaches it.
# shortcut: a payload that READS the controlling terminal is now a background group and would be stopped by SIGTTIN
# (job control's own rule). `gpu-hold` is for benchmarks and servers, which do not; an interactive payload on a tty is
# not a use this script supports, and the max-hold bound ends it (rc=124) rather than leaving the token held.
# The watchdog is a function so it can be given the command's pid: a subshell inherits a copy of the shell's
# variables, so a watchdog started before the command (the first version did) holds an empty pid and neither
# the abort nor the max hold stops anything.
# End the hold's whole DESCENDANT TREE: TERM first so a runner can clean up after itself (thermal-run's
# scope, a benchmark's teardown), then KILL after a grace period for anything that ignored it. Walking
# `ps --ppid` is depth-agnostic; `pkill -P` reached only the first level, which is why three orphans
# survived their tickets on 2026-11-08/09 — in each one the process holding the memory was two or three
# levels down (ticket → shell → runner → server). A process group would express this too, but `setsid`
# forks when it is already a group leader (which it is inside `systemd-run --scope`), so `$!` stops
# naming the group; recursion has no such trap.


# MemAvailable, in GB, as the kernel reports it. 0 disables the abort (the old behaviour).
mem_available_gb() {
    # first match only: a fixture that adds a second MemAvailable line would otherwise concatenate both numbers
    awk '/^MemAvailable:/ { printf "%d", $2 / 1048576; exit }' "${GPU_HOLD_MEMINFO:-/proc/meminfo}" 2> /dev/null
}

# A GPU FAULT DURING THE HOLD (CRASH-HUNT 2026-11-15, ~/briefs/CRASH-HUNT-STATE.md): #2480 refuses a ticket after a recent
# reset, but only at the moment the token is taken. The 11-13 crash was nine MES REMOVE_QUEUE -> MODE2 resets inside two
# tickets: each reset followed a gfxhub page fault ~2 s earlier from the ticket's own job, the job's next process faulted
# again, and the GPU wedged after the ninth. So the watchdog also reads the kernel log for lines that appeared SINCE this
# hold started: a page fault, an amdgpu/MES reset or ring timeout, or an amdxdna command timeout ends the hold (rc 78).
# GPU_HOLD_FAULT_ABORT=0 turns it off. With no readable kernel log (a CI runner) it is inert, as #2480's check is.
# GPU_HOLD_KLOG_FILE replaces the kernel log with a file (tests).
FAULT_ABORT=${GPU_HOLD_FAULT_ABORT:-1}
FAULT_RE=$GPU_FAULT_RE
FAULT_FLAG="$QUEUE/.fault.$SAFE.$$"
fault_lines() {
    if [ -n "${GPU_HOLD_KLOG_FILE:-}" ]; then
        cat "$GPU_HOLD_KLOG_FILE" 2> /dev/null
    else
        journalctl -k --since "@$started" --no-pager -q 2> /dev/null
    fi | grep -iE "$FAULT_RE" | grep -viE "$GPU_FAULT_SKIP_RE"
}

# WHAT THE TICKET HELD ON THE DEVICE, recorded at the moment a fault ends it (engine#2494). Every post-mortem of this
# class has started by reconstructing that from `ps` and `/sys` after the fact, and the numbers are gone once the ticket
# is killed: measured 2026-11-16, 67 fault blocks classified by hand with no memory figure for the faulting moment, and
# the one that mattered (a 44.4 GiB serve that outlived its ticket) was only visible because `ps` still had it. A few
# sysfs reads per descendant, no device call, before kill_tree runs.
gpu_state_dump() {   # <payload-pid>; logs one line per KFD holder, or one line saying this ticket holds none
    local p v q holders=0 kfd=/sys/class/kfd/kfd/proc
    for p in $(descendants "$1"); do
        [ -d "$kfd/$p" ] || continue
        holders=$((holders + 1))
        v=$(cat "$kfd/$p"/vram_* 2> /dev/null | head -1)
        q=$(ls "$kfd/$p"/queues 2> /dev/null | wc -l)
        log "  held: pid $p gpu=$(( ${v:-0} / 1048576 ))MiB queues=$q cmd=$(tr '\0' ' ' < "/proc/$p/cmdline" 2> /dev/null | cut -c1-80)"
    done
    [ "$holders" -gt 0 ] || log "  held: no process of this ticket has a KFD context (this fault came from another lane's job)"
}

watch() {
    local target=$1 tick=0
    while sleep 2; do
        tick=$((tick + 1))
        # every 10 s: journalctl over the hold's own window is cheap, but not free every 2 s
        if [ "$FAULT_ABORT" != 0 ] && [ $((tick % 5)) = 0 ]; then
            hits=$(fault_lines)
            if [ -n "$hits" ]; then
                : > "$FAULT_FLAG"
                # Name the device from the newest line: npu-hold execs this script too and the watch reads every kernel
                # line, so a GPU ticket can end on another lane's NPU fault (and the other way round). Saying which
                # device faulted keeps a lane from searching its own job for a fault it did not cause (#2538 review).
                _dev=GPU; printf '%s\n' "$hits" | tail -1 | grep -qi amdxdna && _dev=NPU
                log "::error::ABORT GPU/NPU fault in the kernel log during this hold - ending it before the next one (rc 78): newest line is from the ${_dev}; if this ticket is not for the ${_dev}, another lane's job produced it:"
                printf '%s\n' "$hits" | tail -3 | while IFS= read -r l; do log "  $l"; done
                gpu_state_dump "$target"   # before the kill: after it the numbers are gone
                kill_tree "$target" "${GPU_HOLD_KILL_GRACE:-10}"
                return
            fi
        fi
        # The OOM kill this prevents is not the run's own: on 2026-11-08/09 a GPU run took the box to 0.7 GiB
        # available and the kernel chose the PR-agent LLM as the victim, which took the fleet's own brains down.
        # The temperature gate has the same shape — one sampled number, one threshold, end the hold — so the
        # memory floor rides the same watchdog rather than adding a second one.
        if [ "${MEM_ABORT_GB:-0}" -gt 0 ]; then
            avail=$(mem_available_gb)
            if [ -n "$avail" ] && [ "$avail" -lt "$MEM_ABORT_GB" ]; then
                log "ABORT ${avail} GiB MemAvailable (floor ${MEM_ABORT_GB} GiB) - ending the hold before the kernel picks a victim"
                kill_tree "$target" "${GPU_HOLD_KILL_GRACE:-10}"
                return
            fi
        fi
        t=$(tctl)
        if [ "$t" -ge "$TCTL_ABORT" ]; then
            log "ABORT die at ${t}C (limit ${TCTL_ABORT}C)"
            kill_tree "$target" "${GPU_HOLD_KILL_GRACE:-10}"
            return
        fi
        if [ "$(date +%s)" -ge "$deadline" ]; then
            log "max hold of ${MINUTES} min reached"
            kill_tree "$target" "${GPU_HOLD_KILL_GRACE:-10}"
            return
        fi
        # the command is gone: nothing left to guard. This is also what lets the caller simply WAIT for this
        # shell instead of killing it — a kill here would land inside kill_tree's grace period and cancel the
        # KILL pass, which is how a TERM-ignoring descendant survived its ticket.
        kill -0 "$target" 2> /dev/null || return
    done
}
watch "$child" &
watchdog=$!

# A payload ROOT that survives the KILL pass holds this token for ever: a process wedged in uninterruptible
# sleep cannot be killed by SIGKILL, and every other lane then sits in the FIFO behind a job that cannot die.
# Bound the wait and release anyway - a wedged job costs one lane's measurement, not the queue (engine #1639;
# the deployed copy on strixhalo has had this bound since 2026-11-06, and this is it brought back to the repo).
# GPU_HOLD_KILL_GRACE is the TERM->KILL window; GPU_HOLD_SURVIVE_WAIT is the settle time after it.
#
# This bound is COMPLEMENTARY to the bounded wait for the watchdog that #1626 landed further down: with a
# survived root the watchdog keeps polling `kill -0 "$target"` and will not exit on its own, so before #1626 this
# script would have hung in that wait instead. A future reader rebasing one of the two should see that the other
# is what makes the token actually reach `release`.
survive_by=$(( ${GPU_HOLD_KILL_GRACE:-10} + ${GPU_HOLD_SURVIVE_WAIT:-60} ))
stopped=0
while kill -0 "$child" 2> /dev/null; do
    # 0.2 s, not 1 s: the poll is on the way to `wait`, so a coarse sleep makes every hold pay up to a second and
    # the ticket log's "after Ns" steps up by one for fast payloads (a review finding). The bound itself is in
    # whole seconds, so the granularity only costs response time.
    sleep 0.2
    base=$deadline
    if [ -n "${STOP_STAMP:-}" ] && [ -f "$STOP_STAMP" ]; then
        base=$(cat "$STOP_STAMP" 2> /dev/null || printf '%s' "$deadline")
        stopped=1
    fi
    [ "$(date +%s)" -ge $(( base + survive_by )) ] && break
done
if kill -0 "$child" 2> /dev/null; then
    log "::error::child $child survived KILL: releasing the token anyway (a wedged job costs one lane's measurement, not the queue)"
    # durable, not just in a log that scrolls away: the next acquire prints this
    {
        printf 'pid=%s start=%s cmd=%s\n' "$child" \
            "$(ps -o lstart= -p "$child" 2> /dev/null | sed 's/^ *//' || printf unknown)" \
            "$(tr '\0' ' ' < "/proc/$child/cmdline" 2> /dev/null | cut -c1-120 || printf unknown)"
    } >> "$SURVIVORS" 2> /dev/null || true
    # a deadline is a timeout (124, as timeout(1) says); a stop is not - the job was asked to end and refused to
    # die, which is 130 in the shell convention, and a caller that tells the two apart must not read a stop as a
    # job that hit its own limit
    if [ "$stopped" = 1 ]; then rc=130; else rc=124; fi
else
    wait "$child"
    rc=$?
fi
# wait reports 143 for SIGTERM; say 124 for a max hold, as timeout does
if [ "$rc" = 143 ] && [ "$(date +%s)" -ge "$deadline" ]; then rc=124; fi
# a fault abort is its own outcome (the same 78 as #2480's refusal), whatever the killed job returned
if [ -f "$FAULT_FLAG" ]; then rc=78; rm -f "$FAULT_FLAG"; fi
held=$(( $(date +%s) - started ))

# Reap the watchdog BEFORE killing anything it may be in the middle of: it is the process that runs
# kill_tree, and its TERM pass is what makes `wait "$child"` return. Killing it here (which is what this
# did) ends it inside its own grace period, so the KILL half of kill_tree never runs and a descendant that
# ignores TERM survives its ticket — exactly the orphans this was written to stop.
# Wait for the watchdog to finish rather than killing it: it is the process that runs kill_tree, its TERM
# pass is what made `wait "$child"` return, and a kill here lands inside its grace period and cancels the
# KILL pass — which is exactly how a descendant that ignores TERM outlived its ticket. It returns on its
# own as soon as the command is gone (see watch()), so a normal hold pays nothing for this.
i=0
while kill -0 "$watchdog" 2> /dev/null && [ "$i" -lt "${GPU_HOLD_WATCHDOG_WAIT:-$(( ${GPU_HOLD_KILL_GRACE:-10} + 5 ))}" ]; do
    sleep 1
    i=$((i + 1))
done
kill "$watchdog" 2> /dev/null
wait "$watchdog" 2> /dev/null
# And end whatever is left from here too, so the promise does not depend on a helper having outlived its parent.
kill_tree "$child"
# ...and the part of the tree that left the tree: a process still carrying this ticket's GPU_HOLD_TICKET is work this
# hold started, wherever it moved itself. TERM, then KILL after the same grace the tree kill uses, then record it, so
# the next holder is warned even if the KILL somehow failed.
escaped=$(env_survivors "$mine")
if [ "${ENV_UNREADABLE:-0}" -gt 0 ]; then
    log "::warning::${ENV_UNREADABLE} process(es) could not be inspected at teardown (their environment is not readable by this user), so an escapee among them would not be seen here; the tree kill above is the only guard that covers them"
fi
if [ -n "$escaped" ]; then
    log "::warning::$(printf '%s' "$escaped" | tr '\n' ' ') escaped the ticket's process tree but still carry this ticket's GPU_HOLD_TICKET - ending them (engine#2741)"
    for p in $escaped; do kill -TERM "$p" 2> /dev/null; done
    i=0
    while [ "$i" -lt "${GPU_HOLD_KILL_GRACE:-10}" ] && kill -0 $escaped 2> /dev/null; do
        sleep 1
        i=$((i + 1))
    done
    for p in $escaped; do
        kill -0 "$p" 2> /dev/null || continue
        kill -KILL "$p" 2> /dev/null
        {
            printf 'pid=%s start=%s cmd=%s\n' "$p" \
                "$(ps -o lstart= -p "$p" 2> /dev/null | sed 's/^ *//' || printf unknown)" \
                "$(tr '\0' ' ' < "/proc/$p/cmdline" 2> /dev/null | cut -c1-120 || printf unknown)"
        } >> "$SURVIVORS" 2> /dev/null || true
    done
fi
if [ "$rc" = 124 ]; then
    # engine#2542, measured on the NPU: a ticket cut short by the max hold was followed 8m29s later -- with nothing
    # running -- by `Unsupported op 18` and an IO_PAGE_FAULT burst, and the two other bursts of that boot sat 3m26s
    # and 1m36s after other releases. Fault lines can therefore be the PREVIOUS ticket's deferred work, and the next
    # lane's take-time refusal (#2498) must not read as the next lane's fault. One clause here is what tells them apart.
    log "command exited 124 after ${held}s (the max hold cut it short: the device can still be finishing deferred work, so fault lines may appear AFTER this release)"
else
    log "command exited $rc after ${held}s"
fi
release
exit "$rc"
