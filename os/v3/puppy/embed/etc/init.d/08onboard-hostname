# /etc/init.d/08onboard-hostname - the appliance's name is file://etc/hostname, not the DHCP server's opinion.
#
# Cycle 17 item 3. The cycle-16 board came up as `strix` while /etc/hostname in the frozen image says 1bit-os.
# rc.sysinit does `hostname -F /etc/hostname` and only rewrites a stock puppypc*, and no udhcpc/dhcpcd hook exists
# in this image - but connman (Puppy's network service, the only DHCP client on the box) updates the system
# hostname from whatever the DHCP server sends unless main.conf says otherwise: AllowHostnameUpdates defaults to
# true (main.conf(5)). That is the one path by which a name nobody typed can become the appliance's name, so it
# is turned off here, before connman starts (rc.services runs /etc/init.d in glob order, and 08 sorts before
# 'connman'). Menu item 3 (Network -> Set the hostname) still changes it for the session, and /etc/hostname is
# what the next boot reads.
CONF=/etc/connman/main.conf

case ${1:-start} in
start)
    [ -f "$CONF" ] || { echo "08onboard-hostname: no $CONF, nothing to pin" >&2; exit 0; }
    grep -qx 'AllowHostnameUpdates = false' "$CONF" && exit 0
    if grep -q '^[#[:space:]]*AllowHostnameUpdates' "$CONF"; then
        sed -i 's|^[#[:space:]]*AllowHostnameUpdates.*|AllowHostnameUpdates = false|' "$CONF"
    else
        printf '\n[General]\nAllowHostnameUpdates = false\n' >> "$CONF"
    fi
    grep -qx 'AllowHostnameUpdates = false' "$CONF" || {
        echo "08onboard-hostname: could not pin AllowHostnameUpdates in $CONF" >&2; exit 1; }
    echo "08onboard-hostname: the DHCP server cannot rename this appliance (AllowHostnameUpdates = false)"
    ;;
*) : ;;
esac
