# gpu-hold [-t MINUTES] [-l LABEL] [-w WAIT_SECONDS] [-q QUEUE_DIR] [--] CMD [ARGS...]
#
# Runs one GPU job under a fair FIFO claim on the box's ~/GPU-TOKEN, so agents stop racing for it. The token
# file stays compatible with everything that predates this script: it is still one file whose content names
# its holder, and a holder that knows nothing about the queue simply makes everyone wait.
#
# What one invocation does:
#   1. writes a ticket ~/GPU-QUEUE/<epoch-ns>.<label> (pid and command go inside the ticket), so queue order is
#      file-name order: the oldest ticket runs first, whoever arrived first;
#   2. creates ~/GPU-TOKEN only when its ticket is the oldest live ticket AND the token is absent AND the die is
#      at or below the start gate, writing its label into the token;
#   3. runs CMD under that hold, with a max-hold timeout (default 14 minutes) and a watchdog that aborts it at
#      the critical temperature;
#   4. always releases the token and removes its ticket, however it exits (trap on EXIT/INT/TERM/HUP);
#   5. drops tickets, and tokens, whose owner process is gone, so a killed agent cannot block the queue;
#   6. makes a label that has just released wait RELEASE_WAIT seconds (default 180) before it holds again;
#   7. releases the token even when the payload's ROOT survives the KILL pass (a process in uninterruptible sleep
#      cannot be killed), recording the pid, its start time and its command beside the ticket so the next holder
#      is told rather than left to measure on a device that may still hold that process's memory.
#
# Options and environment (all optional):
#   -t MINUTES     max hold, default $GPU_HOLD_MINUTES or 14        (0.05 = 3 seconds)
#   -l LABEL       label written into the token, default "<command name>-$$"
#   -w SECONDS     how long to queue before giving up, default $GPU_HOLD_WAIT or 5400; exit 75 on timeout
#   -q DIR         queue directory, default $GPU_QUEUE_DIR, else the fleet's queue when it exists
#                  ($ONEBIT_HOLD_DIR/gpu-queue, /var/lib/1bit-fleet by default), else ~/GPU-QUEUE
#   GPU_TOKEN_FILE         the token file, same order of preference, else ~/GPU-TOKEN
#   ONEBIT_HOLD_DIR        where the fleet's hold state lives (engine #1504); when that directory exists it IS
#                  the queue for every caller, whoever runs: a runner under another account, a tmux lane, a
#                  systemd --user service. Without it a second account silently takes its own token and runs
#                  GPU work beside the fleet, and with it a lane that never sourced a profile file still
#                  agrees, because the default - not an environment variable - is what moved.
#   GPU_HOLD_RELEASE_WAIT  seconds a label must wait after releasing, default 180
#   GPU_HOLD_TCTL_START    start gate in C, default 75 - a hot box is not taken
#   GPU_HOLD_TCTL_ABORT    abort in C, default 93
#   GPU_HOLD_MEM_ABORT_GB  end the hold when MemAvailable falls below this (GB); 0 = off, the default
#   GPU_HOLD_TCTL_FILE     temperature file in millidegrees, default the k10temp hwmon
#   GPU_HOLD_POLL          queue poll interval in seconds, default 2
#   GPU_HOLD_LOG           also append the protocol log to this file
#   GPU_HOLD_IGNORE_THERMAL_HOLD=1  start even while strixhalo-thermal-guard's ~/THERMAL-HOLD is up
#   GPU_HOLD_COOLDOWN      seconds the WHOLE queue waits after a hold that ended at or above
#                          GPU_HOLD_COOLDOWN_TCTL, whatever its label; default 180, 0 disables the cool-down
#   GPU_HOLD_COOLDOWN_TCTL die temperature at release that counts as "ended hot", default 85
#
# Exit status is the command's, or 124 when the max hold cut it short, 75 when the queue never came round.
set -u

MINUTES=${GPU_HOLD_MINUTES:-14}
LABEL=""
WAIT=${GPU_HOLD_WAIT:-5400}
HOLD=${ONEBIT_HOLD_DIR:-/var/lib/1bit-fleet}
# the fleet's state wins when it is installed, and ~ is the fallback for a box that has not been set up that way
QUEUE=${GPU_QUEUE_DIR:-$([ -d "$HOLD/gpu-queue" ] && printf '%s' "$HOLD/gpu-queue" || printf '%s' "$HOME/GPU-QUEUE")}
TOKEN=${GPU_TOKEN_FILE:-$([ -d "$HOLD" ] && printf '%s' "$HOLD/gpu-token" || printf '%s' "$HOME/GPU-TOKEN")}
RELEASE_WAIT=${GPU_HOLD_RELEASE_WAIT:-180}
TCTL_START=${GPU_HOLD_TCTL_START:-75}
TCTL_ABORT=${GPU_HOLD_TCTL_ABORT:-93}
# End the hold when MemAvailable falls below this many GB (0 keeps the old behaviour). Set by the caller, not
# defaulted: a box with a large model legitimately sits low, and the floor that matters is the fleet's, not this'. 
# GiB, whole number. A value that is not one is refused HERE rather than reaching `[ "$x" -gt 0 ]`, where bash
# prints "integer expression expected", the test is treated as false and the floor is silently disabled.
MEM_ABORT_GB=${GPU_HOLD_MEM_ABORT_GIB:-${GPU_HOLD_MEM_ABORT_GB:-0}}
case $MEM_ABORT_GB in
    '' | *[!0-9]*)
        echo "gpu-hold: GPU_HOLD_MEM_ABORT_GB=$MEM_ABORT_GB is not a whole number of GiB - refusing to run with a floor that cannot be enforced" >&2
        exit 2
        ;;
esac
POLL=${GPU_HOLD_POLL:-2}
LOG=${GPU_HOLD_LOG:-}
THERMAL_FLAG=${GPU_HOLD_THERMAL_FLAG:-$HOME/THERMAL-HOLD}
COOLDOWN=${GPU_HOLD_COOLDOWN:-180}
COOLDOWN_TCTL=${GPU_HOLD_COOLDOWN_TCTL:-85}

while getopts ":t:l:w:q:h" opt; do
    case $opt in
        t) MINUTES=$OPTARG ;;
        l) LABEL=$OPTARG ;;
        w) WAIT=$OPTARG ;;
        q) QUEUE=$OPTARG ;;
        h) sed -n '18,58p' "$0"; exit 0 ;;
        *) echo "gpu-hold: unknown option -$OPTARG (try -h)" >&2; exit 2 ;;
    esac
done
shift $((OPTIND - 1))
[ $# -gt 0 ] || { echo "gpu-hold: no command given (try -h)" >&2; exit 2; }

tctl_file() {
    if [ -n "${GPU_HOLD_TCTL_FILE:-}" ]; then printf '%s' "$GPU_HOLD_TCTL_FILE"; return; fi
    local f
    f=$(grep -l k10temp /sys/class/hwmon/*/name 2> /dev/null | head -n 1)
    if [ -n "$f" ]; then printf '%s' "$(dirname "$f")/temp1_input"; else printf '%s' /dev/null; fi
}
TCTL_FILE=$(tctl_file)
tctl() {
    local v
    v=$(cat "$TCTL_FILE" 2> /dev/null) || v=""
    if [ -n "$v" ]; then echo $((v / 1000)); else echo 0; fi
}

log() {
    local line
    line="gpu-hold[$$] $* $(date -Is)"
    printf '%s\n' "$line" >&2
    if [ -n "$LOG" ]; then printf '%s\n' "$line" >> "$LOG"; fi
}

mkdir -p "$QUEUE" || { echo "gpu-hold: cannot create $QUEUE" >&2; exit 2; }
COOLDOWN_STAMP="$QUEUE/.cooldown"      # "<epoch> <C>" of the last hold that ended hot; shared by every label
[ -n "$LABEL" ] || LABEL="$(basename -- "$1")-$$"
SAFE=$(printf '%s' "$LABEL" | tr -c 'A-Za-z0-9_.-' '_')
TICKET="$QUEUE/$(printf '%020d' "$(date +%s%N)").$SAFE"
RELEASED_AT="$QUEUE/.released-at.$SAFE"
# a root that survived KILL is recorded here, beside the ticket, so the NEXT holder is told: the log line alone
# scrolls away with the ticket, and the next lane then measures on a device that may still hold the wedged
# process's GTT - which is the 2026-11-08 incident (a 14 h llama-server holding 51 GiB that nobody knew about
# until the PR agent died). engine #1639.
SURVIVORS="$QUEUE/.gpu-hold-survivors"
TICKET_NAME=$(basename "$TICKET")

state=queued
mine=""
child=""
watchdog=""

# A hold that ends hot leaves the box soaked: the next claim, whatever its label, would start on hot air and climb
# straight back. cool_end stamps the queue at release; cool_left is what the next ticket waits.
cool_end() {
    local t
    [ "$COOLDOWN" -gt 0 ] || return 0
    t=$(tctl)
    [ "$t" -ge "$COOLDOWN_TCTL" ] || return 0
    printf '%s %s\n' "$(date +%s)" "$t" > "$COOLDOWN_STAMP"
    log "ended at ${t}C: no new claim starts for ${COOLDOWN}s (any label)"
}
cool_left() {
    local stamp now
    [ "$COOLDOWN" -gt 0 ] && [ -f "$COOLDOWN_STAMP" ] || { echo 0; return; }
    stamp=$(sed -n '1s/ .*//p' "$COOLDOWN_STAMP" 2> /dev/null)
    case $stamp in '' | *[!0-9]*) echo 0; return ;; esac
    now=$(date +%s)
    if [ $((now - stamp)) -lt "$COOLDOWN" ]; then echo $((COOLDOWN - now + stamp)); else echo 0; fi
}

release() {
    if [ "$state" = holding ] && [ -n "$mine" ] && [ "$(cat "$TOKEN" 2> /dev/null)" = "$mine" ]; then
        cool_end
        rm -f "$TOKEN"
        date +%s > "$RELEASED_AT"
        log "released $TOKEN"
    fi
    if [ "$state" != done ]; then rm -f "$TICKET"; fi
    state=done
}
trap release EXIT
# TERM/INT/HUP must END THE PAYLOAD before the token comes back. `exit 143` alone ran only the EXIT trap: the token was
# released and the ticket removed while the payload kept the device, so the next lane was admitted on top of it (the
# 11-08 orphan, reached through a different door: `timeout`, an operator kill, an orchestrator stopping a lane). Its
# tree is ended with the same kill_tree the watchdog uses, so a process two levels down cannot survive the signal
# either. `child` is empty while queued, so a signal in the queue still just leaves the queue; `declare -F` covers the
# one window where the payload has started but the function is not defined yet.
trap '[ -n "${child:-}" ] && declare -F kill_tree > /dev/null && kill_tree "$child"; exit 143' TERM INT HUP

pid_of() { sed -n 's/^pid=\([0-9][0-9]*\).*/\1/p' "$1" 2> /dev/null | head -n 1; }

stale() {
    local pid
    pid=$(pid_of "$1")
    if [ -z "$pid" ]; then return 0; fi          # unreadable or half-written: stale
    kill -0 "$pid" 2> /dev/null && return 1
    return 0
}

oldest_ticket() {
    local f pid
    for f in $(ls -1 "$QUEUE" 2> /dev/null | grep -v '^\.' | sort); do
        [ -f "$QUEUE/$f" ] || continue
        if stale "$QUEUE/$f"; then
            # engine #1635: the owner of this ticket is still polling, so dropping it silently left it waiting for a
            # queue position that no longer existed. Leave a note in the queue directory (dotfiles are never treated
            # as tickets) so the victim can say WHY its ticket vanished, not only that it did.
            pid=$(pid_of "$QUEUE/$f")
            # One file per ticket, not one shared log: the victim reads its own note and removes it, so the queue
            # directory cannot accumulate notes for the life of the box (review note on PR #1636).
            printf '%s dropped %s: owner pid %s is gone (dropped by pid %s)\n' \
                "$(date -Is)" "$f" "${pid:-unknown}" "$$" > "$QUEUE/.reaped.$f" 2> /dev/null
            rm -f "$QUEUE/$f"
            log "dropped stale ticket $f (owner pid gone)"
            continue
        fi
        printf '%s' "$f"
        return
    done
}

# A token left behind by a killed holder blocks everyone, so reap it too - but only when it is clearly ours to
# read (a "gpu-hold ..." line with a pid). Anything else is left alone: it belongs to a wrapper this script
# does not know.
reap_token() {
    [ -e "$TOKEN" ] || return 0
    local content pid
    content=$(cat "$TOKEN" 2> /dev/null) || return 0
    case $content in gpu-hold*) ;; *) return 0 ;; esac
    pid=$(printf '%s' "$content" | sed -n 's/.* pid \([0-9][0-9]*\) .*/\1/p' | head -n 1)
    if [ -n "$pid" ] && ! kill -0 "$pid" 2> /dev/null; then
        rm -f "$TOKEN"
        log "dropped stale token (holder pid $pid gone): $content"
    fi
}

printf 'pid=%s\nlabel=%s\ncmd=%s\nenqueued=%s\n' "$$" "$LABEL" "$*" "$(date -Is)" > "$TICKET" ||
    { echo "gpu-hold: cannot write $TICKET" >&2; exit 2; }
log "queued '$LABEL' as $TICKET_NAME"

waited=0
while [ "$state" = queued ]; do
    if [ ! -e "$TICKET" ]; then
        # engine #1635: something (a reaper, another lane) removed a queued ticket. The head-of-queue test below
        # can then never come true, and the wait would run to -w (5400 s by default) looking exactly like "queued
        # behind a busy box". Fail in this poll instead, and name what went missing. state=done first so the
        # release() trap does not touch a token this process never took.
        why=$(cat "$QUEUE/.reaped.$TICKET_NAME" 2> /dev/null | tail -n 1)
        rm -f "$QUEUE/.reaped.$TICKET_NAME" 2> /dev/null
        log "::error::my ticket $TICKET_NAME is gone from $QUEUE after ${waited}s (token: $(cat "$TOKEN" 2> /dev/null || echo free)) - it was reaped or removed, so this queue position no longer exists; not waiting ${WAIT}s for it${why:+ [$why]}"
        state=done
        exit 75
    fi
    reap_token
    cool=$(cool_left)
    head_ticket=$(oldest_ticket)
    if [ "$head_ticket" = "$TICKET_NAME" ]; then
        if [ -e "$TOKEN" ]; then
            if [ "$waited" = 0 ]; then
                log "first in the queue, waiting for $TOKEN (held by: $(cat "$TOKEN" 2> /dev/null || echo '?'))"
            fi
        elif [ "$(tctl)" -ge "$TCTL_START" ]; then
            if [ "$waited" = 0 ]; then
                log "first in the queue, holding off: die at $(tctl)C, start gate ${TCTL_START}C"
            fi
        elif [ -e "$THERMAL_FLAG" ] && [ "${GPU_HOLD_IGNORE_THERMAL_HOLD:-0}" != 1 ] &&
             kill -0 "$(head -n 1 "$THERMAL_FLAG" 2> /dev/null)" 2> /dev/null; then
            # strixhalo-thermal-guard has the box hot and the compilers paused: a new claim would only add heat.
            if [ "$waited" = 0 ]; then
                log "first in the queue, holding off: $(head -n 2 "$THERMAL_FLAG" | paste -sd' ') is up"
            fi
        elif [ -f "$RELEASED_AT" ] &&
             [ $(( $(date +%s) - $(cat "$RELEASED_AT" 2> /dev/null || echo 0) )) -lt "$RELEASE_WAIT" ]; then
            if [ "$waited" = 0 ]; then
                log "first in the queue, releasing label waits ${RELEASE_WAIT}s after its last hold"
            fi
        elif [ "$cool" -gt 0 ]; then
            if [ "$waited" = 0 ] || [ $((waited % 60)) = 0 ]; then
                log "first in the queue, cooling down after a hot hold (${cool}s to go, then any label may start)"
            fi
        else
            mine="gpu-hold $LABEL pid $$ $(date -Is)"
            if ( set -o noclobber; printf '%s\n' "$mine" > "$TOKEN" ) 2> /dev/null; then
                state=holding
                log "took $TOKEN after ${waited}s (die $(tctl)C)"
                # the previous holder left a process the kernel would not kill: say so before this lane measures
                if [ -s "$SURVIVORS" ]; then
                    log "::warning::previous holder left $(tr '\n' ';' < "$SURVIVORS") - that device may still hold its memory (engine #1639)"
                    : > "$SURVIVORS"
                fi
                break
            fi
        fi
    fi
    if [ "$waited" -ge "$WAIT" ]; then
        log "::error::queue never came round after ${WAIT}s (head: ${head_ticket:-none}, token: $(cat "$TOKEN" 2> /dev/null || echo free))"
        rm -f "$TICKET"
        state=done
        exit 75
    fi
    sleep "$POLL"
    waited=$((waited + POLL))
done

deadline=$(( $(date +%s) + $(awk -v m="$MINUTES" 'BEGIN { printf "%d", m * 60 }') ))
started=$(date +%s)
# Defined BEFORE the payload starts, on purpose: the signal trap calls kill_tree, and a TERM landing between
# `child=$!` and the definition runs the trap with the payload started and the helper undefined -- `declare -F`
# then skips the kill, so the token is released and the payload survives, which is the leak this order removes
# (engine#1640; #1642 landed the guard, this is the ordering that makes it always true).
descendants() {   # <pid> -> its descendants and then itself, deepest last
    local k
    for k in $(ps -o pid= --ppid "$1" 2> /dev/null); do
        descendants "$k"
    done
    printf '%s\n' "$1"
}
kill_tree() {
    local root=$1 grace=${2:-10} i=0 p
    # Snapshot ONCE, before any signal. Re-walking after TERM loses exactly the processes this pass exists for: a
    # process that ignores TERM is the one still alive when the second walk runs, and if its own parent exited during
    # the grace period it has been reparented (to init or a subreaper), so `ps --ppid "$root"` no longer links it to the
    # ticket. The KILL pass then cannot see it and the orphan survives the hold -- which is the failure this function was
    # written to end. A snapshot also fixes the grace period: `kill -0` with a pid list is true while ANY of them lives,
    # so a wrapper that exits promptly no longer denies its children the grace they were promised.
    local tree; tree=$(descendants "$root")
    for p in $tree; do kill -TERM "$p" 2> /dev/null; done
    while kill -0 $tree 2> /dev/null && [ "$i" -lt "$grace" ]; do
        sleep 1
        i=$((i + 1))
    done
    for p in $tree; do kill -KILL "$p" 2> /dev/null; done
}
"$@" &
child=$!
# The watchdog is a function so it can be given the command's pid: a subshell inherits a copy of the shell's
# variables, so a watchdog started before the command (the first version did) holds an empty pid and neither
# the abort nor the max hold stops anything.
# End the hold's whole DESCENDANT TREE: TERM first so a runner can clean up after itself (thermal-run's
# scope, a benchmark's teardown), then KILL after a grace period for anything that ignored it. Walking
# `ps --ppid` is depth-agnostic; `pkill -P` reached only the first level, which is why three orphans
# survived their tickets on 2026-11-08/09 — in each one the process holding the memory was two or three
# levels down (ticket → shell → runner → server). A process group would express this too, but `setsid`
# forks when it is already a group leader (which it is inside `systemd-run --scope`), so `$!` stops
# naming the group; recursion has no such trap.


# MemAvailable, in GB, as the kernel reports it. 0 disables the abort (the old behaviour).
mem_available_gb() {
    # first match only: a fixture that adds a second MemAvailable line would otherwise concatenate both numbers
    awk '/^MemAvailable:/ { printf "%d", $2 / 1048576; exit }' "${GPU_HOLD_MEMINFO:-/proc/meminfo}" 2> /dev/null
}

watch() {
    local target=$1
    while sleep 2; do
        # The OOM kill this prevents is not the run's own: on 2026-11-08/09 a GPU run took the box to 0.7 GiB
        # available and the kernel chose the PR-agent LLM as the victim, which took the fleet's own brains down.
        # The temperature gate has the same shape — one sampled number, one threshold, end the hold — so the
        # memory floor rides the same watchdog rather than adding a second one.
        if [ "${MEM_ABORT_GB:-0}" -gt 0 ]; then
            avail=$(mem_available_gb)
            if [ -n "$avail" ] && [ "$avail" -lt "$MEM_ABORT_GB" ]; then
                log "ABORT ${avail} GiB MemAvailable (floor ${MEM_ABORT_GB} GiB) - ending the hold before the kernel picks a victim"
                kill_tree "$target" "${GPU_HOLD_KILL_GRACE:-10}"
                return
            fi
        fi
        t=$(tctl)
        if [ "$t" -ge "$TCTL_ABORT" ]; then
            log "ABORT die at ${t}C (limit ${TCTL_ABORT}C)"
            kill_tree "$target" "${GPU_HOLD_KILL_GRACE:-10}"
            return
        fi
        if [ "$(date +%s)" -ge "$deadline" ]; then
            log "max hold of ${MINUTES} min reached"
            kill_tree "$target" "${GPU_HOLD_KILL_GRACE:-10}"
            return
        fi
        # the command is gone: nothing left to guard. This is also what lets the caller simply WAIT for this
        # shell instead of killing it — a kill here would land inside kill_tree's grace period and cancel the
        # KILL pass, which is how a TERM-ignoring descendant survived its ticket.
        kill -0 "$target" 2> /dev/null || return
    done
}
watch "$child" &
watchdog=$!

# A payload ROOT that survives the KILL pass holds this token for ever: a process wedged in uninterruptible
# sleep cannot be killed by SIGKILL, and every other lane then sits in the FIFO behind a job that cannot die.
# Bound the wait and release anyway - a wedged job costs one lane's measurement, not the queue (engine #1639;
# the deployed copy on strixhalo has had this bound since 2026-11-06, and this is it brought back to the repo).
# GPU_HOLD_KILL_GRACE is the TERM->KILL window; GPU_HOLD_SURVIVE_WAIT is the settle time after it.
#
# This bound is COMPLEMENTARY to the bounded wait for the watchdog that #1626 landed further down: with a
# survived root the watchdog keeps polling `kill -0 "$target"` and will not exit on its own, so before #1626 this
# script would have hung in that wait instead. A future reader rebasing one of the two should see that the other
# is what makes the token actually reach `release`.
survive_by=$(( ${GPU_HOLD_KILL_GRACE:-10} + ${GPU_HOLD_SURVIVE_WAIT:-60} ))
stopped=0
while kill -0 "$child" 2> /dev/null; do
    # 0.2 s, not 1 s: the poll is on the way to `wait`, so a coarse sleep makes every hold pay up to a second and
    # the ticket log's "after Ns" steps up by one for fast payloads (a review finding). The bound itself is in
    # whole seconds, so the granularity only costs response time.
    sleep 0.2
    base=$deadline
    if [ -n "${STOP_STAMP:-}" ] && [ -f "$STOP_STAMP" ]; then
        base=$(cat "$STOP_STAMP" 2> /dev/null || printf '%s' "$deadline")
        stopped=1
    fi
    [ "$(date +%s)" -ge $(( base + survive_by )) ] && break
done
if kill -0 "$child" 2> /dev/null; then
    log "::error::child $child survived KILL: releasing the token anyway (a wedged job costs one lane's measurement, not the queue)"
    # durable, not just in a log that scrolls away: the next acquire prints this
    {
        printf 'pid=%s start=%s cmd=%s\n' "$child" \
            "$(ps -o lstart= -p "$child" 2> /dev/null | sed 's/^ *//' || printf unknown)" \
            "$(tr '\0' ' ' < "/proc/$child/cmdline" 2> /dev/null | cut -c1-120 || printf unknown)"
    } >> "$SURVIVORS" 2> /dev/null || true
    # a deadline is a timeout (124, as timeout(1) says); a stop is not - the job was asked to end and refused to
    # die, which is 130 in the shell convention, and a caller that tells the two apart must not read a stop as a
    # job that hit its own limit
    if [ "$stopped" = 1 ]; then rc=130; else rc=124; fi
else
    wait "$child"
    rc=$?
fi
# wait reports 143 for SIGTERM; say 124 for a max hold, as timeout does
if [ "$rc" = 143 ] && [ "$(date +%s)" -ge "$deadline" ]; then rc=124; fi
held=$(( $(date +%s) - started ))

# Reap the watchdog BEFORE killing anything it may be in the middle of: it is the process that runs
# kill_tree, and its TERM pass is what makes `wait "$child"` return. Killing it here (which is what this
# did) ends it inside its own grace period, so the KILL half of kill_tree never runs and a descendant that
# ignores TERM survives its ticket — exactly the orphans this was written to stop.
# Wait for the watchdog to finish rather than killing it: it is the process that runs kill_tree, its TERM
# pass is what made `wait "$child"` return, and a kill here lands inside its grace period and cancels the
# KILL pass — which is exactly how a descendant that ignores TERM outlived its ticket. It returns on its
# own as soon as the command is gone (see watch()), so a normal hold pays nothing for this.
i=0
while kill -0 "$watchdog" 2> /dev/null && [ "$i" -lt "${GPU_HOLD_WATCHDOG_WAIT:-$(( ${GPU_HOLD_KILL_GRACE:-10} + 5 ))}" ]; do
    sleep 1
    i=$((i + 1))
done
kill "$watchdog" 2> /dev/null
wait "$watchdog" 2> /dev/null
# And end whatever is left from here too, so the promise does not depend on a helper having outlived its parent.
kill_tree "$child"
log "command exited $rc after ${held}s"
release
exit "$rc"
