+                         "probe_class=%s copy_class=%s hashes_equal=%d probe_nf16=%llu probe_nf32=%llu "
+                         "copy_nf16=%llu copy_nf32=%llu\n",
+                         size, offset, static_cast<unsigned long long>(probe.hash),
+                         static_cast<unsigned long long>(copy.hash),
+                         download_fingerprint_class(probe, size), download_fingerprint_class(copy, size),
+                         probe.hash == copy.hash ? 1 : 0,
+                         static_cast<unsigned long long>(probe.nonfinite16),
+                         static_cast<unsigned long long>(probe.nonfinite32),
+                         static_cast<unsigned long long>(copy.nonfinite16),
+                         static_cast<unsigned long long>(copy.nonfinite32));
