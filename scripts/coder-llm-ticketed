# coder-llm-ticketed [--] SERVER_CMD [ARGS...]
#
# Runs the PR-Agent reviewer model (the coder-llm user service, :8090) ONLY inside a gpu-hold ticket, in on-demand
# windows (owner 2026-11-15, CODER-LLM-TICKETED; engine#2494). It used to run 24/7 outside any ticket, so "one GPU job
# at a time" never held, and the model it serves (Qwen3-Coder-30B on HRX) is the one whose prefill faults the GPU.
#
# One invocation is ONE window, and systemd's Restart= makes the next one:
#   1. wait for demand: the demand file was touched within CODER_LLM_DEMAND_TTL_MIN (the pr-agent workflow's reviewer
#      job touches it, engine#2509), or a pr-agent workflow run is queued or in progress (CODER_LLM_GH_POLL, on by
#      default as the fallback);
#   2. queue for the GPU like any other job: gpu-hold -l coder-llm -t CODER_LLM_MAX_HOLD_MIN (FIFO; gpu-hold's
#      temperature, memory and kernel-fault watchdogs apply, and its release wait lets the next label in);
#   3. inside the ticket, start SERVER_CMD and end the window once the server has been idle (no slot in /slots is
#      processing) AND the demand file has not been touched for CODER_LLM_IDLE_MIN - or when the max hold ends it;
#   4. exit, so systemd starts the next invocation, which goes back to waiting for demand and re-queues.
# A window cut short by a kernel fault (gpu-hold rc 78) or a refused ticket backs off CODER_LLM_FAULT_BACKOFF_S
# before exiting, so a faulting GPU does not turn into a restart loop.
#
# Anything else that needs the model asks for it the same way the workflow does: touch "$CODER_LLM_DEMAND" (and
# keep touching it while working), then wait for :8090 to answer.
#
# The contract this changes: `systemctl --user start coder-llm` now means QUEUED, not ":8090 answers". A window
# wrapper that restarts the unit from inside its own gpu-hold ticket and then polls :8090 is polling a server that is
# queued behind that very ticket; it answers only after the caller's ticket is released. The journal line
# "queued behind <holder>" says which state it is in.
#
# Environment (all optional):
#   CODER_LLM_DEMAND            demand file, default ~/.cache/coder-llm/demand
#   CODER_LLM_DEMAND_TTL_MIN    a touch this recent is demand, default 30 (CODER_LLM_DEMAND_TTL_S in seconds wins)
#   CODER_LLM_IDLE_MIN          idle minutes that end a window, default 5 (CODER_LLM_IDLE_S in seconds wins)
#   CODER_LLM_MAX_HOLD_MIN      max hold per window (gpu-hold -t), default 25
#   CODER_LLM_QUEUE_WAIT_S      how long one window queues for the GPU (gpu-hold -w), default 86400. Long on purpose:
#                               a ticket that gives up (rc 75) is replaced by a NEW one at the BACK of the FIFO, so a
#                               short wait on a busy box (10+ lane tickets) would lose its place every time and starve
#                               reviews; systemd's Restart= makes the wait unbounded anyway, so length only keeps place
#   CODER_LLM_URL               the server's base URL for /slots, default http://127.0.0.1:8090
#   CODER_LLM_POLL_S            poll interval, default 15
#   CODER_LLM_GH_POLL           1 (the default) = also treat a queued/in-progress pr-agent run as demand (REST,
#                               every CODER_LLM_GH_POLL_S, default 60), so a review is never starved even if nothing
#                               touched the demand file; 0 = the demand file only
#   CODER_LLM_GH_REPO           default 1bit-MONSTER/engine
#   CODER_LLM_FAULT_BACKOFF_S   back-off after gpu-hold rc 78 (a fault, or a refused ticket), default 600
#   CODER_LLM_STOP_WAIT_S       how long a stopping server gets after TERM before this KILLs it, default 30. The 30B
#                               HRX server needed more than 10 s to exit at the first live max hold (11-15 10:56Z)
#   CODER_LLM_KILL_GRACE_S      gpu-hold's TERM->KILL grace for the window (GPU_HOLD_KILL_GRACE), default STOP_WAIT+10,
#                               so the window can end its own server before gpu-hold KILLs the window; an explicit
#                               GPU_HOLD_KILL_GRACE in the environment wins
#   CODER_LLM_GPU_HOLD          gpu-hold to use, default the one on PATH
#   CODER_LLM_ALWAYS=1          skip the demand wait (a resident window, still ticketed and still max-hold bounded)
#
# Internal: "coder-llm-ticketed --window SERVER_CMD..." is what gpu-hold runs; it is the idle-aware window itself.
#
# Exit status of one invocation (the journal line after "window" says which; review of engine#2525):
#   0    the window closed idle, or a grant whose demand went stale was released without starting the server
#   124  the max hold ended the window: gpu-hold's deadline, including a window gpu-hold had to KILL after the deadline
#        (a 137 once the window has been open for the max hold, timed from the window's own start). Planned, not a crash
#   130  a stop was requested (gpu-hold's stop stamp) and the window refused to die; gpu-hold released the token anyway
#   137  something KILLed the window or the server BEFORE the max hold (the OOM killer, a manual kill -9): a failure
#   78   gpu-hold ended the hold on a GPU/NPU fault in the kernel log, or refused the ticket; backed off before exiting
#   75   the queue never came round within CODER_LLM_QUEUE_WAIT_S
#   any other: the server's own exit status (it exited by itself)
set -u

DEMAND=${CODER_LLM_DEMAND:-$HOME/.cache/coder-llm/demand}
DEMAND_TTL=${CODER_LLM_DEMAND_TTL_S:-$(( ${CODER_LLM_DEMAND_TTL_MIN:-30} * 60 ))}
IDLE=${CODER_LLM_IDLE_S:-$(( ${CODER_LLM_IDLE_MIN:-5} * 60 ))}
MAX_HOLD=${CODER_LLM_MAX_HOLD_MIN:-25}
QUEUE_WAIT=${CODER_LLM_QUEUE_WAIT_S:-86400}
URL=${CODER_LLM_URL:-http://127.0.0.1:8090}
POLL=${CODER_LLM_POLL_S:-15}
GH_POLL=${CODER_LLM_GH_POLL:-1}
GH_POLL_S=${CODER_LLM_GH_POLL_S:-60}
GH_REPO=${CODER_LLM_GH_REPO:-1bit-MONSTER/engine}
BACKOFF=${CODER_LLM_FAULT_BACKOFF_S:-600}
STOP_WAIT=${CODER_LLM_STOP_WAIT_S:-30}
KILL_GRACE=${GPU_HOLD_KILL_GRACE:-${CODER_LLM_KILL_GRACE_S:-$(( STOP_WAIT + 10 ))}}
GPU_HOLD=${CODER_LLM_GPU_HOLD:-gpu-hold}

log() { echo "coder-llm-ticketed[$$] $*"; }

mtime() { stat -c %Y "$1" 2> /dev/null || echo 0; }

demand_fresh() {   # $1 = window in seconds
    [ $(( $(date +%s) - $(mtime "$DEMAND") )) -lt "$1" ]
}

# Only pull_request runs count: every comment on a PR also creates a pr-agent run (about one every two minutes on a
# busy night) and most never review, so counting them would keep a 30B window open on chatter. Command comments
# (/review, /ask ...) reach the model through the demand file the workflow's reviewer job touches (engine#2509).
GH_FAIL_LOGGED=0
gh_demand() {
    [ "$GH_POLL" = 1 ] || return 1
    local s n err errf="${TMPDIR:-/tmp}/coder-llm-gh.$$"
    for s in queued in_progress; do
        n=$(gh api "repos/$GH_REPO/actions/workflows/pr-agent.yml/runs?status=$s&event=pull_request&per_page=1" \
                -q .total_count 2> "$errf")
        if [ $? -ne 0 ] || ! [ "$n" -ge 0 ] 2> /dev/null; then
            # an absent answer is not "no demand": say why, once per wait (the behaviour stays "no demand", the safe side)
            err=$(head -c 200 "$errf" 2> /dev/null | tr '\n' ' ')
            [ "$GH_FAIL_LOGGED" = 1 ] || log "gh poll failed (${err:-answer '$n'}): treating it as no demand; check with: gh api repos/$GH_REPO/actions/workflows/pr-agent.yml/runs"
            GH_FAIL_LOGGED=1
            rm -f "$errf"
            return 1
        fi
        rm -f "$errf"
        [ "$n" -gt 0 ] && return 0
    done
    return 1
}

slots_busy() {   # 0 = some slot is processing, or the server cannot say (not up yet counts as busy)
    local j
    j=$(curl -sf --max-time 5 "$URL/slots" 2> /dev/null) || return 0
    grep -Eq '"is_processing"[[:space:]]*:[[:space:]]*true' <<< "$j" && return 0
    return 1
}

# ---- the window: runs INSIDE the gpu-hold ticket --------------------------------------------------------------------
if [ "${1:-}" = "--window" ]; then
    shift
    [ "${1:-}" = "--" ] && shift
    [ $# -gt 0 ] || { log "--window needs a server command"; exit 2; }
    # a ticket granted after its demand went stale (a long queue) releases at once instead of loading a 30B model and
    # idling for IDLE seconds: on a deep queue that is a load per stale entry, about an hour of GPU (review of #2514)
    if [ "${CODER_LLM_ALWAYS:-0}" != 1 ] && ! demand_fresh "$DEMAND_TTL" && ! gh_demand; then
        log "ticket granted with no fresh demand: releasing without starting the server"
        exit 0
    fi
    [ -n "${CODER_LLM_WINDOW_STAMP:-}" ] && date +%s > "$CODER_LLM_WINDOW_STAMP"
    "$@" &
    server=$!
    stop_server() {   # logs how long the teardown took: the number that says how close the next one is to the grace
        local t0 n
        t0=$(date +%s)
        kill -TERM "$server" 2> /dev/null
        for n in $(seq 1 "$STOP_WAIT"); do
            kill -0 "$server" 2> /dev/null || { log "server stopped in $(( $(date +%s) - t0 ))s after TERM (stop wait ${STOP_WAIT}s)"; return; }
            sleep 1
        done
        kill -KILL "$server" 2> /dev/null
        log "server did not stop in ${STOP_WAIT}s after TERM: KILLed (raise CODER_LLM_STOP_WAIT_S)"
    }
    trap 'stop_server; exit 143' TERM INT HUP
    log "window open: server pid $server"
    last_busy=$(date +%s)
    while kill -0 "$server" 2> /dev/null; do
        sleep "$POLL"
        now=$(date +%s)
        if slots_busy || demand_fresh "$IDLE"; then
            last_busy=$now
        elif [ $(( now - last_busy )) -ge "$IDLE" ]; then
            log "idle ${IDLE}s and no fresh demand: closing the window"
            stop_server
            exit 0
        fi
    done
    wait "$server"
    rc=$?
    log "server exited by itself, rc $rc"
    exit "$rc"
fi

# ---- one service invocation: wait for demand, then one ticketed window ----------------------------------------------
[ "${1:-}" = "--" ] && shift
[ $# -gt 0 ] || { echo "usage: coder-llm-ticketed [--] SERVER_CMD [ARGS...]" >&2; exit 2; }
mkdir -p "$(dirname "$DEMAND")"

if [ "${CODER_LLM_ALWAYS:-0}" != 1 ]; then
    log "waiting for demand ($DEMAND touched within ${DEMAND_TTL}s$([ "$GH_POLL" = 1 ] && echo ", or a pr-agent pull_request run on $GH_REPO"))"
    if [ "$GH_POLL" = 1 ] && ! gh auth status > /dev/null 2>&1; then
        log "WARNING: gh is not logged in, so the pr-agent-run fallback cannot see demand; only the demand file will wake the model"
    fi
    next_gh=0
    while :; do
        demand_fresh "$DEMAND_TTL" && break
        if [ "$GH_POLL" = 1 ] && [ "$(date +%s)" -ge "$next_gh" ]; then
            gh_demand && { touch "$DEMAND"; break; }
            next_gh=$(( $(date +%s) + GH_POLL_S ))
        fi
        sleep "$POLL"
    done
fi
holder=$(head -c 120 "${GPU_TOKEN_FILE:-$HOME/GPU-TOKEN}" 2> /dev/null | head -1)
# an explicit GPU_HOLD_KILL_GRACE wins, so it can undo the nesting (gpu-hold KILLing the window while the server is still
# inside its stop wait): say so, do not override the operator's choice
[ "$KILL_GRACE" -ge $(( STOP_WAIT + 5 )) ] 2> /dev/null \
    || log "WARNING: the kill grace ${KILL_GRACE}s is not at least 5 s longer than CODER_LLM_STOP_WAIT_S=${STOP_WAIT}s: gpu-hold will KILL the window before the server can exit"
log "demand: queueing for the GPU (gpu-hold -l coder-llm -t $MAX_HOLD -w $QUEUE_WAIT)${holder:+; queued behind $holder}"
# gpu-hold's default 10 s grace KILLed the window at the first live max hold while the server was still exiting:
# rc 137 and an unclean stop instead of 124 (11-15 10:56Z)
export CODER_LLM_WINDOW_STAMP="${TMPDIR:-/tmp}/coder-llm-window.$$"
rm -f "$CODER_LLM_WINDOW_STAMP"
GPU_HOLD_KILL_GRACE=$KILL_GRACE "$GPU_HOLD" -t "$MAX_HOLD" -l coder-llm -w "$QUEUE_WAIT" -- "$0" --window "$@"
rc=$?
# a KILL once the window has been open for the max hold is still the max hold (as 143 is, which gpu-hold maps to
# 124); timed from the window's own start, so a long queue wait followed by some other KILL is not relabelled
opened=$(cat "$CODER_LLM_WINDOW_STAMP" 2> /dev/null); rm -f "$CODER_LLM_WINDOW_STAMP"
if [ "$rc" = 137 ] && [ -n "$opened" ] && awk -v e=$(( $(date +%s) - opened )) -v m="$MAX_HOLD" 'BEGIN { exit !(e >= m * 60) }'; then
    log "the window was KILLed after the max hold (rc 137; raise CODER_LLM_STOP_WAIT_S if the server needs longer to exit)"
    rc=124
fi
case "$rc" in
    0)   log "window closed (idle)" ;;
    124) log "window closed (max hold ${MAX_HOLD} min); re-queueing" ;;
    130) log "window stop requested and refused; gpu-hold released the token anyway" ;;
    137) log "window KILLed before its max hold (rc 137: the OOM killer or a kill -9, not a planned close)" ;;
    75)  log "the queue never came round in ${QUEUE_WAIT}s" ;;
    78)  log "gpu-hold rc 78 (a GPU fault in the kernel log, or a refused ticket): backing off ${BACKOFF}s"; sleep "$BACKOFF" ;;
    *)   log "window ended rc $rc" ;;
esac
exit "$rc"
