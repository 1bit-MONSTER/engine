# 1bit-logs - keep the boot's evidence on the 1BIT-DATA partition, not in RAM.
#
# Cycle 16's board boot lost the only log that could have explained a failure: the desktop session's dmesg and
# Xorg log lived in /tmp and the next power-on erased them (C17 item 1/2). So every boot writes to
# /data/logs/<boot-id>/ and the last five boots are kept:
#
#   dmesg.log                the kernel ring, appended as it grows (a wrap is marked, not silently re-copied)
#   messages.log             /var/log/messages
#   xorg.log                 /var/log/Xorg.0.log (only exists once X has run)
#   xerrs.log                /tmp/xerrs.log, xwin's own capture of the X server
#   lemond.log               /var/log/lemond-onebit.log
#   webapp.log               /var/log/1bit-webapp.log
#   thermal.log              Tctl / fan rpm / package W every 10 s, but ONLY while a model is loaded (cycle 25)
#   BOOT                     date, kernel command line, uptime, release - what machine and entry this was
#
# Usage:
#   1bit-logs dir            print (and create) this boot's directory
#   1bit-logs snap [why]     append what is new in every source; `why` is written to the directory as a marker
#   1bit-logs daemon         snap every 15 s and prune to the last five boots (that is what /etc/init.d/06onboard-logs runs)
#   1bit-logs prune          keep only the five newest boot directories
#
# Exit: 0 ok, 1 nothing persists (no /data) or the directory cannot be made.
set -u
DATA=${ONEBIT_LOG_DATA:-/data}
ROOT=$DATA/logs
KEEP=5
BOOTID_FILE=${ONEBIT_BOOTID_FILE:-/tmp/1bit-logs.bootid}
say() { printf '%s\n' "$*"; }

# Is $DATA a mounted partition? Not "can I mkdir" - $DATA is a directory even when the partition never mounted
# (05onboard-data mkdirs it before mounting), so a missing mount would put the "persisted" log on the RAM-backed
# root instead, and nothing would say so. Measured 4 Nov (TOS3-NOTE-c21-logs): four of five boots kept no log on the
# partition and nothing was logged anywhere.
#
# The path is made canonical first, because /proc/mounts records the mount point the kernel was given: in this
# image /tmp is a symlink to /initrd/mnt/tmpfs/tmp, so a tmpfs mounted at /tmp/x appears there as
# /initrd/mnt/tmpfs/tmp/x and a literal compare would call a mounted directory unmounted (measured in the guest,
# 4 Nov: `findmnt` showed the mount, the string match found nothing, and the daemon waited for ever).
mounted() {
    real=$(readlink -f "$DATA" 2> /dev/null) || return 1
    [ -n "$real" ] || return 1
    grep -q " $real " /proc/mounts 2> /dev/null
}

# The id has to be stable within one boot and different across boots, and it must not need a clock read on every
# call (the daemon and every snap would otherwise name a different directory). /proc/sys/kernel/random/boot_id is
# exactly that; the wall clock is only a label for a person reading the directory listing.
bootid() {
    [ -s "$BOOTID_FILE" ] && { cat "$BOOTID_FILE"; return 0; }
    id=$(date -u +%Y%m%dT%H%M%S 2> /dev/null)-$(cut -c1-8 /proc/sys/kernel/random/boot_id 2> /dev/null)
    mkdir -p "${BOOTID_FILE%/*}" 2> /dev/null
    printf '%s' "$id" > "$BOOTID_FILE" 2> /dev/null
    printf '%s' "$id"
}

dir() {
    mounted || return 1
    mkdir -p "$ROOT" 2> /dev/null || return 1
    d=$ROOT/$(bootid)
    mkdir -p "$d" 2> /dev/null || return 1
    if [ ! -f "$d/BOOT" ]; then
        {
            say "date     $(date -u +%FT%TZ 2> /dev/null)"
            say "uptime   $(cut -d' ' -f1 /proc/uptime 2> /dev/null) s"
            say "kernel   $(uname -r 2> /dev/null)"
            say "cmdline  $(cat /proc/cmdline 2> /dev/null)"
            say "release  $(head -1 /data/RELEASE-TAG 2> /dev/null || sed -n 's/^payload=//p' /etc/1bit/release-identity 2> /dev/null)"
        } > "$d/BOOT" 2> /dev/null
    fi
    printf '%s\n' "$d"
}

# append_new <sink name> <source>: append the bytes of <source> that the previous snap has not written yet.
# The offset is the source's own size, so this is a tail -c, not a growing copy of a growing file. A source that
# SHRANK is a ring buffer (dmesg) that wrapped or a log that was truncated; that is marked in the sink rather
# than passed off as new output.
append_new() {
    name=$1 src=$2 d=$3
    case $src in
    dmesg*) ;;                      # a command, not a file: the ring is whatever `dmesg` prints now
    *) [ -r "$src" ] || return 0 ;;
    esac
    case $src in
    dmesg*) size=$(dmesg 2> /dev/null | wc -c) ;;
    *) size=$(wc -c < "$src" 2> /dev/null || echo 0) ;;
    esac
    off=$(cat "$d/.$name.off" 2> /dev/null || echo 0)
    case $off in ''|*[!0-9]*) off=0 ;; esac
    if [ "$size" -lt "$off" ]; then
        off=0
        say "" >> "$d/$name.log"
        say "--- source shrank at $(date -u +%FT%TZ 2> /dev/null) (ring buffer wrapped): restarting the copy ---" \
            >> "$d/$name.log"
    fi
    [ "$size" -gt "$off" ] || return 0
    case $src in
    dmesg*) dmesg 2> /dev/null | tail -c +$((off + 1)) >> "$d/$name.log" ;;
    *)      tail -c +$((off + 1)) "$src" >> "$d/$name.log" 2> /dev/null ;;
    esac
    printf '%s' "$size" > "$d/.$name.off" 2> /dev/null
}

# thermal_snap <dir>: one line of thermals and power, sampled only while something is serving.
# Cycle 25's brief: "Tctl, fan rpm, package W every 10 s while a model is loaded" - the condition is the point, an idle
# appliance must not write a file for a day. "Loaded" is read as the engine's own child process existing (lemond spawns
# `/opt/1bit-package/1bit/1bit serve` per loaded model), which needs no network and no API key.
hwmon_read() {   # hwmon_read <file-glob> -> first readable value, or empty
    for f in $1; do
        [ -r "$f" ] || continue
        v=$(cat "$f" 2> /dev/null) || continue
        case $v in ''|*[!0-9-]*) continue ;; esac
        printf '%s' "$v"
        return 0
    done
    return 1
}

tctl_c() {       # the CPU/SoC edge temperature: k10temp's Tctl, else the first labeled temp with that name
    for d in /sys/class/hwmon/hwmon*; do
        [ -r "$d/name" ] || continue
        [ "$(cat "$d/name" 2> /dev/null)" = k10temp ] || continue
        for t in "$d"/temp*_input; do
            [ -r "$t" ] || continue
            [ "$(cat "${t%_input}_label" 2> /dev/null)" = Tctl ] || continue
            v=$(cat "$t" 2> /dev/null)
            [ -n "$v" ] && { echo $((v / 1000)); return 0; }
        done
    done
    return 1
}

fan_rpm() {
    for d in /sys/class/hwmon/hwmon*; do
        v=$(hwmon_read "$d/fan1_input" 2> /dev/null) && { printf '%s' "$v"; return 0; }
    done
    return 1
}

pkg_watts() {    # whatever the board exposes as package power, in W with one decimal
    for d in /sys/class/hwmon/hwmon*; do
        [ -r "$d/power1_input" ] || continue
        v=$(cat "$d/power1_input" 2> /dev/null)
        case $v in ''|*[!0-9]*) continue ;; esac
        printf '%s.%s' $((v / 1000000)) $(( (v / 100000) % 10 ))
        return 0
    done
    return 1
}

model_loaded() {
    pgrep -f '/opt/1bit-package/1bit/1bit' > /dev/null 2>&1
}

thermal_snap() {
    d=$1
    model_loaded || return 0
    t=$(tctl_c) || t="n/a"
    f=$(fan_rpm) || f="n/a"
    w=$(pkg_watts) || w="n/a"
    printf '%s tctl_c=%s fan_rpm=%s pkg_w=%s\n' "$(date -u +%FT%TZ 2> /dev/null)" "$t" "$f" "$w" \
        >> "$d/thermal.log" 2> /dev/null
    return 0
}

snap() {
    d=$(dir) || { say "1bit-logs: nothing persists ($DATA is not a mounted partition)"; return 1; }
    [ -n "${1:-}" ] && printf '%s %s\n' "$(date -u +%FT%TZ 2> /dev/null)" "$1" >> "$d/markers"
    append_new dmesg dmesg "$d"
    append_new messages /var/log/messages "$d"
    append_new xorg /var/log/Xorg.0.log "$d"
    append_new xerrs /tmp/xerrs.log "$d"
    append_new lemond /var/log/lemond-onebit.log "$d"
    append_new webapp /var/log/1bit-webapp.log "$d"
    # the offsets are this boot's bookkeeping, not evidence
    chmod 600 "$d"/.*.off 2> /dev/null
    return 0
}

prune() {
    [ -d "$ROOT" ] || return 0
    # shellcheck disable=SC2046  # the boot directories ARE the words, oldest first
    set -- $(ls -1d "$ROOT"/*/ 2> /dev/null | sort)
    n=$#
    while [ "$n" -gt "$KEEP" ]; do
        rm -rf "$1" 2> /dev/null
        shift
        n=$((n - 1))
    done
    return 0
}

daemon() {
    # rc.services runs this with `start` at boot, and the partition can mount AFTER that point (measured 4 Nov: /data
    # mounted 3.7 min into a boot, and a one-shot test is what lost that boot's log). So wait for it instead of
    # giving up: a boot where /data ever mounts has its evidence, and one where it never does is said once.
    waited=
    while ! d=$(dir); do
        [ -n "$waited" ] || { say "1bit-logs: $DATA is not mounted yet - waiting for it (nothing is persisted until then)"; waited=1; }
        sleep 5
    done
    [ -n "$waited" ] && say "1bit-logs: $DATA is mounted after waiting, this boot's logs go to $d"
    prune
    # Cycle 25: the boot's identity is written once, as soon as the partition is there. It lives here rather than in
    # 06onboard-logs because this loop is the one that has already waited for the mount (and the one that knows the
    # directory), so the proof cannot land in RAM and disappear.
    if [ -x /usr/local/bin/1bit-proof ]; then
        /usr/local/bin/1bit-proof boot > /dev/null 2>&1 || say "1bit-logs: boot proof not written (1bit-proof boot)"
    fi
    n=0
    while : ; do
        # one loop, two cadences: the log copy every 15 s (3 x 5), thermals every 10 s (2 x 5). A separate sleep loop
        # would drift against this one and, worse, run while this one is blocked in a slow tail.
        if [ $((n % 3)) = 0 ]; then snap; fi
        if [ $((n % 2)) = 0 ]; then thermal_snap "$d"; fi
        n=$((n + 1))
        [ $((n % 120)) = 0 ] && prune
        sleep 5
    done
}

case ${1:-} in
'')           snap ;;
dir)          dir ;;
snap)         shift; snap "${1:-}" ;;
daemon)       daemon ;;
prune)        prune ;;
*)            say "usage: $0 [dir|snap [why]|daemon|prune]"; exit 2 ;;
esac
