# 1bit OS power profile (read by 1bit-board from 1bit-board.service). Defaults are the development
# box's: the appliance is the same board and pad class. SKIP_POWER=1 leaves power alone entirely.
# The fan trip points are the first thing to revisit on a hotter unit.
MODE=performance
FAST_LIMIT=90000
SLOW_LIMIT=90000
SLOW_TIME=5
TCTL_LIMIT=105000
BOOST_TEMP=70
BOOST_LEVEL=4
LEVEL5_TEMP=82
SKIP_POWER=0
