#
# /etc/1bit/libhsa.env - what HRX needs on this board's GPU (engine#715, corrected 2026-11-02 by the cycle-13
# board boot, which found no HRX device at all).
#
# Read by /etc/init.d/10lemonade (v2's lemond unit took the same file as its EnvironmentFile, so an image
# built for v2 stays valid) and by /etc/profile.d/90onboard-limits. Every line here is EXPORTED: a plain
# assignment in a sourced file never reaches lemond or the engine children, which is why they are written
# with `export` rather than as bare NAME=VALUE.
#
# The board reports XNACK enabled: NO and Coherent Host Access: FALSE. Without the no-SVM trio HRX
# page-faults on its first graph replay: 58 fault lines and an HTTP 500 in under 10 ms. None of these three is
# a preference. `1bit serve` sets the trio itself for every HRX backend (engine#315), so these are the belt to
# that braces - and they also cover a backend started by something other than serve.
export HSA_USE_SVM=0
export HSA_USERPTR_FOR_PAGED_MEM=0
export HRX_ALLOW_NO_SVM=1

# Where the HSA runtime is. There is NO environment variable that names it to the engine: ONEBIT_HRX_LIBHSA is
# a CMake compile definition (CMakeLists.txt:279, cmake/hrx.cmake), so the line that used to sit here pointed
# at a path nothing read, and the board boot measured the consequence - `libhsa-runtime64.so.1` searched in
# /lib:/usr/lib and never opened. What the engine does at run time (app/serve.cpp:201) is: --hrx-libhsa, then
# the path baked in at build time if it exists, then a recursive scan of /opt/rocm-therock for a file named
# libhsa-runtime64.so.1; the winner is exported to the backend as IREE_HAL_AMDGPU_LIBHSA_PATH.
#
# So the image ships the whole runtime set at /opt/rocm-therock/lib (build.sh LIBHSA_DIR=...), which is what
# that scan finds, and this file only has to make the loader agree for anything that asks for the library by
# its bare soname instead. The pinned libhsa's RUNPATH is $ORIGIN, so its own librocm_sysdeps_* siblings must
# sit beside it - that is why the whole set is installed and why a lone libhsa could never load.
export LD_LIBRARY_PATH=/opt/rocm-therock/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
