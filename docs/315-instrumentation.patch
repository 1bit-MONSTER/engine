 namespace ggml::hrx {
 
+// engine#315 diagnostic. Declared here, before GraphReplayStreamState's methods, because those methods
+// sit above the shared anonymous namespace. Inert unless GGML_HRX_WRITEBACK_FINGERPRINT is set.
+static bool writeback_fingerprint_enabled() {
+    const char * value = std::getenv("GGML_HRX_WRITEBACK_FINGERPRINT");
+    return value != nullptr && value[0] != '\0' && !(value[0] == '0' && value[1] == '\0');
+}
+
+// Classify and fingerprint a host-staging region so that "the device had not written it yet" is
+// distinguishable from "the device wrote non-finite values".
+struct StagingFingerprint {
+    uint64_t hash        = 1469598103934665603ull;  // FNV-1a basis
+    uint64_t nonfinite16 = 0;                       // f16/bf16: exponent all ones
+    uint64_t nonfinite32 = 0;                       // f32: exponent all ones
+    uint64_t zeros16     = 0;
+    uint64_t lanes16     = 0;
+};
+
+static StagingFingerprint fingerprint_staging(const void * data, size_t size) {
+    StagingFingerprint fp;
+    if (data == nullptr || size == 0) {
+        return fp;
+    }
+    const uint8_t * bytes = static_cast<const uint8_t *>(data);
+    for (size_t i = 0; i < size; ++i) {
+        fp.hash ^= bytes[i];
+        fp.hash *= 1099511628211ull;
+    }
+    const uint16_t * lanes = static_cast<const uint16_t *>(data);
+    fp.lanes16             = size / sizeof(uint16_t);
+    for (uint64_t i = 0; i < fp.lanes16; ++i) {
+        const uint16_t v = lanes[i];
+        if (v == 0) {
+            ++fp.zeros16;
+        }
+        if ((v & 0x7C00u) == 0x7C00u) {
+            ++fp.nonfinite16;
+        }
+    }
+    const uint32_t * dwords = static_cast<const uint32_t *>(data);
+    for (size_t i = 0; i < size / sizeof(uint32_t); ++i) {
+        if ((dwords[i] & 0x7F800000u) == 0x7F800000u) {
+            ++fp.nonfinite32;
+        }
+    }
+    return fp;
+}
+
+static const char * fingerprint_class(const StagingFingerprint & fp, const void * data, size_t size) {
+    if (data == nullptr || size == 0) {
+        return "EMPTY";
+    }
+    if (fp.lanes16 > 0 && fp.zeros16 == fp.lanes16) {
+        return "ZERO";
+    }
+    if (fp.nonfinite16 > 0 || fp.nonfinite32 > 0) {
+        return "NONFINITE";
+    }
+    return "FINITE";
+}
+
+static void fingerprint_writeback_log(int          staging_value,
+                                      int          barrier_used,
+                                      size_t       size,
+                                      const StagingFingerprint & rec,
+                                      const char * rec_class,
+                                      const StagingFingerprint & sync,
+                                      const char * sync_class,
+                                      const StagingFingerprint & dst,
+                                      const char * dst_class) {
+    std::fprintf(stderr,
+                 "[hrx-wb-fp] value=%d size=%zu barrier=%d rec_hash=%016llx sync_hash=%016llx "
+                 "dst_hash=%016llx rec_class=%s sync_class=%s dst_class=%s rec_eq_sync=%d "
+                 "rec_nf16=%llu sync_nf16=%llu dst_nf16=%llu rec_nf32=%llu sync_nf32=%llu dst_nf32=%llu\n",
+                 staging_value, size, barrier_used, static_cast<unsigned long long>(rec.hash),
+                 static_cast<unsigned long long>(sync.hash), static_cast<unsigned long long>(dst.hash), rec_class,
+                 sync_class, dst_class, rec.hash == sync.hash ? 1 : 0,
+                 static_cast<unsigned long long>(rec.nonfinite16),
+                 static_cast<unsigned long long>(sync.nonfinite16),
+                 static_cast<unsigned long long>(dst.nonfinite16),
+                 static_cast<unsigned long long>(rec.nonfinite32),
+                 static_cast<unsigned long long>(sync.nonfinite32),
+                 static_cast<unsigned long long>(dst.nonfinite32));
+    std::fflush(stderr);
+}
+
