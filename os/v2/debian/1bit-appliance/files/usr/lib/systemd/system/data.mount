# /data is the 1BIT-DATA partition on the machine's own disk: models, Lemonade's backends, its config
# and key, the NPU kernel sets, the SSH keys. Mounted by label so it is the same on a USB boot (the
# stick's own partition) and after an install; nofail so a machine whose data partition is missing
# still boots to a console that can say so.
[Unit]
Description=1bit OS: the data partition (1BIT-DATA)
Before=1bit-lemonade.service
DefaultDependencies=no
After=systemd-udev-settle.service local-fs-pre.target
Wants=local-fs-pre.target

[Mount]
What=/dev/disk/by-label/1BIT-DATA
Where=/data
Type=ext4
Options=defaults,nofail

[Install]
WantedBy=local-fs.target
