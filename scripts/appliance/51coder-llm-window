# coder-llm-window: the PR reviewer's model in on-demand box-hold windows (see /usr/local/bin/coder-llm-window).
# No systemd on this image: a detached supervisor loop as bcloud is the restart policy (engine#1504: a runner or
# service that dies must come back). Stop: /etc/init.d/51coder-llm-window stop.
case "${1:-start}" in
  start)
    pgrep -f "coder-llm-window-supervisor" > /dev/null 2>&1 && exit 0
    su bcloud -s /bin/sh -c 'setsid nohup bash -c "exec -a coder-llm-window-supervisor bash -c \"while :; do /usr/local/bin/coder-llm-window watch; sleep 15; done\"" > /dev/null 2>&1 < /dev/null &'  > /dev/null 2>&1 < /dev/null
    ;;
  stop)
    kill $(pgrep -f "coder-llm-window-supervisor") 2>/dev/null
    su bcloud -s /bin/sh -c '/usr/local/bin/coder-llm-window stop'
    ;;
esac
exit 0
