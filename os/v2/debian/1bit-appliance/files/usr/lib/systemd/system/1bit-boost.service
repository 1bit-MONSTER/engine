# The predictive fan boost: one process, 0.5 s poll, releases to the EC curve when the machine is
# quiet. Restart=always, because a fan loop that dies quietly is how a board cooks.
[Unit]
Description=1bit OS: fan boost
ConditionPathExists=/usr/sbin/1bit-board
After=1bit-board.service
Requires=1bit-board.service

[Service]
Type=simple
ExecStart=/usr/sbin/1bit-board boost
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
