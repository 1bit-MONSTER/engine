#
# The appliance's desktop hook: when X starts, open the chat screen (measured: /etc/xdg/templates/_root_.jwmrc runs
# xdg_autostart.sh, and usr/bin/xdg_autostart.sh runs the Exec= of every /etc/xdg/autostart/*.desktop).
[Desktop Entry]
Type=Application
Name=1bit OS chat screen
Comment=Open the appliance's chat screen in the browser (Lemonade on 13305 underneath)
Exec=/usr/local/bin/1bit-lemonade-webapp
Terminal=false
NoDisplay=false
Categories=Utility;
