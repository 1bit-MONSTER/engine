# 26onboard-board - the board service: fan curve and power profile on a board whose EC we drive.
#
# release-check's `fans` row SKIPped on the 2026-11-02 board boot ("no /usr/sbin/1bit-board in this image: the
# fans stay on the firmware curve"), while os/mini has shipped the tool all along (os/mini/board.sh). This is
# that same file, installed as the path the row reads, started here through the EC driver only.
#
# Every branch says what it did: a board this does not know is not guessed at, and the firmware curve stays.
B=/usr/sbin/1bit-board
[ -x "$B" ] || { echo "26onboard-board: no $B: the fans stay on the firmware curve" >&2; exit 0; }
if ! "$B" known > /dev/null 2>&1; then
    echo "26onboard-board: not a board whose EC we drive: nothing written (firmware fan curve, $("$B" status 2>&1))"
    exit 0
fi
"$B" curve || echo "26onboard-board: the fan curve was not written" >&2
"$B" power || echo "26onboard-board: the power profile was not applied" >&2
# the predictive boost is a 0.5 s loop and must outlive this script: rc.services runs init.d scripts in order
# and waits for each, so the loop is detached here rather than run in the foreground.
( "$B" boost > /var/log/1bit-board.log 2>&1 & )
echo "26onboard-board: $("$B" status 2>&1); $("$B" power-status 2>&1)"
