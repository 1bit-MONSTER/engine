# 1bit-console-menu - what /etc/inittab respawns on tty1 (a headless boot).
#
# The OWNER, on the cycle-14 board boot (2026-11-02 ~21:00): "no menu system". The appliance's console was a
# bare root prompt, which is not an appliance: a person in front of the box (JetKVM or a monitor) needs to see
# what the machine is doing and to reach the six things the box can do without a browser, and every one of
# them used to be an ssh session.
#
# Design decisions, each one paid for by an earlier cycle:
#   * tty1 only. ssh users get bash - a menu that traps a remote administrator is a worse appliance. inittab
#     names this script; there is nothing here that sshd runs.
#   * it never exits to a dead console. A dialog that dies, a terminal that cannot redraw, an action that
#     returns garbage: every path redraws. inittab respawns it as a backstop, but a respawn loop on a broken
#     terminal looks like a crash, so the fallback is a plain-text menu on the same terminal.
#   * every status number is read where the rest of the image reads it (/proc, /sys, 1bit-board, lemond's own
#     API) - no second source of truth, and no number that a stale file can fake.
#   * every menu item can be run WITHOUT a keyboard: `--run N` does the item's read-only half and says what
#     it would do, and `--selftest` runs all nine. That is not a courtesy to the VM rows - a console menu
#     whose actions have never run is untested code on the one surface nobody can attach a debugger to.
#
# Usage:
#   1bit-console-menu              the menu on this terminal (that is what tty1 gets)
#   1bit-console-menu --status     print the header and status block, exit 0 (no terminal needed)
#   1bit-console-menu --run N      run menu item N non-interactively (1..9); exit 0 if it did its read half
#   1bit-console-menu --selftest   --status plus every item; exit 0 only if all of them answered
#   1bit-console-menu --action N   run menu item N interactively on this terminal - what the console TUI's keys
#                                  2-7 hand off to, so those actions exist in exactly one place
#
# Exit: 0 ok, 1 an action failed, 2 usage.

API=http://127.0.0.1:13305
# The two paths item 1 writes through, overridable so the ONE new write path in this image can be tested
# (pi-prs on #934, note 2: reachable only from a dialog, with a hard-coded CONF, so nothing could point it at a
# temp file). The defaults are the appliance's own and nothing in a boot changes them; `--mint-selftest` sets both.
CONF=${ONEBIT_LEMOND_CONF:-/etc/1bit/lemond.conf}
LEMOND_INIT=${ONEBIT_LEMOND_INIT:-/etc/init.d/10lemonade}
LEMLOG=/var/log/lemond-onebit.log
DESKTOP=/usr/local/bin/1bit-desktop
NONINT=0
say() { printf '%s\n' "$*"; }

# Cycle 17 item 4: every status probe below asks the machine the same question release-check does, so it must run
# with the same environment Lemonade runs with. Measured on the cycle-16 board: this menu said "GPU no HRX device
# (the runtime registered none)" on a box that was serving chat-hrx at 303 tok/s, because `llama-server
# --list-devices` was started without HSA_USE_SVM=0 / HRX_ALLOW_NO_SVM=1 and without LD_LIBRARY_PATH pointing at
# the pinned HSA set - i.e. without /etc/1bit/libhsa.env, the file /etc/init.d/10lemonade sources before it starts
# the engine. The menu reads it from the same place rather than growing a second opinion.
[ -r /etc/1bit/libhsa.env ] && . /etc/1bit/libhsa.env

# ── the facts the header and the status block are made of ──────────────────────────────────────────────
release_tag() {
    if [ -r /data/RELEASE-TAG ]; then head -1 /data/RELEASE-TAG
    elif [ -r /etc/1bit/release-identity ]; then sed -n 's/^payload=//p' /etc/1bit/release-identity | head -1
    else echo unknown; fi
}
hostname_now() { hostname 2>/dev/null || cat /etc/hostname 2>/dev/null || echo 1bit-os; }
ips() {
    ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | tr '\n' ' ' |
        sed 's/ *$//'
}
api_key() {
    f=$(readlink -f "$CONF" 2>/dev/null || echo "$CONF")
    sed -n 's/^LEMONADE_API_KEY=//p' "$f" 2>/dev/null | head -1
}
# The request helper the menu uses for Lemonade: the Authorization header goes in only when the appliance is keyed.
# Blank mode is the shipped default (cycle 20), and an empty `Bearer ` is not the same request as no header at all.
api_get() {   # api_get <url> [curl args...]
    u=$1; shift
    k=$(api_key)
    if [ -n "$k" ]; then curl -H "Authorization: Bearer $k" "$@" "$u"; else curl "$@" "$u"; fi
}
keyed() { [ -n "$(api_key)" ]; }
lemond_up() { [ -n "$(lemond_pid)" ]; }
lemond_pid() {
    ps 2>/dev/null | awk '/[l]emond /{print $1; exit}'
}
lemond_listening() { netstat -lnt 2>/dev/null | awk '$4 ~ /:13305$/ {n++} END {print n+0}'; }

# The GPU line asks the runtime, not the device node: /dev/kfd present with no HRX0 registered is the cycle-13
# failure this lane spent a board boot on, and "a device exists" would have hidden it. llama-server --list-devices
# is the same question release-check's hrx-device row asks, cached for two minutes because the menu redraws.
gpu_line() {
    if [ ! -e /dev/kfd ] || ! ls /dev/dri/renderD* >/dev/null 2>&1; then
        echo "none (no /dev/kfd or /dev/dri/renderD* on this machine)"; return
    fi
    cache=/tmp/1bit-menu-gpu
    age=999999
    [ -s "$cache" ] && age=$(( $(date +%s) - $(stat -c %Y "$cache" 2>/dev/null || echo 0) ))
    if [ "$age" -gt 120 ]; then
        lsrv=${ONEBIT_HRX_LLAMA_SERVER:-/opt/1bit-llama/llama-server}
        if [ -x "$lsrv" ]; then
            timeout 20 "$lsrv" --list-devices 2>&1 |
                sed -n 's/^[[:space:]]*\(HRX[0-9][0-9]*\): *\(.*\)$/\1: \2/p' |
                grep -vi INCOMPATIBLE | head -1 > "$cache"
        else
            echo "no llama-server at $lsrv" > "$cache"
        fi
    fi
    d=$(head -1 "$cache" 2>/dev/null)
    if [ -n "$d" ]; then
        free=$(printf '%s' "$d" | sed -n 's/.*(\([0-9]*\) MiB free).*/\1/p')
        [ -n "$free" ] && echo "${d%%:*}, $free MiB free" || echo "${d%%:*}"
    else
        echo "no HRX device (the runtime registered none)"
    fi
}
npu_line() {
    m=absent
    grep -q '^amdxdna ' /proc/modules 2>/dev/null && m=loaded
    fw=absent
    ls /lib/firmware/amdnpu >/dev/null 2>&1 && fw=present
    dev=absent
    [ -e /dev/accel/accel0 ] && dev=accel0
    echo "amdxdna $m, firmware $fw, $dev"
}
sb_line() {
    f=$(ls /sys/firmware/efi/efivars/SecureBoot-* 2>/dev/null | head -1)
    if [ -z "$f" ]; then echo "unknown (efivarfs not mounted)"; return; fi
    # efivarfs does not support partial reads: `dd skip=4` seeks and gets nothing, which read as "disabled" on a
    # Secure Boot machine the first time this was written (measured here: dd skip=4 empty, od of the whole
    # variable 6 0 0 0 1). Read the 5 bytes and take the last one - 4 attribute bytes, then the value.
    v=$(od -An -tu1 < "$f" 2>/dev/null | awk '{print $5}')
    [ "$v" = 1 ] && echo enabled || echo "disabled (SecureBoot=$v)"
}
fans_line() {
    s=$(/usr/sbin/1bit-board status 2>/dev/null | head -1)
    if [ -n "$s" ]; then echo "$s"
    else
        n=0; rpm=""
        for f in /sys/class/hwmon/hwmon*/fan*_input; do
            [ -r "$f" ] || continue
            rpm="$rpm $(basename "$f" _input)=$(cat "$f")"; n=$((n + 1))
        done
        [ "$n" -gt 0 ] && echo "fans:$rpm" || echo "not readable (no EC driver, no hwmon fan)"
    fi
}
temps_line() {
    max=0
    for f in /sys/class/hwmon/hwmon*/temp*_input; do
        [ -r "$f" ] || continue
        t=$(cat "$f" 2>/dev/null); [ -n "$t" ] || continue
        t=$((t / 1000))
        [ "$t" -gt "$max" ] && max=$t
    done
    [ "$max" -gt 0 ] && echo "max ${max}C" || echo "no sensor"
}
data_line() {
    d=$(df -h /data 2>/dev/null | awk 'NR == 2 {print $2", "$4" free"}')
    [ -n "$d" ] && echo "$d" || echo "not mounted"
}
# Which system is running, and on which disk - init.sh's own rule, so this console cannot disagree with the boot
# banner (#711: "live usb is loaded up" while the facts came from the NVMe). init touches /etc/1bit/installed on an
# installed boot and /etc/1bit/live on a stick boot; when neither marker was written it falls back to
# /data/.installed, which is 1bit-install's own marker on the installed data partition.
installed_mode() {
    # init.sh's decision first, exactly as it makes it: /data mounted with .installed on it IS an installed boot, and
    # the markers below are written FROM that decision. Checking the markers first let a stale `live` marker outrank a
    # real installed data partition (measured in QEMU: the menu said live on a box whose /data carried .installed).
    grep -q ' /data ' /proc/mounts 2>/dev/null && [ -e /data/.installed ] && return 0
    [ -e /etc/1bit/installed ] && return 0
    [ -e /etc/1bit/live ] && return 1
    return 1
}
# The disk this boot came from. Deliberately the same question 1bit-console-install asks before it refuses a target,
# so the screen cannot name a different disk from the one the installer would refuse.
boot_disk() {
    p=$(awk '$2 == "/data" { print $1; exit }' /proc/mounts 2>/dev/null)
    [ "$p" ] || p=$(awk '$2 == "/initrd/mnt/dev_save" { print $1; exit }' /proc/mounts 2>/dev/null)
    [ "$p" ] || p=$(blkid -L 1BIT-DATA 2> /dev/null | head -1)
    [ "$p" ] || return 0
    d=$(lsblk -no PKNAME "$p" 2> /dev/null | head -1)
    [ "$d" ] && echo "/dev/$d" || echo "$p"
}
models_line() {
    list=""
    list=$(api_get "$API/v1/models" -s -m 5 2>/dev/null |
        grep -o '"id":"[^"]*"' | cut -d'"' -f4)
    if [ -n "$list" ]; then
        # the count is what the banner can hold whole; the ids are item 4's screen (no line here is cut mid-word -
        # the cycle-16 board showed "firmware prese" for exactly that reason)
        echo "$(printf '%s\n' $list | wc -l) downloaded"
    else
        echo "none downloaded"
    fi
}

header_line() { say "1bit OS $(release_tag)   $(hostname_now)   $(first_ip)"; }
first_ip() { ips | awk '{print $1}'; }
# The block is SEVEN lines on purpose: tty1 is an 80x25 text console, and a dialog that needs more room than
# that clips its own menu (measured here: at 22 rows with a 12-line prompt, item 9 "Reboot / power off" was
# not drawn at all and there was no way to reach it from the console).
status_text() {
    ip=$(first_ip)
    header_line
    if lemond_up; then
        say "Lemonade  up (pid $(lemond_pid)) - http://${ip:-127.0.0.1}:13305"
    else
        say "Lemonade  DOWN (no lemond process; item 8 has its log)"
    fi
    # Each line is measured to fit one 78-column dialog row: a long line WRAPS inside the menu box and pushes the
    # last items off the screen (cycle 14 measured item 9 disappearing that way), so the fields are sized here and
    # nothing is chopped in the middle of a word.
    say "GPU  $(gpu_line | cut -c1-68)"
    say "NPU  $(npu_line | cut -c1-44)"
    say "Fans $(fans_line | cut -c1-62)"
    say "Temp $(temps_line)   Secure Boot $(sb_line)"
    say "Data $(data_line)   Models $(models_line | cut -c1-30)"
}
menu_text() { say "1-9 then Enter. Refresh 2 s while booting, 15 s after. ssh = bash"; }

# ── CONNECT (cycle 18, the owner: "when you first boot the headless there is no data to display on how to
# connect, just the menu") ────────────────────────────────────────────────────────────────────────────────
# The first screen after a headless boot is the moment a person needs to know where this machine is, so the block
# sits ABOVE the menu and is built from what the machine says now, not from what it said at boot: while the wire or
# Lemonade is still coming up it says what it is waiting for and the menu redraws every 2 s.
spinner() { set -- '|' '/' '-' '\\'; shift $(( $(date +%s) % 4 )); printf '%s' "$1"; }
net_up() { [ -n "$(first_ip)" ]; }
lemonade_up() { [ "$(lemond_listening)" -gt 0 ] 2>/dev/null || lemond_up; }

booting_text() {
    if net_up; then
        say "BOOT  network up $(first_ip) $(spinner)"
    else
        say "BOOT  waiting for network $(spinner) - plug the cable in, or menu 3 for a static address"
    fi
    if lemonade_up; then
        say "      Lemonade is answering on :13305"
    else
        say "      waiting for Lemonade on :13305 $(spinner) - it starts once /data is mounted"
    fi
}
# Four lines, each measured to fit one 78-column dialog row (a longer line wraps and pushes the last menu items off
# the screen - cycle 14 measured item 9 disappearing exactly that way). The key itself is NEVER printed here: menu
# item 1 shows it, and the console is the surface a screen recording catches. Cycle 20 (owner: "blank key") makes
# blank the shipped mode, so the api line carries the mode itself - and it is a SUBSTITUTION, not an addition: a
# fifth line measured exactly the cycle-14 failure again (dialog at 80x25, "88%" scroll indicator, item 9 "Reboot /
# power off" not drawn at all). The long form of the sentence lives in the TUI, which has the width for it.
connect_text() {
    ip=$(first_ip)
    if [ -z "$ip" ]; then
        say "CONNECT  no address yet - menu 3 (Network); DHCP is automatic once a cable is in"
        return
    fi
    say "CONNECT  $(hostname_now)   web UI http://$ip:13305"
    if keyed; then
        say "         api  http://$ip:13305/api/v1   (API key: press 1)"
        say "         ssh  root@$ip   (your key in /data/ssh/authorized_keys)"
        say "         app  Lemonade Mobile: server http://$ip:13305 + that key"
    else
        say "         api  http://$ip:13305/api/v1   (no key: anyone, press 1)"
        say "         ssh  root@$ip   (your key in /data/ssh/authorized_keys)"
        say "         app  Lemonade Mobile: server http://$ip:13305 (any key)"
    fi
}
# What the dialog shows. Nine lines with the nine menu rows, i.e. inside the 12 the 24-row box leaves free.
status_brief() {
    say "GPU $(gpu_line | cut -c1-46)   Data $(data_line | cut -c1-22)"
    say "NPU $(npu_line | cut -c1-28)  Temp $(temps_line)  SB $(sb_line | cut -c1-9)"
    say "Fans $(fans_line | cut -c1-40)  Models $(models_line | cut -c1-20)"
}
screen_text() {
    header_line
    if net_up && lemonade_up; then connect_text; else booting_text; fi
    status_brief
    menu_text
}

# ── the terminal ───────────────────────────────────────────────────────────────────────────────────────
# dialog draws its widget on stdout and writes the RESULT to stderr, which is why the choice is captured through
# the 3>&1 1>&2 2>&3 dance. `--no-mouse` is not cosmetic: without it ncurses initialises gpm and dialog prints
# `libgpm: zero screen dimension...` on stderr - i.e. INSIDE the captured value - measured here as
# `choice=libgpm:...`, which made every menu item do nothing. An appliance console has no gpm either, so the
# mouse is off and the warning is gone. -timeout redraws the menu (and so the status) every 15 s.
ui() {   # ui <dialog args...> -> the widget on the terminal, the result on stdout
    TERM=${TERM:-linux} dialog --no-shadow --no-mouse "$@" 3>&1 1>&2 2>&3
}
dialog_ok() { command -v dialog > /dev/null 2>&1; }

# The fallback: a terminal dialog cannot draw on still gets the same information and the same choices. This
# is not decoration - "the console never goes dead" is the promise, and a menu that only exists if ncurses
# works breaks it on the one machine nobody can log into.
text_choice() {
    printf '\033[H\033[2J'
    status_text
    menu_text
    printf '  [1-9] '
    read -r answer || answer=""
    printf '%s' "$answer"
}

show_text() {   # show_text <title> <file>
    if [ "$NONINT" = 1 ] || ! dialog_ok; then cat "$2"; return 0; fi
    ui --title " $1 " --textbox "$2" 22 78
}
yesno() {   # yesno <question> -> 0 = yes
    [ "$NONINT" = 1 ] && return 0
    dialog_ok || return 0
    ui --title " 1bit OS " --yesno "$1" 10 70
}
say_text() {   # say_text <title> <text...>
    t=$(mktemp) || return 1
    printf '%s\n' "$2" > "$t"
    show_text "$1" "$t"
    rm -f "$t"
}

# ── items ─────────────────────────────────────────────────────────────────────────────────────────────
# 1 The API key: OFF (blank) by default, ON when a person asks for one. Owner's decision, 2026-11-03 ~20:1x: "1bit OS
# ships like stock Lemonade" - no key, everything works (the box's own Lemonade UI, this console's chat test, Lemonade
# Mobile, any OpenAI client with a placeholder key), and the only reason to turn one on is a shared network. Turning it
# on mints 48 hex characters into /etc/1bit/lemond.conf (mode 600, a symlink onto /data) - the same file 10lemonade
# reads - and restarts 10lemonade so lemond comes up in the other mode. Nothing else in the image holds the key, and
# the console still never prints it without a confirm: it is a bearer token and this screen can be on a recording.
key_file() { readlink -f "$CONF" 2>/dev/null || echo "$CONF"; }
key_on() {
    k=$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')
    f=$(key_file)
    mkdir -p /etc/1bit 2> /dev/null
    { [ -f "$f" ] && grep -v '^LEMONADE_API_KEY=' "$f"; printf 'LEMONADE_API_KEY=%s\n' "$k"; } > "$f.new" 2> /dev/null &&
        mv "$f.new" "$f" && chmod 600 "$f" || { say "cannot write $f - the key was not turned on"; return 1; }
    "$LEMOND_INIT" restart > /dev/null 2>&1
    say "api-key: turned ON (lemond restarted in keyed mode)"
    say_text "API key" "Lemonade now requires this key

$k

As a header:   Authorization: Bearer $k
Try it:        curl -H \"Authorization: Bearer $k\" $API/api/v1/models

Menu item 1 again turns it off."
    return 0
}
key_off() {
    f=$(key_file)
    [ -f "$f" ] && { grep -v '^LEMONADE_API_KEY=' "$f" > "$f.new" 2> /dev/null && mv "$f.new" "$f"; }
    "$LEMOND_INIT" restart > /dev/null 2>&1
    say "api-key: turned OFF (blank mode - anyone on this network can use Lemonade)"
    return 0
}
item_api_key() {
    k=$(api_key)
    if [ "$NONINT" = 1 ]; then
        # The read-only half: the mode, and the key when there is one. --selftest and the image's own rows run this
        # path, so it must never mint, remove or restart anything.
        if [ -n "$k" ]; then
            say "api-key: $k"
            # "shown" means the file holds something key-SHAPED (.conf is one line, but a hand-edited or glued line
            # can hold a fragment that is still non-empty), so the 48-hex mint is what the marker asserts
            [ ${#k} -ge 32 ] && say "api-key-shown"
        else
            say "api-key: none ($CONF has no LEMONADE_API_KEY line)"
        fi
        if keyed; then say "auth-mode: keyed"; else say "auth-mode: blank"; fi
        return 0
    fi
    if [ -n "$k" ]; then
        yesno "Lemonade requires an API key (keyed mode).

Show it on this screen? It is a bearer token: anyone who can
read this screen can use the appliance." && say_text "API key" "Lemonade API key

$k

As a header:   Authorization: Bearer $k
Try it:        curl -H \"Authorization: Bearer $k\" $API/api/v1/models"
        yesno "Turn the API key OFF?

The appliance would then be stock Lemonade: anyone on this
network could use it. The key line is removed from
$CONF and lemond restarts." && key_off
    else
        yesno "No API key (blank mode): anyone on this network can use Lemonade.

Require one from now on? A key is minted into
$CONF and lemond restarts in keyed mode." && key_on
    fi
    return 0
}

# 2 Quick chat test: one request per backend that this machine can actually run, printing the answer and the
# rate. The rate is Lemonade's own predicted_per_second, which is what release-check's chat rows report, so the
# menu and the acceptance run cannot disagree about how fast the box is.
chat_one() {   # chat_one <model id> -> "id<TAB>answer<TAB>tok/s"
    r=$(api_get "$API/api/v1/chat/completions" -s -m 300 -H 'Content-Type: application/json' \
        --data-binary "{\"model\":\"$1\",\"messages\":[{\"role\":\"user\",\"content\":\"/no_think Reply with exactly: 1BIT OK\"}],\"max_tokens\":32,\"temperature\":0}" 2>/dev/null)
    case $r in
    *'"content"'*)
        a=$(printf '%s' "$r" | sed -n 's/.*"content":"\([^"]*\)".*/\1/p' | head -1)
        t=$(printf '%s' "$r" | sed -n 's/.*"predicted_per_second":\([0-9.]*\).*/\1/p' | head -1)
        printf '%s\t%s\t%s\n' "$1" "${a:-<empty>}" "${t:-?}" ;;
    *) printf '%s\tno answer: %s\t-\n' "$1" "$(printf '%s' "${r:-}" | head -c 100)" ;;
    esac
}
item_chat() {
    # blank mode needs no key (that is the point of it), so "no key" is no longer "cannot chat"
    ids=$(api_get "$API/v1/models" -s -m 5 2>/dev/null |
        grep -o '"id":"[^"]*"' | cut -d'"' -f4)
    # "nothing downloaded" is not a broken menu item: a machine with no model, and every VM (Lemonade hides the
    # onebit entries when there is no GPU and no NPU), legitimately has nothing to chat with. It is a SKIP with
    # the reason, so --selftest stays green for the right reason and a real request failure still fails.
    [ -n "$ids" ] || { say "no downloaded model on this machine - item 4 pulls one (chat-skipped)"; return 0; }
    # the backend is in the id ("...-NPU-1bit"), which is how release-check tells the two apart as well
    npu=$(printf '%s\n' "$ids" | grep -i 'npu' | head -1)
    hrx=$(printf '%s\n' "$ids" | grep -vi 'npu' | head -1)
    out=$(mktemp) || return 1
    : > "$out"
    for m in "$hrx" "$npu"; do
        [ -n "$m" ] || continue
        line=$(chat_one "$m")
        printf '%-34s %s   (%s tok/s)\n' "$(printf '%s' "$line" | cut -f1)" \
            "$(printf '%s' "$line" | cut -f2)" "$(printf '%s' "$line" | cut -f3)" >> "$out"
    done
    say "chat test ($(hostname_now)):"
    cat "$out"
    if grep -q '1BIT OK' "$out"; then say "chat-ok"; rc=0; else rc=1; fi
    [ "$NONINT" = 1 ] || show_text "Chat test" "$out"
    rm -f "$out"
    return $rc
}

# 3 Network: what the wire looks like, a one-shot DHCP lease when it has none, a session-only static address,
# and the hostname. Nothing here writes a connman profile: the appliance's own DHCP is connman's and a second
# client racing it was rejected as a fix in cycle 13 - this is the emergency path for a boot that came up with
# no address at all, and it says so on the screen.
net_status() {
    say "hostname   $(hostname_now)"
    say "addresses  $(ips)"
    ip -4 route 2> /dev/null | head -3
    say "link       $(iface_first)"
    command -v connmanctl > /dev/null 2>&1 && say "connman    present" || say "connman    absent"
}
iface_first() {
    i=$(ip -4 -o addr show scope global 2>/dev/null | awk 'NR == 1 {print $2}')
    [ -n "$i" ] || i=$(ip -o link show 2>/dev/null | awk -F': ' '$2 !~ /^(lo|sit|ip6)/ {print $2; exit}')
    printf '%s' "$i"
}
item_network() {
    if [ "$NONINT" = 1 ]; then
        net_status; say "network-reported"; return 0
    fi
    while : ; do
        c=$(ui --title " Network " --menu "$(net_status)" 20 76 4 \
            1 "Renew the DHCP lease (one shot, this session)" \
            2 "Set a static address (this session only)" \
            3 "Set the hostname" \
            4 "Back" ) || c=4
        case $c in
        1) i=$(iface_first)
           if [ -z "$i" ]; then
               say_text "Network" "no network interface at all: the kernel has no driver bound to the card.
Check 'lsmod | grep -E virtio|e1000|r8169' - a module tree that is not visible is the cycle-13 defect, not a
DHCP one (the appliance has no interface until the driver loads)."
               continue
           fi
           if udhcpc -n -q -i "$i" > /tmp/1bit-dhcp.log 2>&1; then
               say_text "Network" "lease renewed on $i: $(ips)"
           else
               say_text "Network" "udhcpc failed on $i: $(tail -3 /tmp/1bit-dhcp.log 2>/dev/null)"
           fi ;;
        2) a=$(ui --title " Static address " --inputbox "address/prefix (e.g. 192.168.50.111/24)" 10 70 "") || a=""
           [ -n "$a" ] || continue
           g=$(ui --title " Static address " --inputbox "default gateway" 10 70 "") || g=""
           i=$(iface_first)
           if ip addr add "$a" dev "$i" 2> /tmp/1bit-static.log &&
              { [ -z "$g" ] || ip route replace default via "$g" dev "$i" 2>> /tmp/1bit-static.log; }; then
               say_text "Static address" "$a on ${i:-no link} (gateway ${g:-none}): $(ips)
This lives until reboot unless the save layer keeps it."
           else
               say_text "Static address" "$(tail -3 /tmp/1bit-static.log 2>/dev/null)"
           fi ;;
        3) h=$(ui --title " Hostname " --inputbox "hostname" 10 70 "$(hostname_now)") || h=""
           if [ -n "$h" ]; then
               echo "$h" > /etc/hostname
               hostname "$h" 2> /dev/null
               grep -q " $h" /etc/hosts || sed -i "s/^127.0.0.1.*/127.0.0.1 localhost $h/" /etc/hosts
               say_text "Hostname" "the appliance is now $h (and /etc/hosts agrees)"
           fi ;;
        *) return 0 ;;
        esac
    done
}

# 4 Models: what is downloaded, pull by Hub id, delete. All three are the release CLI's own verbs, with the
# appliance's key when it has one, so the menu cannot drift from what `lemonade` does from a shell.
item_models() {
    k=$(api_key); export LEMONADE_API_KEY="$k" LEMONADE_PORT=13305
    ids=$(api_get "$API/v1/models" -s -m 5 2>/dev/null |
        grep -o '"id":"[^"]*"' | cut -d'"' -f4)
    if [ "$NONINT" = 1 ]; then
        say "downloaded:"; printf '%s\n' "${ids:-<none>}"
        say "models-listed"; return 0
    fi
    while : ; do
        c=$(ui --title " Models " --menu "downloaded:
$(printf '%s\n' "${ids:-<none>}" | head -12)" 22 76 3 \
            1 "List downloaded models" 2 "Pull a model by Hugging Face id" 3 "Delete a downloaded model" \
            4 "Back") || c=4
        case $c in
        1) say_text "Models" "${ids:-no model downloaded}" ;;
        2) h=$(ui --title " Pull " --inputbox "Hugging Face id (e.g. Qwen/Qwen3-0.6B-GGUF)" 10 76 "") || h=""
           [ -n "$h" ] || continue
           ( ui --title " Pull " --infobox "pulling $h - this can take minutes" 6 70;
             timeout 3600 lemonade pull "$h" > /tmp/1bit-pull.log 2>&1 )
           say_text "Pull" "$(tail -12 /tmp/1bit-pull.log 2>/dev/null)" ;;
        3) [ -n "$ids" ] || { say_text "Models" "nothing downloaded"; continue; }
           pairs=""
           for i in $ids; do pairs="$pairs $i $i"; done
           # shellcheck disable=SC2086  # the pairs ARE words: dialog --menu takes tag/description pairs
           m=$(ui --title " Delete " --menu "which model" 20 76 10 $pairs) || continue
           yesno "Delete $m from this machine?" || continue
           lemonade delete "$m" > /tmp/1bit-delete.log 2>&1
           say_text "Delete" "$(tail -5 /tmp/1bit-delete.log 2>/dev/null)" ;;
        *) return 0 ;;
        esac
        ids=$(api_get "$API/v1/models" -s -m 5 2>/dev/null |
            grep -o '"id":"[^"]*"' | cut -d'"' -f4)
    done
}

# 5 The guarded installer the GRUB entry also runs. The menu does not grow a second copy of that logic.
item_install() {
    if [ ! -x /usr/local/bin/1bit-console-install ]; then
        say "no /usr/local/bin/1bit-console-install in this image"; return 1
    fi
    # INSTALLED: the brief's item 5 asks for this branch - the disk facts, not an install offer. Until now the console
    # offered the install on an installed box and the guard then refused the boot disk, which reads as a broken
    # install rather than as "this is already installed". NONINT still answers without a keyboard (vm-check's
    # `U2 menu actions` row greps `install-guard-checked`), and it now says which branch it answered from.
    if [ "$NONINT" = 1 ]; then
        if installed_mode; then
            say "installed: $(boot_disk) (data $(data_line))"
            say "install-guard-checked"; return 0
        fi
        /usr/local/bin/1bit-console-install --list 2>&1 | head -6
        say "install-guard-checked"; return 0
    fi
    if installed_mode; then
        d=$(boot_disk)
        say_text " 1bit OS - installed " "$(printf '%s\n' \
            "" \
            "1bit OS is INSTALLED on ${d:-the boot disk}." \
            "  $(lsblk -dpno SIZE,MODEL "${d:-/dev/null}" 2> /dev/null | head -1 | awk '{$1=$1; print}')" \
            "  data: $(data_line)" \
            "" \
            "  The install is permanent and nothing on this screen erases it." \
            "  Reboot to restart the installed system; remove the stick first." \
            "" \
            "  To install onto a DIFFERENT disk as well, answer yes next: ${d:-this disk}" \
            "  is this system's own disk, and the installer refuses it by name.")"
        yesno "Install 1bit OS onto a DIFFERENT disk as well?

Every disk you name is wiped. ${d:-The disk this system booted from} is refused by the installer and cannot be chosen." || return 0
    else
        yesno "Install 1bit OS to a disk?

The disk is wiped. The installer refuses this boot's own disk and asks for the whole device name." || return 0
    fi
    /usr/local/bin/1bit-console-install
}

# 6 The desktop, for this session only: the headless entry is the default, and a person who wants JWM now
# should not have to reboot. Cycle 16's board boot showed the cost of this item as it was written: pressing 6 RESET
# the machine, and nothing was kept to say why (C17 item 1). So the work is done by /usr/local/bin/1bit-desktop:
# the boot's logs are copied to /data/logs/<boot-id>/ first, xwin is started detached (this menu process stays
# alive on tty1 either way) with a PATH whose first entry refuses reboot/poweroff, and every artefact - xwin's own
# output, Xorg.0.log, xerrs.log - is copied out when the session ends. X failing can only return here.
item_desktop() {
    if [ ! -x "$DESKTOP" ]; then
        say "no $DESKTOP in this image - the desktop entry in the boot menu is the way in"
        return 1
    fi
    if [ "$NONINT" = 1 ]; then
        out=$("$DESKTOP" --check 2>&1)
        printf '%s\n' "$out"
        case $out in *desktop-available*) return 0 ;; *) return 1 ;; esac
    fi
    yesno "Start the desktop (JWM) for this session?

The desktop entry '1bit OS (desktop, JWM)' in the boot menu is the proven path. From here it is unproven on the
board, so this menu keeps running, logs the attempt to /data/logs, and refuses a reboot asked for by the session." || return 0
    "$DESKTOP"
    return 0
}

# 7 A shell, and the menu comes back on exit. This is the escape hatch for everything the menu does not do,
# and it is why ssh does not need the menu.
item_shell() {
    if [ "$NONINT" = 1 ]; then
        command -v bash > /dev/null 2>&1 || return 1
        say "shell: $(command -v bash)"; say "shell-bash"; return 0
    fi
    clear
    # tty1 is where a person is standing; a run over the serial console has no /dev/tty1, so fall back rather
    # than open a shell with a dead stdin and look like a hang
    if [ -e /dev/tty1 ]; then
        TERM=${TERM:-linux} bash -l < /dev/tty1 > /dev/tty1 2>&1
    else
        TERM=${TERM:-linux} bash -l
    fi
    return 0
}

# 8 Logs: what a person (and the next cycle) needs on this box, bounded, in one screen. The persistent copy is
# item 2's: /data/logs/<boot-id>/ keeps the last five boots, which is where an X session's evidence comes from now.
item_logs() {
    out=$(mktemp) || return 1
    bootlogs=$(/usr/local/bin/1bit-logs dir 2> /dev/null || true)
    {
        say "=== $LEMLOG (tail 40)"
        tail -40 "$LEMLOG" 2>/dev/null || say "(no $LEMLOG)"
        say ""
        say "=== dmesg (tail 25)"
        dmesg 2>/dev/null | tail -25 || say "(no dmesg)"
        if [ -n "$bootlogs" ] && [ -d "$bootlogs" ]; then
            say ""
            say "=== this boot's copy: $bootlogs"
            ls -1 "$bootlogs" 2>/dev/null | tr '\n' ' '
            say ""
            [ -s "$bootlogs/xwin-console.log" ] && { say "--- xwin-console.log (tail 12)"; tail -12 "$bootlogs/xwin-console.log"; }
            say ""
            say "=== boot proof: $([ -s "$bootlogs/boot-proof.txt" ] && echo "$bootlogs/boot-proof.txt ($(wc -l < "$bootlogs/boot-proof.txt") lines)" || echo "not written yet")"
            say "=== proof bundle: $(ls -1 /data/proof-*.tar.zst 2>/dev/null | tail -1 || true)"
        fi
    } > "$out"
    if [ "$NONINT" = 1 ]; then
        cat "$out"; rm -f "$out"; say "logs-shown"; return 0
    fi
    show_text "Logs" "$out"
    rm -f "$out"
    # Cycle 25, item 7: the bundle a release is published with. It is offered here, in the item about logs, rather
    # than as a tenth key: the console's legend is 1-9 and a person looking for "the evidence" looks under Logs.
    if [ -x /usr/local/bin/1bit-proof ]; then
        if yesno "Bundle this boot's evidence for the release?"; then
            clear
            /usr/local/bin/1bit-proof 2>&1 | tee -a /var/log/1bit-proof.log
            say ""
            say "press Enter to return"; read -r _ || true
        fi
    fi
}

# 9 Reboot or power off, confirmed. In test mode it says what it would do and touches nothing.
item_power() {
    if [ "$NONINT" = 1 ]; then say "power: would offer reboot/poweroff"; say "power-noop"; return 0; fi
    c=$(ui --title " Reboot / power off " --menu "what should the box do?" 14 60 2 \
        1 "Reboot" 2 "Power off") || return 0
    case $c in
    1) yesno "Reboot now?" && { clear; sync; reboot; } ;;
    2) yesno "Power off now?" && { clear; sync; poweroff; } ;;
    esac
    return 0
}

run_item() {   # run_item <1..9>
    case $1 in
    1) item_api_key ;;
    2) item_chat ;;
    3) item_network ;;
    4) item_models ;;
    5) item_install ;;
    6) item_desktop ;;
    7) item_shell ;;
    8) item_logs ;;
    9) item_power ;;
    *) say "no menu item '$1' (1..9)"; return 2 ;;
    esac
}

main_menu() {
    while : ; do
        if dialog_ok; then
            # the first screen is redrawn every 2 s until the address and Lemonade are both there, then it backs
            # off to 15: a booting appliance is the one time somebody is watching this box
            if net_up && lemonade_up; then tmo=15; else tmo=2; fi
            choice=$(ui --clear --backtitle "1bit OS - $(hostname_now) - $(release_tag)" \
                --title "1bit OS console" --timeout "$tmo" \
                --menu "$(screen_text)" 24 78 9 \
                1 "Show the API key" \
                2 "Quick chat test (GPU and NPU)" \
                3 "Network (DHCP, static, hostname)" \
                4 "Models (list, pull, delete)" \
                5 "Install 1bit OS to a disk" \
                6 "Start the desktop (JWM) for this session" \
                7 "Shell (bash, returns here on exit)" \
                8 "Logs (Lemonade, kernel)" \
                9 "Reboot / power off") || choice=""
        else
            choice=$(text_choice)
        fi
        case "${choice:-}" in
        1|2|3|4|5|6|7|8|9) run_item "$choice" ;;
        "") : ;;                       # timeout (255) or ESC: redraw with fresh status, never exit
        *) say "press a number 1-9" ;;
        esac
        sleep 1
    done
}

case "${1:-}" in
--status)   status_text; connect_text; menu_text; exit 0 ;;
--run)      [ $# -eq 2 ] || { say "usage: $0 --run <1..9>"; exit 2; }
            NONINT=1; run_item "$2"; exit $? ;;
--action)   [ $# -eq 2 ] || { say "usage: $0 --action <1..9>"; exit 2; }
            # ONE item, interactive, on this terminal (NONINT stays 0, so its dialogs work). 1bit-console-tui runs
            # this for keys 2-7: the TUI never grows a second copy of an action that needs a typed answer.
            run_item "$2"; exit $? ;;
--mint-selftest) [ $# -eq 2 ] || { say "usage: $0 --mint-selftest <dir>"; exit 2; }
            # Drives key_on/key_off on a throwaway conf and a no-op "restart": the file it writes, the mode it sets,
            # the lines it keeps and the one it removes. Nothing outside <dir> is touched and Lemonade is not
            # restarted, which is why this can run inside the image (vm-check's U3 key toggle row does).
            d=$2
            [ -d "$d" ] || { say "mint-selftest: $d is not a directory"; exit 2; }
            CONF=$d/lemond.conf; LEMOND_INIT=true; NONINT=1
            rc=0
            printf 'LEMONADE_PORT=13305\n#LEMONADE_ADMIN_API_KEY=x\n' > "$CONF" || exit 2
            # the log goes INSIDE the scratch dir, not a fixed /tmp path: a vm-check row and a person running the
            # selftest at the same time would interleave in one file (pi-prs on #936, the /tmp/oga_pack_import_test class)
            key_on > "$d/mint.log" 2>&1 || rc=1
            # grep -c prints 0 AND exits 1 when it finds nothing, so `|| echo 0` would make the value "0\n0" -
            # measured here (the first run of this selftest failed on exactly that)
            n=$(grep -c '^LEMONADE_API_KEY=' "$CONF" 2>/dev/null || true)
            hex=$(sed -n 's/^LEMONADE_API_KEY=\([0-9a-f]*\)$/\1/p' "$CONF" 2>/dev/null | head -1)
            mode=$(stat -c %a "$CONF" 2>/dev/null)
            kept=$(grep -c '^LEMONADE_PORT=13305$' "$CONF" 2>/dev/null || true)
            say "mint: lines=$n hex=${#hex} mode=$mode other-lines-kept=$kept"
            [ "$n" = 1 ] && [ ${#hex} -eq 48 ] && [ "$mode" = 600 ] && [ "$kept" = 1 ] || rc=1
            key_off > "$d/mint.log" 2>&1 || rc=1
            n2=$(grep -c '^LEMONADE_API_KEY=' "$CONF" 2>/dev/null || true)
            left=$([ -e "$CONF.new" ] && echo temp-file-left || echo clean)
            say "off:  lines=$n2 $left"
            [ "$n2" = 0 ] && [ "$left" = clean ] || rc=1
            [ "$rc" = 0 ] && say "mint-selftest-ok"
            exit "$rc" ;;
--selftest) NONINT=1; rc=0
            status_text
            for i in 1 2 3 4 5 6 7 8 9; do
                say "--- item $i"
                run_item "$i" || { say "item $i FAILED"; rc=1; }
            done
            [ "$rc" = 0 ] && say "menu-selftest-ok"
            exit "$rc" ;;
-h|--help)  sed -n "/^# Usage:/,/^# Exit:/p" "$0" | sed 's/^# \{0,1\}//' ;;
"")         main_menu ;;
*)          say "unknown argument '$1' (usage: $0 [--status|--run N|--selftest|--help])"; exit 2 ;;
esac
