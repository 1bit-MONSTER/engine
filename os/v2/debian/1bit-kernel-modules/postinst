# modules.dep & co for this kernel version, so a module is loadable the moment the package lands
# (initramfs-tools' own depmod run happens later, at the next initramfs build).
set -e
kver=@KVER@
if command -v depmod >/dev/null 2>&1; then
    depmod -a "$kver" || true
fi
exit 0
