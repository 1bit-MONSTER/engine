# engine#3310: agents installed with `npm i -g` (Node.js is in /usr/local/bin; npm's global prefix is /data/npm-global,
# set in /usr/local/lib/nodejs/etc/npmrc) are found by name, so `lemonade launch <agent>` finds them. Appended, so an
# installed package cannot shadow a system command.
case ":$PATH:" in *:/data/npm-global/bin:*) ;; *) PATH=$PATH:/data/npm-global/bin; export PATH ;; esac
