#
# What the engine needs from the kernel on top of the base config
# (docs/kernel.md). The base config had amdxdna switched off; the XDNA 2 NPU
# driver is built in-tree here.
CONFIG_DRM_ACCEL=y
CONFIG_DRM_ACCEL_AMDXDNA=m
CONFIG_DRM_AMDGPU=m
CONFIG_HSA_AMD=y
CONFIG_LOCALVERSION="-1bit"
# The base came from a distro CI build; its signing and trusted keys are not ours.
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
CONFIG_SYSTEM_TRUSTED_KEYS=""
CONFIG_SYSTEM_REVOCATION_KEYS=""
