# engine#3528: a login shell finds the Loom route exactly as Lemonade's own serves do. 10lemonade exports these two for
# lemond only, so `1bit serve -m <model>` from a shell looked for cards in ~/.cache/1bit/loom-cards (absent on the
# appliance) and took the llama.cpp route for a model that has a Loom route. The same values as 10lemonade: the cards
# 1bit-loom-cards assembles at boot (with their parameter/ links) and the payload's loom-serve. A value set already wins.
[ -z "${ONEBIT_LOOM_CARDS:-}" ] && [ -d /data/loom-cards ] && { ONEBIT_LOOM_CARDS=/data/loom-cards; export ONEBIT_LOOM_CARDS; }
[ -z "${ONEBIT_LOOM_SERVE:-}" ] && [ -x /opt/1bit-package/loom/loom-serve ] && { ONEBIT_LOOM_SERVE=/opt/1bit-package/loom/loom-serve; export ONEBIT_LOOM_SERVE; }
true
