# Fans and the power profile, on the boards we know (the logic lives in /usr/sbin/1bit-board, shipped
# by the engine package; on any other board every command of it writes nothing).
[Unit]
Description=1bit OS: fans and power profile
ConditionPathExists=/usr/sbin/1bit-board
ConditionPathExists=!/etc/1bit/power-skip
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/1bit/power
ExecStart=/usr/sbin/1bit-board curve
ExecStart=/usr/sbin/1bit-board power

[Install]
WantedBy=multi-user.target
