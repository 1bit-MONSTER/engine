# 1bit-pin-holdings.timer — 05:00 UTC daily (after the 04:30 census watch), persisted across downtime.

[Unit]
Description=Daily 1bit pin holdings check

[Timer]
OnCalendar=*-*-* 05:00:00 UTC
Persistent=true
Unit=1bit-pin-holdings.service

[Install]
WantedBy=timers.target
