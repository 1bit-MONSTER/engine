# /etc/init.d/05onboard-data - the 1BIT-DATA partition becomes /data, before anything that needs it.
#
# The contract is os/mini's, so os/mini/prepare-stick.sh and 1bit-usb-write.sh keep working on this
# image unchanged: /data carries models/, lemonade/{cache,config}/ + lemonade/lemond.conf (the one
# persistent API key), ssh/authorized_keys (and the host key), npu/kernels and cache/hrx-jit. What this
# script adds is the wiring: the API key file 10lemonade reads, the keys sshd uses, and Lemonade's own
# registry so the catalogue lists what is actually on the partition.
#
# rc.services runs /etc/init.d/* in name order, so 05 runs before 10lemonade and 20onboard-ssh.
DATA=/data
# rc.services calls every service with start at boot and stop at shutdown. Puppy's save layer is the folder
# /1bit on this same filesystem (psubdir), so it has to be clean before the shutdown write: sync and unmount
# rather than leave a filesystem mounted that Puppy is about to snapshot.
if [ "${1:-start}" = "stop" ]; then
    if grep -q " $DATA " /proc/mounts 2> /dev/null; then
        sync
        umount "$DATA" 2> /dev/null && echo "05onboard-data: $DATA unmounted for the save write"
    fi
    exit 0
fi
# os/mini #711: a fixed label is wrong once a machine is installed (two 1BIT-DATA partitions exist, the
# stick's and the disk's), so the boot line may name the partition. Default stays the label.
spec=LABEL=1BIT-DATA
case $(cat /proc/cmdline 2> /dev/null) in
*1bit.data=*) spec=$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^1bit.data=//p' | head -1) ;;
esac

i=0
part=
while [ $i -lt 20 ]; do
    part=$(findfs "$spec" 2> /dev/null) && break
    i=$((i + 1))
    sleep 1
done
if [ -z "$part" ]; then
    echo "05onboard-data: no $spec partition after 20 s: nothing on this boot persists"
    exit 0
fi
mkdir -p "$DATA"
mount -o rw "$part" "$DATA" 2> /dev/null || {
    echo "05onboard-data: cannot mount $part at $DATA: nothing on this boot persists" >&2
    exit 0
}
mkdir -p "$DATA/models" "$DATA/lemonade/cache" "$DATA/lemonade/config" "$DATA/ssh" \
    "$DATA/npu/kernels" "$DATA/cache/hrx-jit"

# The API key has to outlive the boot: 10lemonade reads /etc/1bit/lemond.conf and mints into it on first
# boot, and with this symlink in place that mint lands in lemonade/lemond.conf on the partition.
mkdir -p /etc/1bit
# engine#867: do NOT pre-create an empty lemond.conf. 10lemonade mints the key, and its guard used to be
# "does the file exist" - so a file created empty here meant the mint never ran and Lemonade came up on
# 0.0.0.0 with NO API key at all on any stick that did not go through prepare-stick --mint (measured on a
# dd-written stick: 200 without an Authorization header, on the second boot too). What this service owes the
# mint is the directory, and the symlink so the key lands on the partition.
mkdir -p "$DATA/lemonade" 2> /dev/null
if [ -f "$DATA/lemonade/lemond.conf" ]; then chmod 600 "$DATA/lemonade/lemond.conf"; fi
ln -sfn "$DATA/lemonade/lemond.conf" /etc/1bit/lemond.conf

# Keys come from the partition (os/mini's contract: prepare-stick.sh writes ssh/authorized_keys). The
# shipped /root/.ssh/authorized_keys stays as the fallback for a stick with no data partition yet.
if [ -s "$DATA/ssh/authorized_keys" ]; then
    mkdir -p /root/.ssh
    cp -f "$DATA/ssh/authorized_keys" /root/.ssh/authorized_keys
    chmod 700 /root/.ssh
    chmod 600 /root/.ssh/authorized_keys
    echo "05onboard-data: $(grep -c . /root/.ssh/authorized_keys) ssh key(s) from $DATA/ssh/authorized_keys"
fi
# A host key on the partition, so the fingerprint a client learned does not change every boot.
# Cycle 17: a ZERO-BYTE key is a state this lane has measured on a built image (`ls -l /data/ssh` = 0 bytes), and
# it defeats the code that follows - `[ -s ]` is false, so no symlink appears, sshd runs on the key the image
# shipped, and the appliance silently gets a different host identity after every boot while `data ssh` (the row
# that asserts the persistence) stays red. ssh-keygen will not overwrite a file that exists, so the size, not the
# existence, decides, and a key that cannot be minted says why instead of leaving an empty file behind.
if [ ! -s "$DATA/ssh/ssh_host_ed25519_key" ]; then
    rm -f "$DATA/ssh/ssh_host_ed25519_key" "$DATA/ssh/ssh_host_ed25519_key.pub"
    if ! ssh-keygen -q -t ed25519 -N "" -C "1bit-os" -f "$DATA/ssh/ssh_host_ed25519_key" 2> /tmp/1bit-sshkeygen.err; then
        echo "05onboard-data: no host key on $DATA: $(tail -1 /tmp/1bit-sshkeygen.err 2> /dev/null)" >&2
    fi
fi
if [ -s "$DATA/ssh/ssh_host_ed25519_key" ]; then
    ln -sfn "$DATA/ssh/ssh_host_ed25519_key" /etc/ssh/ssh_host_ed25519_key
    ln -sfn "$DATA/ssh/ssh_host_ed25519_key.pub" /etc/ssh/ssh_host_ed25519_key.pub
fi

# Sealed NPU kernel sets: the release check's `sealed` and `sealed-sig` rows read /data/npu/kernels, and the
# three sets the release package ships (256 KB each, manifest.json + manifest.sig over the ciphertext) are
# the method's only copy on the stick. Copied rather than linked so the partition keeps them when the
# package is replaced by an update; each set carries its own manifest, so a partial copy is a FAIL, not a
# silent half-set.
for set in /opt/1bit-package/1bit/npu/kernels/*/; do
    [ -d "$set" ] || continue
    n=${set%/}; n=${n##*/}
    if [ ! -d "$DATA/npu/kernels/$n" ]; then
        cp -a "$set" "$DATA/npu/kernels/$n" 2> /dev/null && echo "05onboard-data: NPU kernel set $n onto $DATA"
    fi
done

# Lemonade's registry, so /api/v1/models lists what is on the partition instead of only its catalogue.
# Same shape os/mini writes (a directory with model.q4nx is the NPU format, so it says onebit_backend
# npu; a .gguf is the HRX one). python3 is in this image, and it keeps the JSON valid.
#
# The NPU entry takes the CATALOGUE's own id for it (<name>-NPU-1bit) when the catalogue has one: the
# plain <name>-1bit is the catalogue's HRX id for the same model, so registering a q4nx directory under it
# put an NPU model behind the GPU id. Measured on the 2 Nov board: /v1/models listed one entry,
# Qwen3-0.6B-1bit, which is a catalogue HRX id serving an NPU model - and the release check's chat-hrx row
# would then have been answered by the NPU path and gone green for the wrong reason.
python3 - "$DATA" <<'PY' 2> /dev/null && echo "05onboard-data: Lemonade registry updated from $DATA/models"
import json, os, sys
data = sys.argv[1]
reg = os.path.join(data, "lemonade", "config", "user_models.json")
cat = {}
for c in ("/opt/1bit-package/bin/resources/server_models.json",
          "/opt/lemonade/bin/resources/server_models.json"):
    try:
        with open(c) as f:
            cat = json.load(f)
        break
    except Exception:
        continue

def catalogue_id(base, npu):
    """the id the shipped catalogue uses for this model, if it names one"""
    want = [base + ("-NPU-1bit" if npu else "-1bit"), base + "-1bit"]
    for wid in want:
        if isinstance(cat, dict) and wid in cat:
            return wid
    return None

models = []
mdir = os.path.join(data, "models")
for name in sorted(os.listdir(mdir)) if os.path.isdir(mdir) else []:
    path = os.path.join(mdir, name)
    if name.endswith(".gguf") and os.path.isfile(path):
        models.append((name[:-5].lower() + "-1bit", path, None))
    elif os.path.isfile(os.path.join(path, "model.q4nx")):
        models.append((catalogue_id(name, True) or name + "-1bit", path, "npu"))
try:
    with open(reg) as f:
        have = json.load(f)
    assert isinstance(have, dict)
except Exception:
    have = {}
changed = False
for name, path, backend in models:
    if name in have:
        continue
    # an id that is already registered is left alone: two models must never share one, and the existing
    # entry is the one the board has been serving from
    entry = {"checkpoint": path, "source": "local_path", "recipe": "onebit"}
    if backend:
        entry["recipe_options"] = {"onebit_backend": backend}
    have[name] = entry
    changed = True
if changed:
    tmp = reg + ".new"
    with open(tmp, "w") as f:
        json.dump(have, f, indent=2, sort_keys=True)
    os.replace(tmp, reg)
print("%d model(s) on the partition, %d in the registry" % (len(models), len(have)))
PY

# Sealed NPU kernel sets from the partition, exposed beside the engine: the package ships its own three in
# 1bit/npu/kernels, and a set staged on /data is otherwise invisible to it (pi-release's U4 finding). Each
# entry is linked, not the directory, because the directory already exists in the package.
for d in "$DATA"/npu/kernels/*; do
    [ -e "$d" ] || continue
    ln -sfn "$d" "/opt/1bit-package/1bit/npu/kernels/${d##*/}" 2> /dev/null
done

echo "05onboard-data: $part at $DATA ($(df -h "$DATA" 2> /dev/null | awk 'NR==2 {print $2" total, "$4" free"}'))"
