# The initramfs is initramfs-tools' job, as on any Ubuntu box: this image is on / on 1BIT-ROOT, so the
# initramfs only has to find the root device (no engine, no Lemonade, no 103 MB limit any more).
set -e
kver=@KVER@
if [ -x /usr/sbin/update-initramfs ]; then
    update-initramfs -c -k "$kver" || true
fi
exit 0
