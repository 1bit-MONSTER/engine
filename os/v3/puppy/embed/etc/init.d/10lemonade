# /etc/init.d/10lemonade - 1bit OS's server, started at boot.
#
# The contract is Puppy's, not systemd's (measured in a built resolute64 rootfs): /etc/rc.d/rc.services
# runs every EXECUTABLE script in /etc/init.d with `start` at boot and `stop` at shutdown, so this file
# has to be executable and nothing else registers it. (Ubuntu packages ship 295 files under
# /lib/systemd/system in that rootfs, but nothing reads them: PID 1 is not systemd.)
#
# What it starts is the release package's own launcher, which resolves lemond/the engine BESIDE ITSELF
# (LEMONADE_ONEBIT_BIN defaults to $here/1bit/1bit), so the whole package lives in one directory and
# nothing has to be on PATH. The two pieces of configuration:
#   /etc/1bit/lemond.conf   LEMONADE_API_KEY=... (mode 600) - only when a person turned one on (cycle 20)
#   /etc/1bit/libhsa.env    optional; what the release build pins for HRX (v2's lemond unit used the same
#                           file as its EnvironmentFile, so an image built for v2 stays valid)
LEMONADE_ONEBIT=/opt/1bit-package/lemond-onebit
CONF=/etc/1bit/lemond.conf
ENVFILE=/etc/1bit/libhsa.env
LOG=/var/log/lemond-onebit.log
PORT=13305
PIDFILE=/run/lemond-onebit.pid

start() {
    [ -x "$LEMONADE_ONEBIT" ] || { echo "10lemonade: $LEMONADE_ONEBIT is missing, nothing to start" >&2; return 0; }
    # the NPU driver wants unlimited locked pages and there is no systemd LimitMEMLOCK= here
    ulimit -l unlimited 2>/dev/null
    # shellcheck disable=SC1090  # the release build pins what HRX needs; the file may not exist
    if [ -f "$ENVFILE" ]; then . "$ENVFILE"; fi
    # Cycle 20, the owner's "blank key" decision (2026-11-03 ~20:1x): the appliance ships like stock Lemonade,
    # i.e. with NO LEMONADE_API_KEY, and a key is something a person turns ON from the console (menu item 1 mints
    # it, writes this file and restarts this service). Nothing mints here any more: an appliance that invents a
    # secret its owner never saw is how "where do I get the key" became the first question on every boot.
    #
    # What stays forbidden is the third state - an EMPTY assignment. It reads as "keyed" to every script that greps
    # for the line and as "no key" to lemond, which is engine#867's dd-written stick (0-byte file, 200 without an
    # Authorization header). So: no key line = blank mode, an empty one is treated as none, and the mode is logged.
    key=$(sed -n 's/^LEMONADE_API_KEY=//p' "$CONF" 2> /dev/null | head -1)
    # a shipped file may carry more than the key (v2's unit read the same path as an EnvironmentFile)
    # shellcheck disable=SC1090  # the file is the appliance's own env file
    if [ -s "$CONF" ]; then . "$CONF"; fi
    key=${LEMONADE_API_KEY:-$key}
    if [ -n "$key" ]; then
        export LEMONADE_API_KEY="$key"
        echo "10lemonade: API key required (keyed mode, $CONF) - menu item 1 turns it off"
    else
        unset LEMONADE_API_KEY
        echo "10lemonade: no API key (blank mode): anyone on this network can use Lemonade - menu item 1 requires one"
    fi
    # Where Lemonade keeps its state is os/mini's data contract: /data/lemonade/{cache,config}, so the
    # catalogue, downloaded backends and the HRX JIT cache survive a reboot. Without a data partition it
    # lives in RAM and says so, rather than pretending to persist.
    if grep -q " /data " /proc/mounts 2> /dev/null; then
        LEM=/data/lemonade
        MODELS=/data/models
        export GGML_HRX_JIT_CACHE_DIR=/data/cache/hrx-jit
    else
        LEM=/var/lib/lemonade
        MODELS=$LEM/models
        echo "10lemonade: no /data partition: Lemonade state is in RAM, nothing persists"
    fi
    mkdir -p "$LEM/cache" "$LEM/config" "$MODELS"
    # Cycle 25, owner: "log verbose it all for proof". lemond's verbosity is a config.json key, NOT a flag and NOT an
    # env var (measured on the pinned build: `lemond --help` has only -v/--version, and the accepted strings come from
    # AixLog::to_severity in runtime_config.cpp: trace|debug|info|warning|error|fatal|none, default info).
    # debug, not trace: measured on this box, `log_level: debug` prints "Debug logging enabled - subprocess output will
    # be visible" - that is the line that puts the ENGINE's own `1bit serve:` output into lemond.log, and so into
    # /data/logs. trace is per-token chatter and would spend the whole 50 MB/hour evidence budget on itself.
    # The rotation caps live in the same object: one laptop demo must not fill the data partition.
    # A level somebody set is never overwritten - it is theirs, and the console's menu is where they set it.
    CONFJSON=$LEM/config/config.json
    if [ ! -f "$CONFJSON" ]; then
        printf '%s\n' "{\"log_level\": \"debug\", \"log_max_file_size_mb\": 8, \"log_max_files\": 3, \"extra_models_dir\": \"$MODELS\", \"auto_check_model_updates\": false, \"inhibit_suspend\": false}" > "$CONFJSON" \
            && echo "10lemonade: seeded $CONFJSON (log_level=debug, 8 MB x 3 rotation, extra_models_dir=$MODELS, no startup update check, no logind inhibitor)"
    elif ! grep -q '"log_level"' "$CONFJSON" 2> /dev/null; then
        if command -v python3 > /dev/null 2>&1; then
            python3 - "$CONFJSON" <<'PY' && echo "10lemonade: added log_level=debug to $CONFJSON"
import json, sys
p = sys.argv[1]
d = json.load(open(p))
d.setdefault("log_level", "debug")
d.setdefault("log_max_file_size_mb", 8)
d.setdefault("log_max_files", 3)
json.dump(d, open(p, "w"), indent=2)
PY
        else
            echo "10lemonade: $CONFJSON has no log_level and python3 is missing - the demo runs at lemond's default" >&2
        fi
    else
        echo "10lemonade: honouring the log_level already in $CONFJSON"
    fi
    # Cycle 26: lemond only scans a models directory when `extra_models_dir` is set - ScanCatalog::enumerate() returns
    # nothing for an empty setting - so files staged in /data/models were invisible and the catalogue read "none
    # downloaded" while they sat on the medium. Measured on the shipping payload: 213 rows without the key, 214 with it,
    # the extra row `Qwen3-0.6B-Q8_0 | source: extra_models_dir`. Seeded on its own and only when absent, so a config that
    # already carries the key (the stick writer stages one) keeps the value it has.
    if ! grep -q '"extra_models_dir"' "$CONFJSON" 2> /dev/null; then
        if command -v python3 > /dev/null 2>&1; then
            python3 - "$CONFJSON" "$MODELS" <<'PY' && echo "10lemonade: added extra_models_dir=$MODELS to $CONFJSON"
import json, sys
p, models = sys.argv[1], sys.argv[2]
d = json.load(open(p))
d.setdefault("extra_models_dir", models)
json.dump(d, open(p, "w"), indent=2)
PY
        else
            echo "10lemonade: $CONFJSON has no extra_models_dir and python3 is missing - models in $MODELS stay invisible" >&2
        fi
    fi
    # Cycle 30, from the c29 take's own log (TNOTE-c29-take-review items 3 and 4): two lemond keys that turned a
    # clean boot into noise, both read from the pinned payload's own strings (no flag and no env var: `lemond
    # --help` has only -v/--version, so config.json is the only place these can be set).
    #   auto_check_model_updates - the startup Hugging Face check. Offline it logs `Model update check failed for
    #     <model>: CURL error: Could not resolve hostname` once per catalogue model (9 lines on the take); online
    #     it can move a model under a demo that pinned one. The manual `models/check_updates` route still runs
    #     with this false - the payload says so itself - so nothing becomes impossible to ask for.
    #   inhibit_suspend - the logind inhibitor; Puppy has no logind, so it logs `logind Inhibit failed`.
    # Seeded only when absent, like the keys above: a config a person edited keeps the value it was given.
    if ! grep -q '"auto_check_model_updates"' "$CONFJSON" 2> /dev/null || ! grep -q '"inhibit_suspend"' "$CONFJSON" 2> /dev/null; then
        if command -v python3 > /dev/null 2>&1; then
            python3 - "$CONFJSON" <<'PY' && echo "10lemonade: added auto_check_model_updates=false and inhibit_suspend=false to $CONFJSON"
import json, sys
p = sys.argv[1]
d = json.load(open(p))
d.setdefault("auto_check_model_updates", False)
d.setdefault("inhibit_suspend", False)
json.dump(d, open(p, "w"), indent=2)
PY
        else
            echo "10lemonade: $CONFJSON lacks auto_check_model_updates/inhibit_suspend and python3 is missing - lemond will log a failed update check and a logind warning at boot" >&2
        fi
    fi
    # lemond's positionals are cache_dir config_dir (lemond --help); the rest are the runtime overrides.
    # Blank mode is LAN-reachable on purpose: the appliance is a server, Lemonade's own web UI and Lemonade Mobile
    # are the two clients the owner demos, and neither asks for a key on stock Lemonade. The console's CONNECT block
    # says so in those words, and menu item 1 is the way to close it.
    host=0.0.0.0
    "$LEMONADE_ONEBIT" "$LEM/cache" "$LEM/config" --port "$PORT" --host "$host" >> "$LOG" 2>&1 &
    echo $! > "$PIDFILE"
    echo "10lemonade: started (pid $(cat "$PIDFILE"), :$PORT, log $LOG)"
}

stop() {
    [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
}

case ${1:-start} in
start) start ;;
stop) stop ;;
restart) stop; sleep 1; start ;;
status) [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null && echo running || echo stopped ;;
*) echo "usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
