# Keeps the console's Chat UI line true: written 20 s after boot (a first start is minutes of pulling,
# and the boot must not wait for it) and re-probed once a minute, so the line says (up) as soon as the
# container answers and (starting) again if it stops. One HTTP GET a minute.
[Unit]
Description=1bit OS: keep the console's Chat UI line current
Documentation=https://1bit.gg

[Timer]
OnBootSec=20
OnUnitActiveSec=60
Unit=1bit-openwebui-console.service

[Install]
WantedBy=timers.target
