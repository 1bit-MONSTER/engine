# 1bit-webapp-proxy - serve /opt/1bit/webapp and hand the Lemonade API key to the page without a URL.
#
# Cycle 17 item 8, from the demo recording: the desktop autostart opened
#   http://localhost:8080/?key=93112a22cafee2ad…
# so the appliance's bearer token sat in the address bar, in the browser's history and in every frame of the
# recording. The key belongs in a header, not in a URL a person (or a camera) can read:
#
#   * this process serves the chat page on 127.0.0.1:8080 exactly as `python3 -m http.server` did, and
#   * it forwards /api/… to Lemonade on 127.0.0.1:13305 with `Authorization: Bearer <key from lemond.conf>`
#     added to the request. The page then has no key at all - it uses same-origin URLs - and streaming works
#     because the response is copied through in 4 KiB chunks, not buffered.
#
# Loopback only, in both directions: the page is not exposed to the LAN (it never was) and the injected header
# cannot be used as a general proxy for it (only /api/ and /internal/ are forwarded, and the key is the one this
# machine minted). Nothing is written: the directory is served read-only, as before.
import http.client
import json
import os
import re
import subprocess
import sys
import threading
import time
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer

APP = os.environ.get("ONEBIT_WEBAPP_APP", "/opt/1bit/webapp")
CONF = os.environ.get("ONEBIT_WEBAPP_CONF", "/etc/1bit/lemond.conf")
PORT = int(os.environ.get("ONEBIT_WEBAPP_PORT", "8080"))
UPSTREAM = ("127.0.0.1", int(os.environ.get("ONEBIT_WEBAPP_UPSTREAM_PORT", "13305")))
FORWARD = ("/api/", "/internal/")
HOP = ("connection", "keep-alive", "transfer-encoding", "content-length", "host", "authorization")
# Cycle 20, item 5 (the c19 board's local-hardening check): this process attaches the appliance's key to whatever it
# forwards, so a page from ANYwhere must not be able to borrow it. A browser sends Origin on every cross-origin
# request, so the rule is: an Origin that is not this proxy's own loopback page is refused BEFORE the key is added.
# A request with no Origin at all is not a browser (curl, this image's own rows, Lemonade Mobile) and is served as
# before - the surface that stays closed is the one a hostile page in the box's own browser would use.
ALLOWED_ORIGINS = {"http://localhost:%d" % PORT, "http://127.0.0.1:%d" % PORT}
# engine#3478: a held turn waits inside Lemonade (the hold is taken by 1bit-heavy, POST /api/v1/hold) with NO bytes on
# the wire until the hold ends, and the page's own fetch has no timeout (embed/opt/1bit/webapp/index.html:232) - so the
# upstream socket timeout below is the only deadline a held turn has. It is http.client's timeout, which applies to each
# blocking socket operation (the connect, each read), not to the request as a whole: it bounds the longest SILENCE on the
# upstream socket, and a streamed answer that keeps sending bytes can run past it. It was a hardcoded 900 s while 1bit-heavy's
# default hold window is 3600 s: a hold between 15 and 60 minutes cut the page's turn (a 502 that reads as "Lemonade is
# not answering") while the hold was healthy. The bound is the hold window plus the resume every request had to allow
# anyway: when the hold ends the captured models reload before the waiting request runs (measured first loads: 93 s on
# a stick, 154 s on an installed disk, docs/releases.md), then it prefills and answers. 900 s is that old, previously
# allowed silence, so a request whose longest silence used to fit inside the socket timeout still fits after a hold.
HOLD_WINDOW = 3600            # 1bit-heavy's --max-seconds default; tests/webapp_proxy_hold_timeout_test.sh fails if the two differ
RESUME_GRACE = 900            # the per-read socket timeout this proxy used to allow: kept for the reload after a hold
# ONEBIT_WEBAPP_UPSTREAM_TIMEOUT scales the bound (the test drives it in seconds; an operator can raise it for a slower
# box). A hold taken with a --max-seconds above the window can still outlast it, and the page's turn is cut at this
# bound; os/v3/puppy/README.md states both numbers next to the wrapper.
DEFAULT_UPSTREAM_TIMEOUT = HOLD_WINDOW + RESUME_GRACE


def upstream_timeout(raw):
    """The bound from the env value: a positive integer of seconds, else the default with a note on stderr.

    A bad value used to raise ValueError at import, so a typo in the unit's environment stopped the chat page from
    starting at all. Empty or unset is the default, silently.
    """
    if raw is None or not raw.strip():
        return DEFAULT_UPSTREAM_TIMEOUT
    try:
        value = int(raw.strip())
    except ValueError:
        value = 0
    if value <= 0:
        sys.stderr.write("1bit-webapp-proxy: ONEBIT_WEBAPP_UPSTREAM_TIMEOUT=%r is not a positive whole number of "
                         "seconds; using the default %d s\n" % (raw, DEFAULT_UPSTREAM_TIMEOUT))
        return DEFAULT_UPSTREAM_TIMEOUT
    return value


UPSTREAM_TIMEOUT = upstream_timeout(os.environ.get("ONEBIT_WEBAPP_UPSTREAM_TIMEOUT"))


# ── OS updater U5 (local): the update page's API, on its own loopback listener (UPDATE_PORT, below) ─────────────────────────────────────────
# Owner decision via the orchestrator, 27 Nov: the update page is loopback-only by default; a LAN page only once a
# credential is set on the box (a later step). This proxy runs as ROOT and serves requests with no Origin, so the
# loopback rule alone would let any LOCAL process - a non-root daemon, a sandboxed user - make root install, roll the
# box back to an older release (one with known holes) or reboot it. So:
#   GET  /1bit/update/status     1bit-update --status + --check, and the last action's progress: open on loopback
#   GET  /1bit/update/progress   the last action's state and log tail only (cheap: the page polls it)
#   POST /1bit/update/latest     {"confirm": "<the tag --check offers>"}  install the newest signed release
#   POST /1bit/update/rollback   {"confirm": "<the other slot's name>"}    boot the other slot next
#   POST /1bit/update/reboot     {"confirm": "reboot"}
# A POST is served only when the CLIENT's socket belongs to uid 0 - read from /proc/net/tcp, the kernel's own record,
# which a process cannot forge (the box's desktop browser runs as root; spot, daemons and sandbox users do not) - and
# it must carry X-1bit-Update: 1 (a cross-site page cannot set that header without a CORS preflight this proxy never
# answers) and pass the Origin rule above. One action at a time; its output goes to a log the status shows.
# WHICH RULE STOPS WHAT (review cl-flm): the uid check stops NON-ROOT local processes. It does not stop a ROOT daemon
# that can be made to relay a request (lemond runs as root and listens on the LAN; a provider/base-URL or "fetch this
# URL" feature makes requests from a uid-0 socket). Against those, the boundary is X-1bit-Update + the exact JSON
# confirmation: a relayed request controls neither. Neither of them is redundant; do not drop one for the other.
# The child gets a FIXED environment (PATH, LANG): 1bit-update reads its trust anchor and verifier overrides
# (ONEBIT_UPDATE_PUB/_VERIFIER/_ANY/_API_JSON) from the environment, and this proxy's own must never reach it.
_AS_ROOT = os.geteuid() == 0
UPDATE_BIN = "/usr/local/bin/1bit-update" if _AS_ROOT else os.environ.get("ONEBIT_UPDATE_BIN", "/usr/local/bin/1bit-update")
UPDATE_LOG = "/var/log/1bit-update-web.log" if _AS_ROOT else os.environ.get("ONEBIT_WEBAPP_UPDATE_LOG", "/var/log/1bit-update-web.log")
CHILD_ENV = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C"}
# TEST hooks, inert when this process is root (as it always is on the box): the uid treated as the administrator,
# and a command that stands in for reboot (and, above, the 1bit-update binary and the log path)
_TEST_ADMIN = os.environ.get("ONEBIT_WEBAPP_TEST_ADMIN_UID", "")
ADMIN_UID = int(_TEST_ADMIN) if (_TEST_ADMIN.isdigit() and not _AS_ROOT) else 0
REBOOT_CMD = ["reboot"] if _AS_ROOT or not os.environ.get("ONEBIT_WEBAPP_TEST_REBOOT") else \
    os.environ["ONEBIT_WEBAPP_TEST_REBOOT"].split()
# ITS OWN ORIGIN (reviews cl-pragent, cl-qat): the update API trusts a same-origin script completely (it can send the
# header without a preflight and read the expected confirmation from status), and 127.0.0.1:8080 also serves whatever
# Lemonade returns under /api/ and /internal/ - an HTML error page or a future route there would run with the power
# to make root roll back or reboot. So the update page and its API live on 127.0.0.1:8081, which serves nothing else,
# with a CSP of default-src 'self' and no framing; :8080 serves neither.
UPDATE_PORT = 8081 if _AS_ROOT else int(os.environ.get("ONEBIT_WEBAPP_UPDATE_PORT", "8081"))
UPDATE_ORIGINS = {"http://localhost:%d" % UPDATE_PORT, "http://127.0.0.1:%d" % UPDATE_PORT}
SECURITY_HEADERS = (("Content-Security-Policy", "default-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"),
                    ("X-Frame-Options", "DENY"), ("X-Content-Type-Options", "nosniff"), ("Referrer-Policy", "no-referrer"),
                    ("Cache-Control", "no-store"))
# status's --check is cached (it is open to every local process, and GitHub allows 60 unauthenticated calls an hour:
# a polling loop would starve the box's real checks); an install always runs a fresh one
CHECK_TTL = 300.0
_check = {"t": 0.0, "out": "", "lock": threading.Lock()}


def cached_check():
    with _check["lock"]:
        if time.time() - _check["t"] < CHECK_TTL:
            return _check["out"]
    rc, out = run_text(["--check"])
    with _check["lock"]:
        _check.update(t=time.time(), out=out)
    return out


_job = {"running": False, "action": "", "rc": None, "started": 0.0}
_job_lock = threading.Lock()


def _hexaddr(a):
    ip, port = a.split(":")
    return ".".join(str(int(ip[i:i + 2], 16)) for i in (6, 4, 2, 0)), int(port, 16)


def peer_uid(client, server_port, table="/proc/net/tcp"):
    """the uid owning the client end of a loopback TCP connection to server_port, or None"""
    try:
        with open(table) as f:
            next(f)
            for line in f:
                c = line.split()
                if len(c) < 8:
                    continue
                if _hexaddr(c[1]) == (client[0], client[1]) and _hexaddr(c[2])[1] == server_port:
                    return int(c[7])
    except (OSError, ValueError, StopIteration):
        pass
    return None


def run_text(args, timeout=90):
    try:
        r = subprocess.run([UPDATE_BIN] + args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=timeout,
                           stdin=subprocess.DEVNULL, env=dict(CHILD_ENV))
        return r.returncode, r.stdout.decode("utf-8", "replace")
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, "1bit-update did not run: %s" % e


def offered_tag(check_out):
    """the tag --check offers when it says an update is available, else ''"""
    if "an update is available" not in check_out:
        return ""
    m = re.search(r"^(?:stable|test): (v[0-9]{4}\.[0-9]{1,2}(?:-rc[0-9]+)?) ", check_out, re.M)
    return m.group(1) if m else ""


def other_slot(status_out):
    m = re.search(r"active slot = (\S+)", status_out)
    if not m:
        return ""
    return "1bit-alt" if m.group(1) == "1bit" else "1bit" if m.group(1) == "1bit-alt" else ""


def log_tail(n=4000):
    try:
        with open(UPDATE_LOG, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - n))
            return f.read().decode("utf-8", "replace")
    except OSError:
        return ""


def start_job(action, argv):
    """run one action in the background; False when one is already running"""
    with _job_lock:
        if _job["running"]:
            return False
        _job.update(running=True, action=action, rc=None, started=time.time())
    def work():
        rc = 127
        try:
            fd = os.open(UPDATE_LOG, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "wb") as log:
                log.write(("== %s (%s)\n" % (action, time.strftime("%Y-%m-%d %H:%M:%S"))).encode())
                log.flush()
                rc = subprocess.call(argv, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                     env=dict(CHILD_ENV))
        except OSError:
            pass
        with _job_lock:
            _job.update(running=False, rc=rc)
    threading.Thread(target=work, daemon=True).start()
    return True


def api_key():
    """The key 10lemonade minted; empty if there is none (Lemonade then answers 401 and the page says so)."""
    try:
        with open(CONF, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                if line.startswith("LEMONADE_API_KEY="):
                    return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return ""


class Handler(SimpleHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def __init__(self, *a, **kw):
        super().__init__(*a, directory=APP, **kw)

    def log_message(self, fmt, *args):  # one line per request, never headers (the key never appears here)
        sys.stderr.write("%s %s\n" % (self.log_date_time_string(), fmt % args))

    def _forward(self):
        origin = self.headers.get("Origin")
        if origin and origin not in ALLOWED_ORIGINS:
            msg = ("1bit-webapp-proxy: refused a cross-origin request from %s (only this box's own page may use "
                   "the key)\n" % origin).encode()
            self.send_response(403)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(msg)))
            self.end_headers()
            self.wfile.write(msg)
            return
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length > 0 else None
        headers = {k: v for k, v in self.headers.items() if k.lower() not in HOP}
        key = api_key()
        if key:
            headers["Authorization"] = "Bearer " + key
        try:
            conn = http.client.HTTPConnection(*UPSTREAM, timeout=UPSTREAM_TIMEOUT)
            conn.request(self.command, self.path, body=body, headers=headers)
            resp = conn.getresponse()
        except OSError as e:
            # Lemonade not up yet is the ordinary case at boot; the page shows the text and stays usable.
            msg = ("1bit-webapp-proxy: Lemonade is not answering on %s:%d (%s)\n"
                   % (UPSTREAM[0], UPSTREAM[1], e)).encode()
            self.send_response(502)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(msg)))
            self.end_headers()
            self.wfile.write(msg)
            return
        try:
            self.send_response(resp.status)
            for k, v in resp.getheaders():
                if k.lower() in HOP:
                    continue
                self.send_header(k, v)
            # no length: the body is delimited by the close, so SSE arrives as it is produced
            self.send_header("Connection", "close")
            self.end_headers()
            self.close_connection = True
            read = getattr(resp, "read1", resp.read)
            while True:
                chunk = read(4096)
                if not chunk:
                    break
                self.wfile.write(chunk)
                self.wfile.flush()
        finally:
            conn.close()

    def do_GET(self):
        if self.path.split("?", 1)[0] in ("/update.html", "/update.js", "/update.css") or self.path.startswith("/1bit/update/"):
            return self.send_error(404, "the update page is on http://127.0.0.1:%d/" % UPDATE_PORT)
        return self._forward() if self.path.startswith(FORWARD) else super().do_GET()

    def do_HEAD(self):
        return self._forward() if self.path.startswith(FORWARD) else super().do_HEAD()

    def do_POST(self):
        return self._forward() if self.path.startswith(FORWARD) else self.send_error(405)

    def do_DELETE(self):
        return self._forward() if self.path.startswith(FORWARD) else self.send_error(405)

    def do_PUT(self):
        return self._forward() if self.path.startswith(FORWARD) else self.send_error(405)


class UpdateHandler(SimpleHTTPRequestHandler):
    """127.0.0.1:UPDATE_PORT: the update page and its API, nothing else (its own origin)"""
    protocol_version = "HTTP/1.1"

    def __init__(self, *a, **kw):
        super().__init__(*a, directory=APP, **kw)

    def log_message(self, fmt, *args):
        sys.stderr.write("%s update %s\n" % (self.log_date_time_string(), fmt % args))

    def end_headers(self):
        for k, v in SECURITY_HEADERS:
            self.send_header(k, v)
        super().end_headers()

    def _is_admin(self):
        """loopback: the client socket's owner is root (see the update section's comment)"""
        return peer_uid(self.client_address, UPDATE_PORT) == ADMIN_UID

    def _json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _update(self):
        origin = self.headers.get("Origin")
        if origin and origin not in UPDATE_ORIGINS:
            return self._json(403, {"error": "cross-origin requests may not use the update page"})
        path = self.path.split("?", 1)[0]
        if self.command == "GET" and path == "/1bit/update/status":
            rs, st = run_text(["--status"])
            ck = cached_check()
            with _job_lock:
                job = dict(_job)
            return self._json(200, {"status": st, "check": ck, "offered": offered_tag(ck), "rollback_to": other_slot(st),
                                    "job": job, "log": log_tail(), "admin": self._is_admin()})
        if self.command == "GET" and path == "/1bit/update/progress":
            with _job_lock:
                job = dict(_job)
            return self._json(200, {"job": job, "log": log_tail()})
        if self.command != "POST" or path not in ("/1bit/update/latest", "/1bit/update/rollback", "/1bit/update/reboot"):
            return self._json(404, {"error": "no such update action"})
        if self.headers.get("X-1bit-Update") != "1":
            return self._json(403, {"error": "missing X-1bit-Update: 1"})
        if not self._is_admin():
            return self._json(403, {"error": "install, rollback and reboot are for root on this box (the box's own "
                                              "desktop session, or a root shell: curl); this client is not root"})
        try:
            n = int(self.headers.get("Content-Length") or 0)
            req = json.loads(self.rfile.read(n) if 0 < n <= 4096 else b"{}")
            confirm = str(req.get("confirm", ""))
        except (ValueError, AttributeError):
            return self._json(400, {"error": "the body must be JSON {\"confirm\": ...}"})
        if path == "/1bit/update/latest":
            rc, ck = run_text(["--check"])
            want = offered_tag(ck)
            if not want:
                return self._json(409, {"error": "no update is available now", "check": ck})
            if confirm != want:
                return self._json(400, {"error": "type the offered release, %s, to confirm" % want})
            argv, action = [UPDATE_BIN, "--latest"], "install " + want
        elif path == "/1bit/update/rollback":
            rs, st = run_text(["--status"])
            want = other_slot(st)
            if not want:
                return self._json(409, {"error": "the other slot could not be told from 1bit-update --status"})
            if confirm != want:
                return self._json(400, {"error": "type the slot to roll back to, %s, to confirm" % want})
            argv, action = [UPDATE_BIN, "--rollback"], "roll back to " + want
        else:
            if confirm != "reboot":
                return self._json(400, {"error": "type reboot to confirm"})
            argv, action = list(REBOOT_CMD), "reboot"
        if not start_job(action, argv):
            return self._json(409, {"error": "an update action is already running", "job": _job["action"]})
        return self._json(202, {"started": action})

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path.startswith("/1bit/update/"):
            return self._update()
        if path in ("/", "/update.html", "/update.js", "/update.css"):
            self.path = "/update.html" if path == "/" else path
            return super().do_GET()
        return self._json(404, {"error": "only the update page is served here"})

    def do_POST(self):
        if self.path.startswith("/1bit/update/"):
            return self._update()
        return self._json(404, {"error": "only the update page is served here"})

    def do_HEAD(self):
        return self._json(405, {"error": "not here"})

    do_PUT = do_DELETE = do_HEAD


def serve_update():
    try:
        u = ThreadingHTTPServer(("127.0.0.1", UPDATE_PORT), UpdateHandler)
    except OSError as e:
        print("1bit-webapp-proxy: the update page could not bind 127.0.0.1:%d (%s)" % (UPDATE_PORT, e), flush=True)
        return None
    u.daemon_threads = True
    threading.Thread(target=u.serve_forever, daemon=True).start()
    print("1bit-webapp-proxy: update page on http://127.0.0.1:%d/" % UPDATE_PORT, flush=True)
    return u


def port_holder(port):
    """Who is listening on 127.0.0.1:<port>, as "pid <pid> (<cmdline>)", from /proc alone (c19/c20 board).

    The board's log had a bare traceback - `OSError: [Errno 98] Address already in use` - which says something
    already serves 8080 but not what, and a booting stick cannot be ssh'd into to look. This answers it in the
    log: the LISTEN socket's inode from /proc/net/tcp, then the process holding that inode. Returns None when any
    of that is unavailable, and never raises: it runs on a failure path.
    """
    want = "%04X" % port
    inos = set()
    try:
        with open("/proc/net/tcp", "r", encoding="ascii", errors="replace") as f:
            for line in f.readlines()[1:]:
                f_ = line.split()
                if len(f_) < 10 or f_[3] != "0A":        # 0A = TCP_LISTEN
                    continue
                addr, _, p = f_[1].rpartition(":")
                if p.upper() == want and addr.upper() in ("0100007F", "00000000"):
                    inos.add("socket:[%s]" % f_[9])
    except OSError:
        return None
    if not inos:
        return None
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            for fd in os.listdir("/proc/%s/fd" % pid):
                try:
                    if os.readlink("/proc/%s/fd/%s" % (pid, fd)) in inos:
                        with open("/proc/%s/cmdline" % pid, "rb") as c:
                            cmd = " ".join(c.read().replace(b"\0", b" ").decode("utf-8", "replace").split())
                        return "pid %s (%s)" % (pid, cmd[:200])
                except OSError:
                    continue
        except OSError:
            continue
    return None


def main():
    if not os.path.isfile(os.path.join(APP, "index.html")):
        sys.exit("1bit-webapp-proxy: no %s/index.html" % APP)
    # Bind, or say who has the port (c19/c20 board: a bare traceback told the next reader nothing). Retried
    # briefly first, because init scripts can start this twice within a second and the loser should not shout.
    srv = None
    for attempt in range(5):
        try:
            srv = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
            break
        except OSError as e:
            if e.errno != 98:                            # EADDRINUSE is the only one worth retrying
                raise
            if attempt < 4:
                time.sleep(1)
                continue
            holder = port_holder(PORT)
            if holder and "webapp-proxy" in holder:
                print("1bit-webapp-proxy: another instance already serves 127.0.0.1:%d (%s); nothing to do"
                      % (PORT, holder))
                return                     # the page is served; only the second copy stops
            sys.exit("1bit-webapp-proxy: 127.0.0.1:%d is held by %s - the chat page is not served from here "
                     "until it is free" % (PORT, holder or "a process /proc does not show"))
    if srv is None:
        sys.exit("1bit-webapp-proxy: could not bind 127.0.0.1:%d" % PORT)
    srv.daemon_threads = True
    serve_update()
    print("1bit-webapp-proxy: serving %s on 127.0.0.1:%d, /api/ -> %s:%d%s"
          % (APP, PORT, UPSTREAM[0], UPSTREAM[1],
             "" if api_key() else " (no API key in %s)" % CONF), flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
