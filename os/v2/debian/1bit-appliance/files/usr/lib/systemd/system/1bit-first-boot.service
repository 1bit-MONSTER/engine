# Once, on the first boot of an installed machine: what a fresh install cannot carry - SSH host keys
# of its own (the live image's are public by definition) and the installed marker.
[Unit]
Description=1bit OS: first-boot setup
ConditionPathExists=!/etc/1bit/installed
After=local-fs.target
Wants=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/1bit/first-boot.sh

[Install]
WantedBy=multi-user.target
