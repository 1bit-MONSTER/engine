From 5d7b464a4f5b0e2ac1e9b4d3f1a2c7e8d9b0a1c2d3 Mon Sep 17 00:00:00 2001
From: Eva Crystal <upstream@drm-misc>
Date: Sat, 3 Oct 2026 00:00:00 +0000
Subject: [PATCH] accel/amdxdna: document trusted mailbox ring geometry and drop the power-of-two check

Carried from drm-misc-next-2026-10-16 (tag 41cec5feed4687aea2a59378b271faf363c7d938),
upstream commit 5d7b464a4f5b. Unmodified upstream change: it applies to our pinned
xdna-driver (526c6081974e) both on the bare pin and on top of 0001-0010.
Applied by: pi-kernel-74 (carried, not installed).
---
 amdxdna_mailbox.c
diff --git a/drivers/accel/amdxdna/amdxdna_mailbox.c b/drivers/accel/amdxdna/amdxdna_mailbox.c
--- a/drivers/accel/amdxdna/amdxdna_mailbox.c
+++ b/drivers/accel/amdxdna/amdxdna_mailbox.c
@@ -569,11 +569,13 @@ xdna_mailbox_start_channel(struct mailbox_channel *mb_chann,
 {
 	int ret;
 
-	if (!is_power_of_2(x2i->rb_size) || !is_power_of_2(i2x->rb_size)) {
-		pr_err("Ring buf size must be power of 2\n");
-		return -EINVAL;
-	}
-
+	/*
+	 * The ring buffer geometry, rb_start_addr and rb_size for both the
+	 * x2i and the i2x channel, comes from AMD signed firmware, through
+	 * the management or mailbox information block, or through the
+	 * CREATE_CONTEXT response. The driver trusts those values by design
+	 * and does not bound them against the mapped region.
+	 */
 	mb_chann->msix_irq = mb_irq;
 	mb_chann->iohub_int_addr = iohub_int_addr;
 	memcpy(&mb_chann->res[CHAN_RES_X2I], x2i, sizeof(*x2i));
