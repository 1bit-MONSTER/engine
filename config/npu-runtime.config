#
# The NPU runtime the release compiles into 1bit (docs/npu.md, "The NPU runtime"; docs/releases.md).
# The runtime is private: its source is not part of this repository and is never published with
# the release, only the binaries it is compiled into. scripts/fetch-private.sh checks out
# exactly this commit of this repository (with the release machine's GitHub credentials) and
# hands the directory to CMake as ONEBIT_NPU_RT_DIR; the release stops if it cannot. npu_rt_api.cpp
# implements the public npu/npu_rt_api.h (the same commit builds libnpu_rt_api.a for ONEBIT_NPU_RT_LIB).
#
# Move the pin by hand, after the NPU check on Strix Halo (docs/npu.md, "Checking the NPU").
#
# Home: npu-kernels runtime/npu_rt (engine#2208). Until 11-13 the pin was 1bit-MONSTER/1bit-MONSTER
# ce9fa59 engine/npu/npu_rt; that repository is archived, and npu-kernels#69 copied the directory
# verbatim before changing it.
repo=1bit-MONSTER/npu-kernels
sha=8dca02ecc9d0fc6fada3aeb00f189b75fbe92efc
path=runtime/npu_rt
require=npu_rt.h npu_rt_errors.h npu_rt.cpp npu_rt_api.cpp
