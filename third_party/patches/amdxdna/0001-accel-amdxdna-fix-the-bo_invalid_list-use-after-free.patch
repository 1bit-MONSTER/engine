From 0590d340e92937b48ceeb4ed676c9301ce973c40 Mon Sep 17 00:00:00 2001
From: pi-hrx-fabric <pi@1bit.gg>
Date: Wed, 4 Nov 2026 20:14:14 -0400
Subject: [PATCH 1/2] accel/amdxdna: fix the bo_invalid_list use-after-free at
 close

A client that closes while a BO is on client->bo_invalid_list frees the
client and then walks a list the BO still links into: amdxdna_hmm_invalidate()
and amdxdna_mark_mapp_invalid() copy abo->client and take client->hwctx_srcu
before linking, so a close that runs between the copy and the link leaves a
freed client reachable. Unlink the ubuf BO under notifier_lock in the free
path (dying flag), and move the synchronize_srcu into amdxdna_drm_close so the
link window is closed before the client is freed.

Measured: the 2026-11-04 01:48 panic replay no longer panics; the module's
srcversion on strixhalo with the 7.4.0-rc1-1bit headers is EBC78CDA6FD7F3F6E824064.
---
 drivers/accel/amdxdna/amdxdna_drm.c  | 12 ++++++++++++
 drivers/accel/amdxdna/amdxdna_gem.c  | 24 ++++++++++++++++++++----
 drivers/accel/amdxdna/amdxdna_gem.h  |  5 +++++
 drivers/accel/amdxdna/amdxdna_ubuf.c | 11 +++++++++++
 4 files changed, 48 insertions(+), 4 deletions(-)

diff --git a/drivers/accel/amdxdna/amdxdna_drm.c b/drivers/accel/amdxdna/amdxdna_drm.c
index fec29d41..05fa72a7 100644
--- a/drivers/accel/amdxdna/amdxdna_drm.c
+++ b/drivers/accel/amdxdna/amdxdna_drm.c
@@ -165,6 +165,18 @@ static void amdxdna_client_cleanup(struct amdxdna_client *client)
 
 	list_del(&client->node);
 	amdxdna_hwctx_remove_all(client);
+	/*
+	 * amdxdna_hmm_invalidate() and amdxdna_mark_mapp_invalid() copy
+	 * abo->client and then hold client->hwctx_srcu while they link the BO
+	 * into client->bo_invalid_list and wait for the hardware contexts to go
+	 * idle.  amdxdna_hwctx_destroy_rcu() only waits for those readers when
+	 * there was a hardware context left to destroy; a client that closes
+	 * with none (the normal XRT exit order destroys them by ioctl first)
+	 * got no grace period at all, so a reader that copied the pointer
+	 * before amdxdna_gem_obj_close() cleared it could still be inside the
+	 * client after the kfree() below.  Wait for all of them unconditionally.
+	 */
+	synchronize_srcu(&client->hwctx_srcu);
 	xa_destroy(&client->hwctx_xa);
 	cleanup_srcu_struct(&client->hwctx_srcu);
 
diff --git a/drivers/accel/amdxdna/amdxdna_gem.c b/drivers/accel/amdxdna/amdxdna_gem.c
index 98535b90..2d1b5bf4 100644
--- a/drivers/accel/amdxdna/amdxdna_gem.c
+++ b/drivers/accel/amdxdna/amdxdna_gem.c
@@ -317,7 +317,7 @@ static bool amdxdna_hmm_invalidate(struct mmu_interval_notifier *mni,
 		 client && amdxdna_client_has_pending_jobs(client));
 
 	down_write(&xdna->notifier_lock);
-	if (client && list_empty(&abo->node))
+	if (client && !abo->dying && list_empty(&abo->node))
 		list_add_tail(&abo->node, &client->bo_invalid_list);
 	abo->mem.map_invalid = true;
 	mapp->invalid = true;
@@ -479,6 +479,7 @@ static void amdxdna_gem_dev_obj_free(struct drm_gem_object *gobj)
 	unsigned long heap_id;
 
 	down_write(&xdna->notifier_lock);
+	abo->dying = true;
 	list_del_init(&abo->node);
 	up_write(&xdna->notifier_lock);
 
@@ -510,7 +511,7 @@ static void amdxdna_mark_mapp_invalid(struct amdxdna_gem_obj *abo,
 	mutex_unlock(&abo->lock);
 
 	down_write(&xdna->notifier_lock);
-	if (client && list_empty(&abo->node))
+	if (client && !abo->dying && list_empty(&abo->node))
 		list_add_tail(&abo->node, &client->bo_invalid_list);
 	abo->mem.map_invalid = true;
 	list_for_each_entry(mapp, &abo->mem.umap_list, node) {
@@ -804,6 +805,7 @@ static void amdxdna_gem_obj_free(struct drm_gem_object *gobj)
 	flush_workqueue(xdna->notifier_wq);
 
 	down_write(&xdna->notifier_lock);
+	abo->dying = true;
 	list_del_init(&abo->node);
 	up_write(&xdna->notifier_lock);
 
@@ -863,6 +865,7 @@ int amdxdna_gem_obj_open(struct drm_gem_object *gobj, struct drm_file *filp)
 
 void amdxdna_gem_obj_close(struct drm_gem_object *gobj, struct drm_file *filp)
 {
+	struct amdxdna_dev *xdna = to_xdna_dev(gobj->dev);
 	struct amdxdna_gem_obj *abo = to_xdna_obj(gobj);
 	struct amdxdna_client *client = NULL;
 
@@ -876,8 +879,21 @@ void amdxdna_gem_obj_close(struct drm_gem_object *gobj, struct drm_file *filp)
 	}
 	mutex_unlock(&abo->lock);
 
-	if (client)
-		amdxdna_gem_del_bo_usage(client, abo);
+	if (!client)
+		return;
+
+	/*
+	 * The BO no longer belongs to @client, so it must not stay on that
+	 * client's bo_invalid_list: the list is walked by the client's submit
+	 * and close paths and the BO may outlive the client (in-flight job,
+	 * VMA, dma-buf).  abo->lock is dropped first; notifier_lock is never
+	 * taken under abo->lock (see amdxdna_hmm_invalidate()).
+	 */
+	down_write(&xdna->notifier_lock);
+	list_del_init(&abo->node);
+	up_write(&xdna->notifier_lock);
+
+	amdxdna_gem_del_bo_usage(client, abo);
 }
 
 static int amdxdna_gem_obj_vmap(struct drm_gem_object *obj, struct iosys_map *map)
diff --git a/drivers/accel/amdxdna/amdxdna_gem.h b/drivers/accel/amdxdna/amdxdna_gem.h
index 759aaf38..ba433a19 100644
--- a/drivers/accel/amdxdna/amdxdna_gem.h
+++ b/drivers/accel/amdxdna/amdxdna_gem.h
@@ -50,6 +50,11 @@ struct amdxdna_gem_obj {
 	struct amdxdna_client		*client;
 	u8				type;
 	bool				pinned;
+	/* Set under xdna->notifier_lock once a free path has taken this BO off
+	 * client->bo_invalid_list and is about to kfree() it.  amdxdna_hmm_invalidate()
+	 * must not link it back in: it would be linked at free time again.
+	 */
+	bool				dying;
 	struct mutex			lock; /* Protects: pinned, mem.kva, open_ref */
 	struct amdxdna_mem		mem;
 	int				open_ref;
diff --git a/drivers/accel/amdxdna/amdxdna_ubuf.c b/drivers/accel/amdxdna/amdxdna_ubuf.c
index e41aad8d..9b3f69b5 100644
--- a/drivers/accel/amdxdna/amdxdna_ubuf.c
+++ b/drivers/accel/amdxdna/amdxdna_ubuf.c
@@ -37,6 +37,17 @@ static void amdxdna_gem_ubuf_obj_free(struct drm_gem_object *gobj)
 	amdxdna_hmm_unregister(abo, NULL, 0, 0);
 	flush_workqueue(xdna->notifier_wq);
 
+	/*
+	 * The MMU notifiers are gone, so nothing can link this BO into its
+	 * client's bo_invalid_list any more; take it off the list before the
+	 * memory is freed, exactly as amdxdna_gem_obj_free() does.  Freeing it
+	 * while linked leaves the client list pointing at freed memory.
+	 */
+	down_write(&xdna->notifier_lock);
+	abo->dying = true;
+	list_del_init(&abo->node);
+	up_write(&xdna->notifier_lock);
+
 	amdxdna_dma_unmap_bo(xdna, abo);
 	amdxdna_ubuf_unmap_dma(abo);
 	/* Foreign pages are borrowed from the Xen mapping; never unpin them. */
-- 
2.53.0

