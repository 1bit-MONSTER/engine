#
# The private HIP kernels for HRX the release compiles into the HRX llama.cpp (docs/hrx.md,
# "Private HIP kernels"; docs/releases.md). The kernels are private: their source is not part of
# this repository and is never published with the release, only the compiled code objects in the
# binaries. scripts/fetch-private.sh checks out exactly this commit of this repository (with the
# release machine's GitHub credentials); the build passes the checkout as ONEBIT_GPU_PRIVATE, and
# the release stops if it cannot be fetched.
#
# Move the pin by hand, after the HRX checks on Strix Halo (docs/hrx.md).
repo=1bit-MONSTER/gpu-kernels
sha=3c9ef4d745e9799d41470fa094cb282b0a4fab4c
path=addons/hip-hrx
require=addon.cmake kernels
