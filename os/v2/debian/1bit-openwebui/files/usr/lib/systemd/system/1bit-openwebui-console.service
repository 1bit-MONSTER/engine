# The console line for the optional front end (engine#594), one probe per run: it writes
# /etc/issue.d/50-1bit-openwebui.issue saying (up) or (starting), the same two words the menu's probe
# of 13305 uses. Started by 1bit-openwebui-console.timer, never enabled directly and wanted by no
# target: the probe (up to 2 s) is never on the boot's critical path.
[Unit]
Description=1bit OS: the console's Chat UI line (OpenWebUI)
Documentation=https://1bit.gg
After=1bit-openwebui.service

[Service]
Type=oneshot
ExecStart=/usr/lib/1bit/openwebui-console.sh
TimeoutStartSec=30
