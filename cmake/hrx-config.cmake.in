# Package config for the HRX prefix assembled by cmake/hrx_assemble_prefix.cmake.
# Provides the targets llama.cpp's ggml-hrx2 expects: hrx::hrx,
# loom::binding::c::loomc and loom::binding::c::target::amdgpu.
get_filename_component(PREFIX "${CMAKE_CURRENT_LIST_DIR}/../../" ABSOLUTE)
if(NOT TARGET hrx::hrx)
  add_library(hrx::hrx SHARED IMPORTED)
  set_target_properties(hrx::hrx PROPERTIES
    IMPORTED_LOCATION "${PREFIX}/lib/libhrx.so"
    INTERFACE_INCLUDE_DIRECTORIES "${PREFIX}/include")
endif()
if(NOT TARGET loom::binding::c::loomc)
  add_library(loom::binding::c::loomc SHARED IMPORTED)
  set_target_properties(loom::binding::c::loomc PROPERTIES
    IMPORTED_LOCATION "${PREFIX}/lib/libloomc.so"
    INTERFACE_INCLUDE_DIRECTORIES "${PREFIX}/include")
  # The AMDGPU binding uses loomc internals (exported by patches/hrx/0002).
  target_link_libraries(loom::binding::c::loomc INTERFACE "${PREFIX}/lib/libloomc_amdgpu.a")
endif()
if(NOT TARGET loom::binding::c::target::amdgpu)
  add_library(loom::binding::c::target::amdgpu STATIC IMPORTED)
  set_target_properties(loom::binding::c::target::amdgpu PROPERTIES
    IMPORTED_LOCATION "${PREFIX}/lib/libloomc_amdgpu.a"
    INTERFACE_INCLUDE_DIRECTORIES "${PREFIX}/include")
endif()
