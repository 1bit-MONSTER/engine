# 1bit-update <release-dir> | <image.img>   install the next appliance into the OTHER slot and boot it next
# 1bit-update --no-verify <release>         the same, for a release that carries no SHA256SUMS
# 1bit-update --rollback                    boot the other slot next (both sets stay on the disk)
# 1bit-update --status                      which slot is active, what each slot holds, which one GRUB boots
# 1bit-update --shadowed                    the release files the save layer holds a copy of (exit 1 when any)
# 1bit-update --check [--channel stable|test]   is a newer release published? (GitHub releases of 1bit-MONSTER/engine;
#                                           stable = the newest full release, test = the newest including pre-releases
#                                           such as v2026.49-rc1). Channel default from /data/1bit/update.conf
#                                           (channel=stable|test). No network or a rate limit is said, exit 0.
# 1bit-update --latest [--channel ..] [--download-only]   fetch the channel's newest release into /data/updates/<tag>/,
#                                           verify its SIGNED SHA256SUMS (release key, /etc/1bit/release-pub) and the
#                                           image's sha256, then install it into the other slot like an image path.
#                                           Unsigned, unverifiable or not-newer releases are refused. --download-only
#                                           stops after the verified download (the console and web UI install later).
#
# An installed 1bit OS is a frugal set (kernel, initrd, SFS) plus ONE save layer, and the only way to change the OS
# used to be "write a new image", which throws the layer's machine away with it. So an installed machine carries TWO
# slots on the same data partition:
#
#   /1bit        psubdir=1bit       set A
#   /1bit-alt    psubdir=1bit-alt   set B, empty until the first update
#
# The save layer stays where the machine was installed (inside the slot that created it) and every other slot reaches
# it through a RELATIVE `upup64rsave` symlink: Puppy's init finds a save folder under its own psubdir
# (`find_save_file`), follows the link, and writes through it (`setup_psave` makes <folder>/upper the overlay's
# upperdir), so both sets share one machine's worth of state - home, services, /etc - instead of forking it.
#
# What an update writes is the slot that is NOT running, so the running set is never touched and the previous
# appliance stays bootable: that is the rollback. GRUB's `set default` is the switch; the new slot's entries carry the
# NEW release's own boot parameters, merged with the two keys that name this machine (the data partition's UUID pin and
# the slot), so a release that adds, drops or changes a kernel parameter delivers it by update (engine#3374).
#
# Refusals are the point of this script: a half-written slot that GRUB then boots is worse than no update at all. It
# refuses a source that does not carry the set the running image is made of, a source whose SHA256SUMS does not
# verify, a target slot with too little space, a target slot holding a save layer of its own (that is two machines'
# state and not something a script may merge), and it re-reads the GRUB config after writing it.
#
# Exit: 0 done, 1 usage, 2 refused (nothing written), 3 failed while writing.
set -u

DATA=/data
ALT=1bit-alt
LOG=/var/log/1bit-update.log
say() { printf '%s\n' "$*" | tee -a "$LOG"; }
# the log is the record of an OS change and is APPENDED, never truncated: a failed update followed by a `--rollback`
# used to destroy the only trace of why it failed (measured on the first gate run)
logtail() { [ "$LOG" = /dev/null ] || tail -n 5 "$LOG" >&2; }
die() { say "1bit-update: REFUSED: $*" >&2; exit 2; }
fail() { say "1bit-update: FAILED: $*" >&2; logtail; exit 3; }

usage() { sed -n '/^# 1bit-update /,/^# Exit:/p' "$0" | sed 's/^# \{0,1\}//'; }

# ── the save layer and the target slot: pure functions of the data partition, so a test can run them ───────────
# find_save_layer DATA ACTIVE: sets save_slot and savename to the layer the RUNNING slot uses - a real
# <prefix>save directory in ACTIVE, or the slot its relative link points at - because that is the layer Puppy's init
# mounted for this boot. It is not "whichever real layer a scan meets last": with a second, foreign layer in the
# other slot that picked the wrong one. After the first update the machine runs /1bit-alt, whose link still points
# at /1bit, so save_slot stays 1bit and both slots keep reaching one layer.
find_save_layer() {
    save_slot=
    savename=
    for s in "$1/$2"/*save*; do
        [ -e "$s" ] || continue
        if [ -L "$s" ]; then
            to=$(readlink "$s")
            case $to in
                ../1bit/*|../"$ALT"/*) ;;
                *) continue ;;     # a link this script did not write
            esac
            slot=${to#../}; slot=${slot%%/*}
            [ -d "$1/$slot/${to##*/}" ] && [ ! -L "$1/$slot/${to##*/}" ] || continue
            save_slot=$slot; savename=${to##*/}
        elif [ -d "$s" ]; then
            save_slot=$2; savename=$(basename "$s")
        fi
        return 0
    done
}

# prepare_target_layer DATA TARGET: makes the target slot ready to reach the save layer, or names why it cannot.
# The layer a machine shares between its slots lives in ONE of them. When the target is the slot that holds it, which
# is every second update (the machine runs from /1bit-alt and writes /1bit again), that directory is this machine's
# own state: it is kept, and it needs no link. Any OTHER real layer in the target is another machine's state, which an
# update cannot merge. A stale link is replaced. Prints the refusal reason and returns 1; returns 0 otherwise.
prepare_target_layer() {
    for s in "$1/$2"/*save*; do
        [ -e "$s" ] || [ -L "$s" ] || continue
        if [ -d "$s" ] && [ ! -L "$s" ]; then
            # THE SAME FILE, stated directly: `-ef` is device+inode, so "this is the layer the running slot reaches"
            # is one test and not two (slot name and directory name). It is a clarification, not a hole being closed:
            # the name form also refused a same-named stranger, because it required the slot to match as well and a
            # foreign layer is by definition in another slot (pi-os3 raised the case, the #1385 review measured that
            # the old form already refused it - the test arm below is the regression guard either way).
            [ "$s" -ef "$1/$save_slot/$savename" ] && continue
            echo "/$2 already holds a save layer ($(basename "$s")): two layers cannot be merged by an update - pick the slot by hand if that is really what you want"
            return 1
        fi
        rm -f "$s"
    done
    return 0
}

# link_target_layer DATA TARGET: the target reaches the layer through a relative link, unless it holds the layer.
link_target_layer() {
    [ "$2" = "$save_slot" ] && return 0
    ln -sfn "../$save_slot/$savename" "$1/$2/$savename"
}

# ── release code the save layer shadows (engine#3342) ───────────────────────────────────────────────────────────
# An overlay's upper copy wins over every lower layer, so a release file that the save layer holds a copy of keeps the
# OLD bytes after an update, silently: v2026.48 kept c35's hand-edited /etc/init.d/05onboard-data and never made
# /data/npm-global. etc/1bit/release-owned names the paths the release owns (its code, never the machine's state); an
# upper entry on one of them is release code in the wrong place, identical to the new bytes or not (an identical copy
# shadows the NEXT release instead).
#
# owned_pats FILE: the patterns of a release-owned list, one per line (comments and blanks dropped)
owned_pats() { sed -e 's/[[:space:]]*#.*//' -e '/^[[:space:]]*$/d' "$1" 2> /dev/null; }
# An OPAQUE upper directory (trusted.overlay.opaque=y, set when a lower directory is removed and made again through
# the merged view) hides EVERYTHING the release has under that path, not one file. Moving the files out of it would
# leave it empty and still opaque - the new release's whole directory gone after the reboot, and nothing saying why.
# shadow_is_opaque DIR: 0 when DIR is an opaque overlay directory. shadow_clear_opaque DIR: make it transparent again,
# so the release's files show through and whatever else the machine keeps there stays. Both are functions so a test
# can stand in for them: only root can set trusted.* attributes.
# shadow_have_attr_tools: getfattr and setfattr are on PATH. Without them opacity cannot be read, and "cannot tell" must
# not read as "transparent" - that would bring back the silent hidden directory - so the scan says so instead.
shadow_have_attr_tools() {
    command -v getfattr > /dev/null 2>&1 && command -v setfattr > /dev/null 2>&1
}
shadow_is_opaque() {
    [ "$(getfattr -h --only-values -n trusted.overlay.opaque "$1" 2> /dev/null)" = y ]
}
shadow_clear_opaque() {
    setfattr -h -x trusted.overlay.opaque "$1" 2> /dev/null
}
# shadow_dir_owned DIR PATTERNS: 0 when a release-owned path can sit at or under DIR (a pattern starts with DIR/, or
# DIR/<anything> matches one) - so an opaque /etc or /etc/init.d counts, not only /opt/1bit-package itself
shadow_dir_owned() {
    set -f
    for pat in $2; do
        case $pat in "$1"/*) set +f; return 0 ;; esac
        # shellcheck disable=SC2254
        case "$1/x" in $pat) set +f; return 0 ;; esac
    done
    set +f
    return 1
}
# shadow_scan UPPER PATTERNS: one line per upper entry on a release-owned path, "<kind><TAB><path>", kind = file, link,
# whiteout (a 0/0 character device: the overlay's record that the path was DELETED, which hides the release's file)
# opaque (a directory that hides the release's whole directory; listed after every file, so a move empties it first),
# or unchecked (no getfattr/setfattr, so opacity could not be read: reported, never taken as "transparent")
shadow_scan() {
    [ -d "$1" ] || return 0
    ( cd "$1" && find . -xdev \( -type f -o -type l -o -type c \) -print 2> /dev/null ) | sed 's|^\./||' | sort |
    while IFS= read -r p; do
        hit=
        set -f
        for pat in $2; do
            # shellcheck disable=SC2254
            case $p in $pat) hit=1; break ;; esac
        done
        set +f
        [ -n "$hit" ] || continue
        if [ -L "$1/$p" ]; then echo "link	$p"
        elif [ -c "$1/$p" ]; then
            [ "$(stat -c %t:%T "$1/$p" 2> /dev/null)" = 0:0 ] && echo "whiteout	$p"
        else echo "file	$p"; fi
    done
    if ! shadow_have_attr_tools; then
        # one line, only when a directory the release owns is in the upper layer at all
        ( cd "$1" && find . -xdev -mindepth 1 -type d -print 2> /dev/null ) | sed 's|^\./||' | sort |
        while IFS= read -r d; do
            shadow_dir_owned "$d" "$2" && { echo "unchecked	$d"; break; }
        done
        return 0
    fi
    ( cd "$1" && find . -xdev -mindepth 1 -type d -print 2> /dev/null ) | sed 's|^\./||' | sort |
    while IFS= read -r d; do
        shadow_dir_owned "$d" "$2" && shadow_is_opaque "$1/$d" && echo "opaque	$d"
    done
    return 0
}
# shadow_kind BASE PATH UPPER: how the upper copy compares with the release - "differs", "identical" or "not in the
# release". BASE is a directory (the release's tree, e.g. /initrd/pup_ro2) or a .sfs file (read with unsquashfs).
shadow_kind() {
    if [ -d "$1" ]; then
        [ -e "$1/$2" ] || [ -L "$1/$2" ] || { echo "not in the release"; return; }
        if [ -L "$3/$2" ] || [ -L "$1/$2" ]; then
            [ "$(readlink "$3/$2")" = "$(readlink "$1/$2")" ] && echo identical || echo differs
        else cmp -s "$3/$2" "$1/$2" && echo identical || echo differs; fi
    elif [ -f "$1" ]; then
        k=$(mktemp) || { echo unknown; return; }
        if unsquashfs -q -cat "$1" "$2" > "$k" 2> /dev/null; then
            cmp -s "$3/$2" "$k" && echo identical || echo differs
        else echo "not in the release"; fi
        rm -f "$k"
    else
        echo "unknown"
    fi
}
# shadow_move UPPER PATTERNS DEST: takes every release-owned upper entry OUT of the overlay, into DEST at the same
# relative path (DEST is beside upper/ in the save folder, so nothing there is seen by the system: a moved init script
# left in /etc/init.d would still be RUN at boot), and drops whiteouts (listed in DEST/whiteouts). Prints one line per
# entry; returns 0 when every one moved.
shadow_move() {
    rc=0 list=$(mktemp) || return 1
    shadow_scan "$1" "$2" > "$list"
    while IFS='	' read -r kind p; do
        if [ "$kind" = unchecked ]; then
            echo "   could NOT check for opaque directories (no getfattr/setfattr): one under /$p would hide the release's files"
            rc=1
        elif [ "$kind" = opaque ]; then
            mkdir -p "$3" && echo "$p" >> "$3/opaque" && shadow_clear_opaque "$1/$p" &&
                echo "   made /$p transparent again (an opaque directory hid the release's)" ||
                { echo "   FAILED to clear the opaque directory /$p: the release's /$p stays hidden"; rc=1; }
        elif [ "$kind" = whiteout ]; then
            mkdir -p "$3" && echo "$p" >> "$3/whiteouts" && rm -f "$1/$p" && echo "   dropped the whiteout that hid /$p" ||
                { echo "   FAILED to drop the whiteout on /$p"; rc=1; }
        else
            mkdir -p "$3/$(dirname "$p")" && mv "$1/$p" "$3/$p" && echo "   moved /$p ($kind) out of the save layer" ||
                { echo "   FAILED to move /$p"; rc=1; }
        fi
    done < "$list"
    rm -f "$list"
    return $rc
}

# ── --check (OS updater U1): what is published, against what is running ─────────────────────────────────────────
# update_running: the release this system runs, from /etc/1bit/release-identity (payload=lemonade-onebit-<tag>)
UPDATE_IDENTITY=${ONEBIT_UPDATE_IDENTITY:-/etc/1bit/release-identity}
UPDATE_CONF=${ONEBIT_UPDATE_CONF:-/data/1bit/update.conf}
UPDATE_API=${ONEBIT_UPDATE_API:-https://api.github.com/repos/1bit-MONSTER/engine/releases?per_page=30}
update_running() { sed -n 's/^payload=lemonade-onebit-//p' "$UPDATE_IDENTITY" 2> /dev/null | head -1; }
update_channel() {   # $1 = an explicit --channel, else update.conf, else stable
    _c=${1:-}
    [ -n "$_c" ] || _c=$(sed -n 's/^channel=//p' "$UPDATE_CONF" 2> /dev/null | tr -d ' \r' | head -1)
    case $_c in stable|test) printf '%s' "$_c" ;; *) printf stable ;; esac
}
# update_pick <api json file> <channel> <running tag>: key=value lines about the newest release of the channel. The JSON
# is remote data: python3 -I reads it as data, the shell never evaluates any of it, and every value printed is reduced
# to a safe charset first.
update_pick() {
    python3 -I -c '
import json, re, sys
path, channel, running = sys.argv[1:4]
def ver(tag):   # vYYYY.WW[-rcN]: a final release sorts after its own release candidates
    m = re.fullmatch(r"v(\d{4})\.(\d{1,2})(?:-rc(\d+))?", tag or "")
    return None if not m else (int(m.group(1)), int(m.group(2)), 1 if m.group(3) is None else 0, int(m.group(3) or 0))
# printable ASCII only: remote text never reaches a shell, so the danger is a terminal escape, not a quote
safe = lambda v: re.sub(r"[^\x20-\x7e]", "", str(v))[:200]
try:
    rel = json.load(open(path))
except (OSError, ValueError):
    print("error=the release list could not be read"); sys.exit(0)
if isinstance(rel, dict):   # GitHub sends an error object (rate limit, not found)
    print("error=" + safe(rel.get("message", "unexpected answer"))); sys.exit(0)
best = None
for r in rel if isinstance(rel, list) else []:
    if not isinstance(r, dict) or r.get("draft"):
        continue
    if channel == "stable" and r.get("prerelease"):
        continue
    v = ver(r.get("tag_name"))
    if v and (best is None or v > best[0]):
        best = (v, r)
if best is None:
    print("error=no %s release is published" % channel); sys.exit(0)
r = best[1]
assets = [a for a in r.get("assets") or [] if isinstance(a, dict)]
img = [a for a in assets if re.fullmatch(r"1bit-os-v[0-9.]+(-rc[0-9]+)?\.img\.zst", str(a.get("name", "")))]
named = lambda n: [a for a in assets if a.get("name") == n]
cur = ver(running)
print("tag=" + safe(r.get("tag_name")))
print("published=" + safe(r.get("published_at", ""))[:10])
print("prerelease=" + ("yes" if r.get("prerelease") else "no"))
print("newer=" + ("unknown" if cur is None else ("yes" if best[0] > cur else "no")))
if img:
    print("image=" + safe(img[0]["name"])); print("size=%d" % int(img[0].get("size") or 0))
    print("image_url=" + safe(img[0].get("browser_download_url", "")))
print("sums_url=" + (safe(named("SHA256SUMS")[0].get("browser_download_url", "")) if named("SHA256SUMS") else ""))
print("sig_url=" + (safe(named("SHA256SUMS.sig")[0].get("browser_download_url", "")) if named("SHA256SUMS.sig") else ""))
for line in [l.strip() for l in (r.get("body") or "").splitlines() if l.strip() and not l.strip().startswith("|")][:4]:
    print("note=" + safe(line.lstrip("#*- ")))
' "$1" "$2" "$3"
}
update_check() {   # [channel]: prints the answer; always exit 0 (an update check is information, never a failure)
    _ch=$(update_channel "${1:-}") _run=$(update_running)
    _j=${ONEBIT_UPDATE_API_JSON:-}
    if [ -z "$_j" ]; then
        [ -n "${WORK:-}" ] || work_dir
        _j=$WORK/releases.json
        if ! curl -sS --proto =https --tlsv1.2 -m 20 -H 'Accept: application/vnd.github+json' -o "$_j" "$UPDATE_API" \
                2> "$WORK/check.err"; then
            say "1bit-update: could not reach GitHub ($(head -c 160 "$WORK/check.err")): no update check now (running ${_run:-unknown})"
            return 0
        fi
    fi
    _a=$(update_pick "$_j" "$_ch" "$_run")
    _v() { printf '%s\n' "$_a" | sed -n "s/^$1=//p" | head -1; }
    if [ -n "$(_v error)" ]; then
        say "1bit-update: no answer from the $_ch channel: $(_v error) (running ${_run:-unknown})"; return 0
    fi
    say "running:  ${_run:-unknown}"
    say "$_ch: $(_v tag) ($(_v published)$( [ "$(_v prerelease)" = yes ] && echo ', pre-release'))"
    [ -n "$(_v image)" ] && say "image:    $(_v image), $(( $(_v size) / 1048576 )) MiB"
    printf '%s\n' "$_a" | sed -n 's/^note=/  | /p'
    case $(_v newer) in
        yes) say "an update is available: 1bit-update --latest${1:+ --channel $_ch} installs it into the other slot" ;;
        no)  say "up to date" ;;
        *)   say "the running release (${_run:-none}) has no version to compare with" ;;
    esac
    [ -n "$(_v sig_url)" ] || say "note: $(_v tag) carries no SHA256SUMS.sig, so --latest will refuse it (only signed images are installed)"
    return 0
}

# ── the private work dir (security review, 24 Nov) ────────────────────────────────────────────────────────────────
# Everything this run writes, mounts or reads back lives in ONE directory made fresh for it: `mktemp -d` creates a new
# random name atomically with mode 0700, so nothing planted in advance - a pre-created /tmp/1bit-update, a symlink in
# it - is ever followed. Root (an install) works under /run (root-only; /tmp is world-writable and on Puppy a symlink);
# a person's --check under $TMPDIR. /run is NOT a tmpfs on 1bit OS (a directory on the root overlay, whose upper is the
# persistent save layer in PUPMODE 12, cl-kernel on #3457), so a run that dies before work_done leaves its dir in the
# save layer: work_sweep removes such leftovers (older than a day, root's own, no mount inside) at the next start. WORK= is set by work_dir; work_done removes it only after the mounts in
# it are gone (the ESP is mounted there: an rm -rf over a live mount would empty the ESP).
work_dir() {
    _base=${TMPDIR:-/tmp}
    [ "$(id -u)" = 0 ] && [ -d /run ] && [ ! -L /run ] && _base=/run
    work_sweep "$_base"
    WORK=$(mktemp -d "$_base/1bit-update.XXXXXX") || { echo "1bit-update: cannot make a private work dir in $_base" >&2; exit 2; }
    chmod 700 "$WORK"
}
work_sweep() {   # <base>: leftover 1bit-update.* work dirs of crashed runs
    for _o in "$1"/1bit-update.*; do
        [ -d "$_o" ] && [ ! -L "$_o" ] || continue
        [ "$(stat -c %u "$_o" 2> /dev/null)" = "$(id -u)" ] || continue
        [ -n "$(find "$_o" -maxdepth 0 -mmin +1440 2> /dev/null)" ] || continue
        _ow=$(readlink -f "$_o")
        awk -v w="$_ow/" 'index($2, w) == 1 { f = 1 } END { exit !f }' /proc/mounts 2> /dev/null && continue
        rm -rf "${_o:?}"
    done
}
work_done() {
    [ -n "${WORK:-}" ] && [ -d "$WORK" ] || return 0
    _w=$(readlink -f "$WORK")
    if awk -v w="$_w/" 'index($2, w) == 1 { found = 1 } END { exit !found }' /proc/mounts 2> /dev/null; then
        echo "1bit-update: $WORK still has a mount in it: left in place" >&2; return 0
    fi
    rm -rf "${WORK:?}"
}
# safe_dir <dir>: create it 0700, or accept an existing one only when it is a real directory (not a link), owned by
# root and not group/other-writable: /data is shared with people's files, and a planted /data/updates would otherwise
# receive (and serve back) what root downloads and decompresses
safe_dir() {
    [ -L "$1" ] && { say "1bit-update: REFUSED: $1 is a symbolic link"; return 1; }
    if [ ! -e "$1" ]; then mkdir -m 700 "$1" || return 1; fi
    [ -d "$1" ] || { say "1bit-update: REFUSED: $1 is not a directory"; return 1; }
    _o=$(stat -c %u "$1") _m=$(stat -c %a "$1")
    [ "$_o" = 0 ] || { say "1bit-update: REFUSED: $1 is owned by uid $_o, not root"; return 1; }
    case $_m in *[2367]?|*[2367]) say "1bit-update: REFUSED: $1 is writable by others (mode $_m)"; return 1 ;; esac
    chmod 700 "$1"
}

# ── --latest (OS updater U2): a SIGNED download, then the same slot install ──────────────────────────────────────
UPDATE_DIR=${ONEBIT_UPDATE_DIR:-/data/updates}
UPDATE_VERIFIER=${ONEBIT_UPDATE_VERIFIER:-/usr/lib/1bit/release_sign.py}
UPDATE_PUB=${ONEBIT_UPDATE_PUB:-/etc/1bit/release-pub}
# update_verify <image.img.zst> <SHA256SUMS> <SHA256SUMS.sig>: 0 = the release key signed SHA256SUMS and the image is
# the file it names; anything else refuses (the verifier says why on stderr). No verifier or no public key = refuse:
# a self-updating OS installs nothing it cannot check.
update_verify() {
    [ -f "$UPDATE_VERIFIER" ] || { say "1bit-update: REFUSED: no release verifier at $UPDATE_VERIFIER"; return 2; }
    [ -s "$UPDATE_PUB" ] || { say "1bit-update: REFUSED: no release public key at $UPDATE_PUB"; return 2; }
    [ -s "$3" ] || { say "1bit-update: REFUSED: ${1##*/} has no SHA256SUMS.sig: only signed releases are installed"; return 2; }
    _vo=$(python3 -I "$UPDATE_VERIFIER" verify-image "$1" "$2" "$3" --pub "$UPDATE_PUB" 2>&1); _vr=$?
    if [ "$_vr" = 0 ]; then say "verified: $_vo"; return 0; fi
    say "1bit-update: REFUSED: $(printf '%s' "$_vo" | tr '\n' ' ' | cut -c1-300)"
    return 2
}
# update_get <https url> <file>: resumable (-C -), HTTPS only, also across GitHub's redirect to its asset host
update_get() {
    curl -fsSL --proto =https --proto-redir =https --tlsv1.2 --retry 3 --connect-timeout 20 -C - -o "$2" "$1"
}
# update_prune: /data/updates keeps the release just fetched and ONE previous (the rollback's image), nothing older
update_prune() {
    _keep=$1 _n=0
    for _d in $(ls -1td "$UPDATE_DIR"/v*/ 2> /dev/null); do
        _d=${_d%/}
        [ "${_d##*/}" = "$_keep" ] && continue
        _n=$((_n + 1)); [ "$_n" -le 1 ] && continue
        rm -rf "${_d:?}" && say "removed the older download ${_d##*/}"
    done
}
update_latest() {   # <channel> <download-only 1/''>: sets src= to the verified .img for the install below, or exits
    _ch=$(update_channel "${1:-}") _run=$(update_running)
    safe_dir "$UPDATE_DIR" || die "$UPDATE_DIR is not a private root directory"
    _j=$WORK/releases.json
    if [ -n "${ONEBIT_UPDATE_API_JSON:-}" ]; then cp "$ONEBIT_UPDATE_API_JSON" "$_j"
    else update_get "$UPDATE_API" "$_j" || die "could not reach GitHub for the release list (no update now)"; fi
    _a=$(update_pick "$_j" "$_ch" "$_run")
    _v() { printf '%s\n' "$_a" | sed -n "s/^$1=//p" | head -1; }
    [ -z "$(_v error)" ] || die "no answer from the $_ch channel: $(_v error)"
    _tag=$(_v tag)
    case $_tag in v[0-9]*) ;; *) die "the $_ch channel named no usable release" ;; esac
    if [ "$(_v newer)" != yes ] && [ -z "${ONEBIT_UPDATE_ANY:-}" ]; then
        say "up to date: running ${_run:-unknown}, the $_ch channel's newest is $_tag"; exit 0
    fi
    [ -n "$(_v image_url)" ] || die "$_tag has no 1bit-os image asset"
    [ -n "$(_v sig_url)" ] && [ -n "$(_v sums_url)" ] || die "$_tag carries no signed SHA256SUMS (SHA256SUMS + SHA256SUMS.sig): only signed releases are installed"
    _img=$(_v image) _size=$(_v size)
    case $_img in 1bit-os-v*.img.zst) ;; *) die "unexpected image name" ;; esac
    _d=$UPDATE_DIR/$_tag; safe_dir "$_d" || die "$_d is not a private root directory"
    # room for the compressed download, its decompressed image (about 7x) and 2 GiB of margin, before any byte moves
    _have=$(df -Pk "$UPDATE_DIR" | awk 'NR==2 {print $4}')
    _need=$(( (_size / 1024) * 8 + 2097152 ))
    [ "${_have:-0}" -ge "$_need" ] || die "$UPDATE_DIR has $((_have / 1048576)) GiB free, $_tag needs about $((_need / 1048576)) GiB"
    say "downloading $_tag ($((_size / 1048576)) MiB) into $_d"
    rm -f "$_d/SHA256SUMS" "$_d/SHA256SUMS.sig"   # small: always fresh, so a changed signature is never mixed with an old file
    update_get "$(_v sums_url)" "$_d/SHA256SUMS" && update_get "$(_v sig_url)" "$_d/SHA256SUMS.sig" \
        || die "could not download $_tag's SHA256SUMS / SHA256SUMS.sig"
    update_get "$(_v image_url)" "$_d/$_img" || die "could not download $_img (run again: the download resumes)"
    if ! update_verify "$_d/$_img" "$_d/SHA256SUMS" "$_d/SHA256SUMS.sig"; then
        rm -f "$_d/$_img"; die "$_tag NOT installed: its image did not verify, and the download was removed"
    fi
    update_prune "$_tag"
    if [ -n "${2:-}" ]; then say "downloaded and verified: $_d/$_img (install it with 1bit-update --latest)"; exit 0; fi
    _raw=$_d/${_img%.zst}
    zstd -d -q -f -o "$_raw" "$_d/$_img" || { rm -f "$_raw"; die "could not decompress $_img"; }
    src=$_raw
    # what was asked for: the install below checks it against the identity INSIDE the verified image
    expect_tag=$_tag expect_ch=$_ch expect_run=$_run
}

# ── rollback protection (security review, 24 Nov): the release a --latest installs is the one it ASKED for ──────────
# GitHub's tag_name is not signed: an old, genuinely signed image re-published under a newer tag would verify and
# install (a rollback to a release with known holes). So --latest records what it asked for, and once the image's own
# files are verified the install reads the tag the IMAGE carries (etc/1bit/release-identity inside its puppy_*.sfs)
# and update_identity_check decides - before a byte is written to the other slot.
# update_ver_gt <a> <b>: 0 when vYYYY.WW[-rcN] a is strictly newer than b (a final sorts after its own rcs)
update_ver_gt() {
    python3 -I -c '
import re, sys
def ver(t):
    m = re.fullmatch(r"v(\d{4})\.(\d{1,2})(?:-rc(\d+))?", t)
    return None if not m else (int(m.group(1)), int(m.group(2)), 1 if m.group(3) is None else 0, int(m.group(3) or 0))
a, b = ver(sys.argv[1]), ver(sys.argv[2])
sys.exit(0 if a is not None and b is not None and a > b else 1)
' "$1" "$2"
}
# update_identity_check <tag in the verified image> <tag asked for> <running tag> <channel>: prints why and returns 1
# when the image must not be installed by --latest
update_identity_check() {
    _it=$1 _ask=$2 _run=$3 _ch=$4
    case $_it in v[0-9]*) ;; *) echo "the verified image carries no release identity (etc/1bit/release-identity): it cannot be checked against what was asked for"; return 1 ;; esac
    [ "$_it" = "$_ask" ] || { echo "the verified image is $_it, but GitHub's release is named $_ask: a re-published older image is not installed"; return 1; }
    [ -n "$_run" ] || { echo "the running release has no identity to compare with: use 1bit-update <image> deliberately"; return 1; }
    update_ver_gt "$_it" "$_run" || { echo "$_it is not newer than the running $_run: --latest never installs an older or equal release (1bit-update <image> or --rollback do that on purpose)"; return 1; }
    case $_ch:$_it in stable:*-rc*) echo "$_it is a release candidate and the channel is stable"; return 1 ;; esac
    return 0
}

# ── the other slot's boot line: the NEW release's parameters, this MACHINE's keys (engine#3374) ──────────────────
# Until #3374 the update built the other slot's GRUB `linux` line by copying the RUNNING slot's and replacing psubdir=,
# so a kernel parameter a release added, dropped or changed after the machine was installed never arrived by update
# (measured: an installed v2026.48 that had been updated from c35 booted without printk.always_kmsg_dump=1, although
# mkimage.sh puts it on every image's line and refuses an image without it - so that boot left no pstore record).
#
# The release carries its own headless parameters beside the set it ships, in /1bit/cmdline: mkimage.sh writes it from
# the same variable that builds the image's grub.cfg, so the two cannot disagree, and the file is on the set an update
# already copies (an image's mounted data partition, or a release directory). The release forms the line; only the keys
# that name THIS MACHINE are taken from the running entry, because the release's own values name the release image's
# disk: pupsfs=UUID= and 1bit.data=UUID= (the pin an installed disk boots its own data partition by, engine#539/#3287)
# and psubdir= (the slot). pfix=copy is the live stick's trick and becomes pfix=nocopy, exactly as 1bit-install
# rewrites it for an installed disk.
#
# boot_param LINE KEY: the value of KEY= on a kernel boot line (the first one), or empty. KEY is a sed pattern.
boot_param() {
    printf '%s\n' "$1" | tr ' ' '\n' | sed -n "s/^$2=//p" | head -1
}
# release_headless FILE: the headless kernel parameters a release carries, or empty when it carries none. The file may
# hold the bare parameters or the whole grub `linux <kernel> <parameters>` line (what a person copies out of an image's
# grub.cfg); a `#` comment line and a blank line are skipped, CRLF is read as one line.
release_headless() {
    [ -f "$1" ] && [ -r "$1" ] || return 0
    _rh=$(sed -n '/^[[:space:]]*#/d; /^[[:space:]]*$/d; {p;q;}' "$1" | tr -d '\r')
    printf '%s' "$_rh" | sed 's|^[[:space:]]*linux[[:space:]][[:space:]]*[^[:space:]][^[:space:]]*[[:space:]]*||'
}
# slot_params RELEASE RUNNING TARGET: the kernel parameters TARGET's headless entry gets. RELEASE is the new release's
# own line (empty: the release carries none, so the RUNNING line's parameters are copied - the pre-#3374 behaviour, and
# the caller says so in the log), RUNNING the running slot's headless line (the machine's keys), TARGET the slot name.
# Prints the parameters; on a release that names a machine key the running machine cannot fill in it prints why and
# returns 1 - an image's own UUID would point the new slot at the release stick's data partition.
slot_params() {
    _sp_rel=${1:-} _sp_run=$2 _sp_tgt=$3
    [ -n "$_sp_rel" ] || _sp_rel=$_sp_run
    _sp_pin=$(boot_param "$_sp_run" pupsfs) _sp_data=$(boot_param "$_sp_run" '1bit\.data')
    _sp_out= _sp_p= _sp_d= _sp_s=
    set -f   # the line is data: a `*` in a parameter is not a glob (this runs in a $(...) subshell, so the caller's own globbing stays)
    for _sp_t in $_sp_rel; do
        case $_sp_t in
            psubdir=*) _sp_out="$_sp_out psubdir=$_sp_tgt"; _sp_s=1 ;;
            pupsfs=*)
                if [ -z "$_sp_pin" ]; then
                    echo "the release's boot line pins the data partition (pupsfs=...), and the running boot line has no pupsfs= to take this disk's value from: the image's own UUID would point /$_sp_tgt at the release stick's partition"
                    set +f; return 1
                fi
                _sp_out="$_sp_out pupsfs=$_sp_pin"; _sp_p=1 ;;
            1bit.data=*)
                if [ -z "$_sp_data" ]; then
                    echo "the release's boot line pins the data partition (1bit.data=...), and the running boot line has no 1bit.data= to take this disk's value from: the image's own UUID would point /$_sp_tgt at the release stick's partition"
                    set +f; return 1
                fi
                _sp_out="$_sp_out 1bit.data=$_sp_data"; _sp_d=1 ;;
            pfix=*) case $_sp_t in *pfix=copy*) _sp_t=$(printf '%s' "$_sp_t" | sed 's|pfix=copy|pfix=nocopy|') ;; esac
                    _sp_out="$_sp_out $_sp_t" ;;
            *) _sp_out="$_sp_out $_sp_t" ;;
        esac
    done
    set +f
    # the machine's keys are on the line exactly once, whatever the release's own line carries: a release that dropped
    # one does not get to drop the pin an installed disk boots by
    [ -n "$_sp_s" ] || _sp_out="$_sp_out psubdir=$_sp_tgt"
    [ -n "$_sp_p" ] || [ -z "$_sp_pin" ] || _sp_out="$_sp_out pupsfs=$_sp_pin"
    [ -n "$_sp_d" ] || [ -z "$_sp_data" ] || _sp_out="$_sp_out 1bit.data=$_sp_data"
    printf '%s\n' "${_sp_out# }"
}

# sourced by tests/one_bit_update_slots_test.sh with ONEBIT_UPDATE_LIB=1: the functions above, nothing below
if [ "${ONEBIT_UPDATE_LIB:-}" = 1 ]; then return 0 2> /dev/null || exit 0; fi

src=''
mode=install
novfy=
channel=
dlonly=
expect_tag= expect_ch= expect_run=   # only --latest sets these (never the environment)
while [ $# -gt 0 ]; do
    case $1 in
        -h|--help) usage; exit 0 ;;
        --check) mode=check ;;
        --latest) mode=latest ;;
        --download-only) dlonly=1 ;;
        --channel) channel=${2:-}
                   case $channel in stable|test) ;; *) echo "1bit-update: --channel takes stable or test" >&2; exit 1 ;; esac
                   shift ;;
        --status) mode=status ;;
        --shadowed) mode=shadowed ;;
        --rollback) mode=rollback ;;
        --no-verify) novfy=1 ;;
        /*) src=$1 ;;
        *) usage >&2; exit 1 ;;
    esac
    shift
done
[ -n "$src" ] || [ "$mode" != install ] || { usage >&2; exit 1; }
work_dir
trap 'work_done' EXIT
( : >> "$LOG" ) 2> /dev/null || LOG=/dev/null   # a subshell: in dash a failed redirect on the special builtin `:` exits the shell, braces or not
# --check needs no root and no installed disk: a live stick may ask too
if [ "$mode" = check ]; then update_check "$channel"; exit 0; fi

[ "$(id -u)" = 0 ] || die "run as root (it writes the other slot and the ESP)"
[ -d "$DATA" ] && grep -q " $DATA " /proc/mounts 2> /dev/null || die "no $DATA: this is not an installed system"
[ -e "$DATA/.installed" ] || die "no $DATA/.installed: this is a live stick, not an installed machine (a stick is replaced by writing the next image, it is not updated in place)"
# --latest: the verified download becomes the image path of an ordinary install (the running slot is never touched)
if [ "$mode" = latest ]; then update_latest "$channel" "$dlonly"; mode=install; fi

# ── which slot is running, and where the disk and its ESP are ────────────────────────────────────────────────
psub=$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^psubdir=//p' | head -1)
psub=${psub#/}
[ -n "$psub" ] || die "the boot line carries no psubdir=, so the running slot cannot be named"
active=$psub
case $active in
    "$ALT") target=1bit ;;
    1bit) target=$ALT ;;
    *) die "psubdir=$active is neither 1bit nor $ALT: this disk was not laid out by 1bit-install" ;;
esac
bootpart=$(awk '$2 == "/initrd/mnt/dev_save" { print $1; exit }' /proc/mounts 2> /dev/null)
[ -n "$bootpart" ] || bootpart=$(awk '$2 == "/data" { print $1; exit }' /proc/mounts 2> /dev/null)
[ -n "$bootpart" ] || die "cannot tell which partition this machine booted from"
bootdisk=$(basename "$(readlink -f "/sys/class/block/${bootpart##*/}/.." 2> /dev/null)" 2> /dev/null)
[ -n "$bootdisk" ] || die "cannot resolve the disk behind $bootpart"
esp=
for p in /sys/block/"$bootdisk"/"$bootdisk"*; do
    [ -e "$p" ] || continue
    n=/dev/$(basename "$p")
    [ "$(blkid -o value -s LABEL "$n" 2> /dev/null)" = 1BIT-OS ] && { esp=$n; break; }
done
[ -n "$esp" ] || die "no 1BIT-OS partition on $bootdisk: this machine did not boot from an installed disk"
find_save_layer "$DATA" "$active"

# ── release code the save layer shadows, on the RUNNING system (engine#3342) ────────────────────────────────────
# the running release's own tree is the SFS lower Puppy mounted (/initrd/pup_ro2); its release-owned list is read from
# there, not from /etc, where a save-layer copy of that list would itself win
run_base=/initrd/pup_ro2
[ -d "$run_base/etc" ] || run_base=$(ls "$DATA/$active"/puppy_*.sfs 2> /dev/null | head -1)
run_owned=$run_base/etc/1bit/release-owned
# when the lower is not mounted, run_base is the slot's .sfs FILE: read the list out of it, not from a path under a file
# (that path cannot exist, so the check fell through to /etc - where a save-layer copy of the list would win - and
# --shadowed refused on a machine whose release does carry the list; found by tests/update_e2e_loop_test.sh)
if [ -f "$run_base" ] && [ ! -d "$run_base" ]; then
    run_owned=$(mktemp); run_owned_tmp=$run_owned
    trap 'rm -f "$run_owned_tmp"' EXIT
    unsquashfs -q -cat "$run_base" etc/1bit/release-owned > "$run_owned" 2> /dev/null && [ -s "$run_owned" ] ||
        run_owned=/etc/1bit/release-owned
fi
[ -f "$run_owned" ] || run_owned=/etc/1bit/release-owned
# ONEBIT_RELEASE_OWNED=<file>: check against another list (a release that predates the list, or a test)
[ -n "${ONEBIT_RELEASE_OWNED:-}" ] && run_owned=$ONEBIT_RELEASE_OWNED
upper=
[ -n "$savename" ] && upper=$DATA/$save_slot/$savename/upper
# shadow_report BASE PATTERNS: one line per shadowed path, how it compares with BASE; sets nshadow
shadow_report() {
    nshadow=0 l=$(mktemp) || return 1
    shadow_scan "$upper" "$2" > "$l"
    while IFS='	' read -r kind p; do
        nshadow=$((nshadow + 1))
        case $kind in
            whiteout) k="a whiteout hides the release's file" ;;
            opaque) k="an opaque directory hides the release's whole directory" ;;
            unchecked) k="getfattr/setfattr missing: opaque directories under it were NOT checked" ;;
            *) k=$(shadow_kind "$1" "$p" "$upper") ;;
        esac
        echo "   shadowed /$p ($kind; $k)"
    done < "$l"
    rm -f "$l"
}
if [ "$mode" = shadowed ]; then
    [ -n "$upper" ] && [ -d "$upper" ] || { echo "1bit-update: no save layer upper dir: nothing can shadow the release"; exit 0; }
    pats=$(owned_pats "$run_owned")
    [ -n "$pats" ] || die "the running release has no etc/1bit/release-owned list: release code cannot be told from machine state"
    shadow_report "$run_base" "$pats"
    echo "1bit-update: $nshadow release-owned path(s) shadowed by the save layer $upper"
    [ "$nshadow" = 0 ] && exit 0
    echo "   these keep the OLD bytes over the running release; the next 1bit-update moves them to $DATA/$save_slot/$savename/1bit-shadowed/"
    exit 1
fi

# ── GRUB: read the config, find a slot's entries, write the default ──────────────────────────────────────────
esp_mount=$WORK/esp
# Is it mounted? Compare against /proc/mounts' OWN spelling of the path, not the one we used: Puppy's /tmp is a
# symlink to /initrd/mnt/tmpfs/tmp, so `/proc/mounts` says /initrd/mnt/tmpfs/tmp/1bit-update/esp while the guard looked
# for /tmp/1bit-update/esp, missed, and the second `mount` died with "already mounted" - which is how a `--status` call
# could break the update that followed it (measured in the gate).
esp_mounted() { grep -q " $(readlink -f "$esp_mount") " /proc/mounts 2> /dev/null; }
mount_esp() {
    mkdir -p "$esp_mount"
    esp_mounted && return 0
    mount -t vfat "$esp" "$esp_mount" >> "$LOG" 2>&1 || { tail -n 2 "$LOG" >&2; return 1; }
}
unmount_esp() { esp_mounted && umount "$esp_mount" 2> /dev/null; return 0; }
cfg=$esp_mount/EFI/BOOT/grub.cfg
# the on-disk GRUB order is the index order: entry N is the Nth `menuentry` line, and `set default=N` picks it
slot_index() {   # $1 slot, $2 headless|serial -> index, or empty
    # BEGIN n = 0: an uninitialised awk number is the EMPTY STRING, so `i = n; n++` gave the FIRST entry an empty
    # index - `set default=` with nothing after it, and a read-back that could never match index 0 (measured: the
    # status line printed `1bit headless = ` and a rollback to /1bit would have written an empty default)
    awk -v slot="$1" -v kind="$2" '
        BEGIN { n = 0; i = 0 }
        /^[[:space:]]*menuentry/ { i = n; n++ }
        /^[[:space:]]*linux / {
            sp = ($0 ~ ("psubdir=" slot "([[:space:]]|$)"))
            ser = ($0 ~ /1bit\.serial=1/)
            if (sp && ((kind == "serial" && ser) || (kind == "headless" && !ser))) { print i; exit }
        }' "$cfg"
}
set_default() {   # $1 index
    sed -i "s/^set default=.*/set default=$1/" "$cfg" || return 1
    grep -qx "set default=$1" "$cfg"
}

if [ "$mode" = status ]; then
    say "1bit-update: active slot = $active (data partition on $bootdisk, ESP $esp)"
    for d in 1bit "$ALT"; do
        if [ -d "$DATA/$d" ]; then
            n=$(ls "$DATA/$d"/*.sfs 2> /dev/null | wc -l)
            set=$(ls -l "$DATA/$d/vmlinuz" 2> /dev/null | awk '{ print $6, $7, $8 }')
            link=$(readlink "$DATA/$d"/*save* 2> /dev/null | head -1)
            say "  /$d: $n SFS, kernel dated ${set:-<none>}${link:+, save layer -> $link}"
        else
            say "  /$d: absent"
        fi
    done
    [ -n "$savename" ] && say "  save layer: $DATA/$save_slot/$savename (one layer, shared by both slots)"
    if [ -n "$upper" ] && pats=$(owned_pats "$run_owned") && [ -n "$pats" ]; then
        say "  release files the save layer shadows: $(shadow_scan "$upper" "$pats" | grep -c .) (1bit-update --shadowed lists them)"
    fi
    if mount_esp; then
        say "  GRUB: default index $(sed -n 's/^set default=//p' "$cfg" | head -1) of $(grep -c '^[[:space:]]*menuentry' "$cfg") entries" \
            "| $active headless = $(slot_index "$active" headless), $target headless = $(slot_index "$target" headless)"
        unmount_esp
    fi
    exit 0
fi

if [ "$mode" = rollback ]; then
    mount_esp || fail "cannot mount the ESP $esp"
    idx=$(slot_index "$target" headless)
    [ -n "$idx" ] || { unmount_esp; die "slot $target has no GRUB entry to roll back to"; }
    [ -s "$DATA/$target/initrd.gz" ] || { unmount_esp; die "slot $target has no appliance in it: nothing to roll back to"; }
    set_default "$idx" || { unmount_esp; fail "could not set default=$idx in $cfg"; }
    unmount_esp
    say "rolled back: GRUB now boots /$target (entry $idx). Reboot to use it; the save layer is untouched."
    exit 0
fi

# ── install mode ─────────────────────────────────────────────────────────────────────────────────────────────
[ -d "$src" ] || [ -f "$src" ] || die "no such release: $src"
[ -n "$savename" ] || die "the running set has no save layer (/1bit or /$ALT with a real <prefix>save folder): this image predates engine#712's persistence, so there is no state to carry across - reinstall with 1bit-install"
# the second slot is created on first use: the installer lays out one set and the update adds the other, so a disk
# installed before this script existed can still be updated
if [ ! -d "$DATA/$target" ]; then
    mkdir -p "$DATA/$target" || fail "cannot create /$target on the data partition"
    say "   created /$target (the second slot)"
fi

# the shape of the running set is what an update must deliver: same names, so the init finds them
need='vmlinuz initrd.gz'
for f in "$DATA/$active"/*.sfs; do
    [ -e "$f" ] && need="$need $(basename "$f")"
done

srcimg=
cleanup() {
    [ -n "${run_owned_tmp:-}" ] && rm -f "$run_owned_tmp"
    [ -n "$srcimg" ] && { umount "$srcimg" 2> /dev/null; [ -n "${srcloop:-}" ] && losetup -d "$srcloop" 2> /dev/null; }
    unmount_esp
    work_done
}
trap 'cleanup' EXIT INT TERM

# a release image is what a user actually has: use the frugal set on its own data partition
if [ ! -d "$src" ]; then
    # ONE loop device, taken at the partition's offset, and `sfdisk` reads the FILE directly: the first version attached
    # the whole image, detached it, and immediately attached it again at an offset - and the second attach raced the
    # detach, so the mount that followed failed ("cannot mount the data partition in ...", measured in the gate).
    # `sfdisk -d` needs no loop at all.
    #
    # It also prints `start=` and the sector number as TWO fields, so the first version's "strip the prefix from $i and
    # print it" produced an empty offset and every image was refused as "not a 1bit OS image" while the partition was
    # right there. Read the number, wherever it is.
    dataoff=$(sfdisk -d "$src" 2> /dev/null | awk '/name="1BIT-DATA"/ {
        for (i = 1; i <= NF; i++) if ($i ~ /^start=/) {
            v = $i; sub(/start=/, "", v); gsub(/,/, "", v)
            if (v == "") { v = $(i + 1); gsub(/,/, "", v) }
            print v + 0; exit } }')
    [ -n "$dataoff" ] || die "$src has no 1BIT-DATA partition (not a 1bit OS image)"
    srcloop=$(losetup -f --show -r -o $((dataoff * 512)) "$src" 2> /dev/null) \
        || die "cannot loop-mount $src's data partition (offset ${dataoff} sectors)"
    srcimg=$WORK/src
    mkdir -p "$srcimg"
    mount -t ext4 -o ro "$srcloop" "$srcimg" >> "$LOG" 2>&1 || {
        logtail; die "cannot mount the data partition in $src"; }
    src=$srcimg/1bit
    [ -d "$src" ] || die "$src has no /1bit on its data partition (the data partition mounted, /1bit is not on it)"
fi

for f in $need; do
    [ -s "$src/$f" ] || die "$src does not carry $f, which the running image is built from ($need)"
done
if [ -s "$src/SHA256SUMS" ]; then
    sums=$WORK/sums
    : > "$sums"
    for f in $need; do
        # strip a leading "./": `sha256sum ./*.sfs` writes "./name", and a membership test on the bare name then
        # matched only the two files that were listed without the prefix (measured: "2 file(s) of the set verified"
        # for a set of six - the SFS were copied but not hash-checked)
        awk -v b="$f" '{ n = $2; sub(/^\.\//, "", n); if (n == b) print }' "$src/SHA256SUMS" >> "$sums"
    done
    if [ -s "$sums" ]; then
        ( cd "$src" && sha256sum -c --quiet "$sums" ) >> "$LOG" 2>&1 \
            || die "SHA256SUMS does not verify for the set's own files - the release is damaged"
        say "hashes: $(grep -c . "$sums") file(s) of the set verified against $src/SHA256SUMS"
    else
        [ -n "$novfy" ] || die "$src/SHA256SUMS has no line for any file of this set: nothing proves the bytes are the release's own (this path replaces the appliance the machine boots; use --no-verify only if you trust the copy)"
    fi
else
    [ -n "$novfy" ] || die "$src carries no SHA256SUMS: nothing proves the bytes are the release's own. Every 1bit OS image writes one beside the set (engine#1385: mkimage does), so this is a hand-made release directory - pass --no-verify only if you trust the copy"
fi

# --latest: the image must be the release that was asked for, newer than this one (rollback protection)
if [ -n "${expect_tag:-}" ]; then
    isfs=$(ls "$src"/puppy_*.sfs 2> /dev/null | head -1)
    itag=
    [ -n "$isfs" ] && itag=$(unsquashfs -q -cat "$isfs" etc/1bit/release-identity 2> /dev/null | sed -n 's/^payload=lemonade-onebit-//p' | head -1)
    why=$(update_identity_check "$itag" "$expect_tag" "$expect_run" "$expect_ch") || die "$why"
    say "identity: the verified image is $itag, as asked for, newer than the running $expect_run ($expect_ch channel)"
fi

# space: the new set, with room for the checksums and the GRUB rewrite
szk=$(du -sk "$src" | cut -f 1)
freek=$(df -Pk "$DATA" | awk 'NR == 2 { print $4 }')
[ "$freek" -gt $((szk + 262144)) ] || die "only ${freek} KiB free on $DATA, the set needs ${szk} KiB plus 256 MiB of slack"
# and the ESP, where the two GRUB entries go: it is the one place a half-write is not recoverable without a rescue
# stick, so it is checked up front rather than after the copy has already run (the #1385 review: a full ESP used to be
# refused after ~1.5 GB had been written into the other slot)
mount_esp || fail "cannot mount the ESP $esp"
espfree=$(df -Pk "$esp_mount" | awk 'NR == 2 { print $4 }')
[ "${espfree:-0}" -gt 1024 ] || { unmount_esp; die "only ${espfree:-0} KiB free on the ESP $esp: refusing to write there"; }
unmount_esp

# a slot that already owns a save layer is another machine's state, not something to overwrite - unless it is the
# slot holding THIS machine's shared layer, which is every second update (engine#1334 review)
why=$(prepare_target_layer "$DATA" "$target") || die "$why"
# the operator-facing half of the same decision: when the target is the slot holding the layer, say so (the function
# itself stays silent on success, so its stdout remains "the reason" for the tests that call it)
[ "$target" = "$save_slot" ] && say "   /$target holds this machine's save layer ($savename): left in place, no link needed"

# ── write the other slot ─────────────────────────────────────────────────────────────────────────────────────
say "== install $src into /$target (the running set is /$active and is not touched)"
for f in $need; do
    cp -f "$src/$f" "$DATA/$target/$f" >> "$LOG" 2>&1 || fail "copying $f into /$target failed"
done
[ -s "$src/SHA256SUMS" ] && cp -f "$src/SHA256SUMS" "$DATA/$target/SHA256SUMS" 2> /dev/null
link_target_layer "$DATA" "$target" || fail "cannot link the save layer into /$target"
for f in $need; do
    cmp -s "$src/$f" "$DATA/$target/$f" || fail "/$target/$f does not match the source after copying"
done
sync
if [ "$target" = "$save_slot" ]; then layer_note="held here (both slots share it)"; else layer_note="-> $(readlink "$DATA/$target/$savename")"; fi
say "   $(ls "$DATA/$target"/*.sfs | wc -l) SFS, kernel and initrd in /$target; save layer $layer_note"

# ── GRUB: the other slot's entries carry the NEW release's boot parameters, and they become the default ───────
mount_esp || fail "cannot mount the ESP $esp"
[ -f "$cfg" ] || { unmount_esp; fail "no EFI/BOOT/grub.cfg on $esp"; }
# (the ESP's free space is checked before the copy, next to the data partition's own check)
cp -p "$cfg" "$cfg.pre-1bit-update" 2> /dev/null || { unmount_esp; fail "cannot back up $cfg"; }
# the running slot's headless line: this machine's two keys come from it (the data partition's UUID pin and the slot)
# and never from the release, whose own line names the release image's disk (engine#3374)
tmpl=$(awk -v slot="$active" '$1 == "linux" && $0 ~ ("psubdir=" slot "([[:space:]]|$)") && $0 !~ /1bit\.serial=1/ {
                                  sub(/^[[:space:]]*linux[[:space:]]+[^[:space:]]+[[:space:]]+/, ""); print; exit }' "$cfg")
[ -n "$tmpl" ] || { unmount_esp; fail "no headless linux line for the running slot ($active) in $cfg to take this machine's boot keys from"; }
# the NEW release's own headless parameters: /1bit/cmdline on the set this run read (an image's mounted data partition,
# or a release directory). A release that carries none gets the running line's parameters, and the update says so.
rel=$(release_headless "$src/cmdline")
params=$(slot_params "$rel" "$tmpl" "$target"); rc=$?
[ "$rc" = 0 ] || { unmount_esp; fail "$params"; }
[ -n "$params" ] || { unmount_esp; fail "no boot parameters to write the /$target entries with"; }
if [ -n "$rel" ]; then
    pfrom="the NEW release's own (/1bit/cmdline)"
else
    pfrom="the RUNNING release's (it carries no /1bit/cmdline)"
    say "   WARNING: the release carries no /1bit/cmdline beside its set: /$target keeps the RUNNING release's boot parameters, so a parameter this release changed does not arrive (engine#3374)"
fi
hidx=$(slot_index "$target" headless)
sidx=$(slot_index "$target" serial)
# The target slot's TWO entries are written from the new release's line: the headless one that becomes the default, and
# the serial root shell. An entry that is already there keeps its own kernel path and only its parameters are replaced,
# so a slot written by an earlier update (or by 1bit-install, whose menu also carries the desktop and install-to-disk
# entries) does not accumulate entries; a missing one is appended. Those other menu entries are the image's own boot
# modes, not this script's, and keep the line their image was installed with.
newcfg=$WORK/grub.cfg.new
awk -v h="${hidx:-none}" -v s="${sidx:-none}" -v hp="$params" -v sp="$params 1bit.serial=1" -v tgt="$target" '
    BEGIN { n = 0; i = 0 }
    /^[[:space:]]*menuentry/ { i = n; n++ }
    /^[[:space:]]*linux / && (i "" == h || i "" == s) {
        p = $0
        sub(/^[[:space:]]*linux[[:space:]]+/, "", p)
        k = p; sub(/[[:space:]].*/, "", k)          # the kernel path the entry already boots: kept, not rebuilt
        print "    linux " k " " (i "" == s ? sp : hp)
        next
    }
    { print }
    END {
        if (h == "none") {
            print "menuentry \"1bit OS (headless console, " tgt ")\" {"
            print "    linux /" tgt "/vmlinuz " hp
            print "    initrd /" tgt "/initrd.gz"
            print "}"
        }
        if (s == "none") {
            print "menuentry \"1bit OS (" tgt " - serial root shell, 1bit.serial=1)\" {"
            print "    linux /" tgt "/vmlinuz " sp
            print "    initrd /" tgt "/initrd.gz"
            print "}"
        }
    }' "$cfg" > "$newcfg" || { unmount_esp; fail "cannot build the /$target entries for $cfg"; }
[ -s "$newcfg" ] || { unmount_esp; fail "the rewritten GRUB config is empty: $cfg is untouched"; }
cp "$newcfg" "$cfg" || { cp -p "$cfg.pre-1bit-update" "$cfg" 2> /dev/null; unmount_esp; fail "cannot write the /$target entries to $cfg"; }
sync
if [ "$hidx" = "" ]; then
    say "   GRUB: added the /$target entries (boot parameters from $pfrom)"
else
    say "   GRUB: /$target's entries now carry the new release's boot parameters (from $pfrom)"
    [ "$sidx" = "" ] && say "   GRUB: added the /$target serial entry"
fi
idx=$(slot_index "$target" headless)
[ -n "$idx" ] || { unmount_esp; fail "the /$target headless entry is not in $cfg after writing it"; }
set_default "$idx" || { unmount_esp; fail "could not set default=$idx in $cfg"; }
# read it back the way GRUB counts: the Nth menuentry must be the one carrying /$target's boot line, and it must carry
# the parameters this run wrote - the boot after the update is the whole point of them (engine#3374)
got=$(awk -v want="$idx" -v slot="$target" '
    BEGIN { n = 0; i = 0 }
    /^[[:space:]]*menuentry/ { i = n; n++ }
    /^[[:space:]]*linux / && i == want && $0 ~ ("psubdir=" slot "([[:space:]]|$)") && $0 !~ /1bit\.serial=1/ {
        sub(/^[[:space:]]*linux[[:space:]]+[^[:space:]]+[[:space:]]*/, ""); print; exit }
' "$cfg")
[ -n "$got" ] || { cp -p "$cfg.pre-1bit-update" "$cfg"; unmount_esp; fail "entry $idx is not /$target's headless boot line; $cfg restored"; }
[ "$got" = "$params" ] || { cp -p "$cfg.pre-1bit-update" "$cfg"; unmount_esp; fail "entry $idx does not carry the /$target boot parameters this run wrote (got: $got); $cfg restored"; }

# ── the save layer's copies of release files: out of the overlay, so the new release's code runs (engine#3342) ──
# Done last, once the slot is written and GRUB boots it, so a refused or failed update leaves the layer as it was. The
# list of what the release owns is the NEW release's own; an older image without one falls back to the running list.
# This edits the overlay's upper dir while it is mounted: the kernel calls that undefined (never a crash or a
# deadlock); the moved files are renamed, not deleted, so open ones stay readable, and the next boot - the reboot
# into the new slot - mounts the layer afresh. Machine state is not on the list and is never touched.
nsfs=$(ls "$DATA/$target"/puppy_*.sfs 2> /dev/null | head -1)
pf=$(mktemp)
if [ -n "$nsfs" ] && unsquashfs -q -cat "$nsfs" etc/1bit/release-owned > "$pf" 2> /dev/null && [ -s "$pf" ]; then
    owned_from="the new release's etc/1bit/release-owned"
else
    cp "$run_owned" "$pf" 2> /dev/null; owned_from="the RUNNING release's list (the new one carries none)"
fi
pats=$(owned_pats "$pf"); rm -f "$pf"
if [ -z "$upper" ] || [ ! -d "$upper" ]; then
    say "   save layer: no upper dir, nothing shadows the new release"
elif [ -z "$pats" ]; then
    say "   WARNING: no release-owned list in either release: save-layer copies of release files were NOT checked (engine#3342)"
else
    shadow_report "$nsfs" "$pats" | tee -a "$LOG"
    n=$(shadow_scan "$upper" "$pats" | grep -c .)
    if [ "$n" = 0 ]; then
        say "   save layer: no copy of a release file (checked against $owned_from)"
    else
        ntag=$(unsquashfs -q -cat "$nsfs" etc/1bit/release-identity 2> /dev/null | sed -n 's/^payload=lemonade-onebit-//p' | head -1)
        dest=$DATA/$save_slot/$savename/1bit-shadowed/${ntag:-new}-$(date -u +%Y%m%dT%H%M%SZ)
        say "   save layer: $n copy(ies) of release files would keep the OLD code over the new release; moving them to $dest"
        mv_out=$(mktemp)
        shadow_move "$upper" "$pats" "$dest" > "$mv_out" 2>&1; mv_rc=$?
        tee -a "$LOG" < "$mv_out"; rm -f "$mv_out"
        if [ "$mv_rc" != 0 ]; then
            say "   WARNING: not every copy moved (above): the new release runs the old bytes of those paths until they are moved by hand"
        fi
        say "   (a hand edit among them is kept there: compare it with the new file and re-apply it if it is still wanted)"
    fi
fi

say ""
say "UPDATED: /$target now holds the new appliance set. Reboot to run it."
say "  roll back at any time:  1bit-update --rollback   (or pick the /$active entry in the GRUB menu)"
say "  what is on this disk:   1bit-update --status"
exit 0
