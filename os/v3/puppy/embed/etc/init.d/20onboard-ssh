# /etc/init.d/20onboard-ssh - the owner's ssh key, and sshd up, at boot (TPUPPY-RELEASE U7).
#
# Puppy ships /etc/init.d/ssh and rc.services runs it, but nothing ever generated host keys: on a built
# resolute64 image /etc/ssh has moduli, ssh_config and sshd_config and no ssh_host_* at all, and sshd
# refuses to start without them. Permissions are the other half: /opt/1bit-package and the image files
# come out of git with 644/755, and sshd's StrictModes rejects an authorized_keys that is not 600 in a
# 700 directory.
#
# This runs before Puppy's own ssh script (rc.services runs /etc/init.d/* in name order) and owns sshd,
# so that script is told to stand down through the marker it already honours. An image with no key
# provisions no listener, which is the right default for a release that has not been keyed yet.
KEYS=/root/.ssh/authorized_keys

[ -s "$KEYS" ] || { echo "20onboard-ssh: no $KEYS, sshd not started"; exit 0; }
mkdir -p /run/sshd
chmod 700 /root/.ssh
chmod 600 "$KEYS"
[ -f /etc/ssh/ssh_host_ed25519_key ] || ssh-keygen -A >/dev/null 2>&1
touch /etc/ssh/sshd_not_to_be_run
/usr/sbin/sshd && echo "20onboard-ssh: sshd up, $(wc -l < "$KEYS") key(s) authorised"
