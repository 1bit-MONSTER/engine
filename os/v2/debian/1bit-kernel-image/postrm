# Removing the kernel takes its initramfs with it; the running kernel is never the one being removed
# (apt keeps the previous version installed), so nothing here touches /boot/vmlinuz besides its own.
set -e
kver=@KVER@
if [ -x /usr/sbin/update-initramfs ]; then
    update-initramfs -d -k "$kver" || true
fi
exit 0
