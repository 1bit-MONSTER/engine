# 31onboard-update-notice - OS updater U6: the daily "a newer 1bit OS is published" check (1bit-update-notice), notice
# only. rc.services waits for each init.d script, so the loop is detached; notice=off in /data/1bit/update.conf stops it
# writing anything.
N=/usr/local/bin/1bit-update-notice
[ -x "$N" ] || exit 0
case "${1:-start}" in
    start) ( "$N" > /dev/null 2>&1 & ); echo "31onboard-update-notice: daily update check started (notice only)" ;;
    stop) : ;;
esac
